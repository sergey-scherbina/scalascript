#!/usr/bin/env bash
#
# smoke-ci — the fast repo-wide suite. Runs LOCALLY before a push and on GitHub after one, from the
# same runner (`scripts/smoke-ci.ssc`) over the same checks, so the two cannot drift apart.
#
# WHY THIS EXISTS. The push path was 13.4 min wall clock / ~64 runner-minutes against a `main` push
# interval of ~3-7 min. GitHub keeps one pending run per concurrency group, so of the last 100
# `ci.yml` runs: 83 cancelled, 4 failure, 0 success. A suite that cannot finish inside the push
# interval does not give a verdict on most commits — and `cancelled` reads as RED, so it was also
# manufacturing reds for commits that were fine. The full suite still exists; it moved to
# `scripts/full-ci` and the nightly, off the push path.
#
# The runner is written in `.ssc` and executes on the v2 native lane, so the compiler under test is
# what runs the suite. That is what surfaced the missing `exec` native (2026-07-30): every lane but
# the DEFAULT one could shell out.
#
# Usage:
#   scripts/smoke-ci              run the suite (exit 1 on any failure or budget overrun)
#   scripts/smoke-ci --list       print the suite without running it
#   SSC_SMOKE_BUDGET=750 …        raise the total budget — read the note in smoke-ci.ssc first

set -euo pipefail

ROOT="$(git -C "$(dirname "${BASH_SOURCE[0]}")" rev-parse --show-toplevel)"
cd "$ROOT"

LAUNCHER="$ROOT/bin/ssc"
STAMP="$ROOT/bin/lib/.build-stamp"
DIGEST="$ROOT/bin/lib/.build-digest"

# The runner needs a launcher, and a STALE launcher is worse than none: it would run the suite with
# the previous commit's compiler and report a verdict about code that is not in the tree. `bin/ssc`
# warns about this on stderr; here it is a hard precondition, because a CI verdict is exactly the
# thing that must not be about the wrong bytes.
if [[ ! -x "$LAUNCHER" ]]; then
  echo "smoke-ci: no launcher at bin/ssc — build one first:" >&2
  echo "  ./install.sh --dev" >&2
  exit 1
fi

# …but `bin/ssc` is TRACKED IN GIT, so it exists and is executable in every fresh worktree, while
# `bin/lib/` is a build product and is not. The check above therefore passes on a checkout that has
# never been built, and so does the staleness check below — both of its branches are conditional on
# `.build-digest` or `.build-stamp` being READABLE, and in an unbuilt tree neither file exists, so
# both are skipped. The suite then ran and died with
#
#   Error: Could not find or load main class scalascript.cli.StandardMain
#
# after zero checks, exiting 1 — which is indistinguishable from a real suite failure. The guard was
# careful about a STALE tower and blind to an ABSENT one, which is the strictly worse case: a stale
# tower gives a verdict about the wrong code, an absent one gives a verdict about no code at all
# while looking identical to a red.
#
# Measured 2026-08-31: two agents hit this independently within minutes of each other, each burning
# several cycles, one of them while trying to determine whether the suite STALLS — where an instant
# exit 1 is the opposite failure mode and cost an extra round to tell apart. The second occurrence is
# data about the tool, not about the agent.
#
# The check is on the artifact the launcher actually loads (`bin/ssc:106` puts
# `bin/lib/standard/ssc.jar` on the classpath and asks for `scalascript.cli.StandardMain`), not on
# `bin/lib/` merely existing — a half-built tree with the directory and no jar fails the same way.
STANDARD_JAR="$ROOT/bin/lib/standard/ssc.jar"
if [[ ! -r "$STANDARD_JAR" ]]; then
  echo "smoke-ci: bin/ssc is present (it is tracked in git) but this checkout was never built —" >&2
  echo "  no $STANDARD_JAR" >&2
  echo "The suite would start, fail to load scalascript.cli.StandardMain, and exit 1 after running" >&2
  echo "ZERO checks, which reads exactly like a red. Build first:" >&2
  echo "  ./install.sh --dev" >&2
  echo "(Note: install.sh --dev exits 0 even when the compile fails, so check bin/lib is populated.)" >&2
  exit 1
fi

# The check is on the launcher's INPUTS, not on which commit is checked out.
#
# It was `.build-stamp` (the HEAD sha) and that was wrong in the expensive direction: a commit
# touching only `SPRINT.md` produces a byte-identical toolchain, and the guard called it stale — so
# every docs commit forced a ~3.5 min rebuild in CI and told an agent to rebuild before measuring.
# `.build-digest` (scripts/launcher-input-digest) hashes everything that can reach the staged bytes,
# so it says "different" exactly when the toolchain really is.
#
# The sha stamp remains the FALLBACK, for a launcher staged before the digest existed or built
# somewhere git was unavailable. Falling back to a stricter check is safe; the reverse would not be.
if [[ "${SSC_SMOKE_ALLOW_STALE:-}" != "1" ]]; then
  if [[ -r "$DIGEST" ]]; then
    built_digest="$(<"$DIGEST")"
    want_digest="$("$ROOT/scripts/launcher-input-digest" 2>/dev/null || true)"
    if [[ -n "$built_digest" && -n "$want_digest" && "$built_digest" != "$want_digest" ]]; then
      echo "smoke-ci: the launcher was built from different sources than this tree." >&2
      echo "  staged inputs: ${built_digest:0:12}" >&2
      echo "  this tree:     ${want_digest:0:12}" >&2
      echo "A verdict from a stale toolchain is a verdict about the wrong code. Rebuild:" >&2
      echo "  ./install.sh --dev" >&2
      echo "(Override for a deliberate A/B: SSC_SMOKE_ALLOW_STALE=1)" >&2
      echo "(What changed: scripts/launcher-input-digest --explain)" >&2
      exit 1
    fi
  elif [[ -r "$STAMP" ]]; then
    built="$(<"$STAMP")"
    head="$(git -C "$ROOT" rev-parse HEAD 2>/dev/null || true)"
    if [[ -n "$built" && -n "$head" && "$built" != "$head" ]]; then
      echo "smoke-ci: the launcher was built from ${built:0:9} but HEAD is ${head:0:9}," >&2
      echo "and it carries no bin/lib/.build-digest, so the SHA is all there is to compare." >&2
      echo "A verdict from a stale toolchain is a verdict about the wrong code. Rebuild:" >&2
      echo "  ./install.sh --dev" >&2
      echo "(Override for a deliberate A/B: SSC_SMOKE_ALLOW_STALE=1)" >&2
      exit 1
    fi
  fi
fi

# `--` is load-bearing: without it the launcher claims `--list` as its own option and dies with
# "unknown standard run option" before the script starts.
exec "$LAUNCHER" run "$ROOT/scripts/smoke-ci.ssc" -- "$@"
