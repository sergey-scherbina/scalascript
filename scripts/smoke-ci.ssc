  Check("scripts", "build-slot-selftest", "scripts/build-slot", List("--self-test"), 60000),
  Check("scripts", "coord-release-evidence-level", "tests/coord/coord-release-evidence-level.sh", List(), 120000),
  Check("scripts", "coord-claim-runs", "tests/coord/coord-claim-runs.sh", List(), 120000),
