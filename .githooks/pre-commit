#!/usr/bin/env bash
#
# Worktree guardrail (specs/worktree-guardrail.md).
#
# Refuses a feature commit made in the shared `main` checkout or on the `main`
# branch — that work belongs in a worktree on a feature/<name> branch (AGENTS.md §1).
# Coordination commits that touch ONLY `.work/` (claims/releases/pause) stay allowed.
# Commits in a feature worktree are never affected. Escape hatch: `git commit --no-verify`.
set -euo pipefail

# Resolve git-dir and the common git-dir as absolute paths so the comparison is correct
# from any subdirectory. A linked worktree has git-dir = …/.git/worktrees/NAME, which
# differs from the common dir …/.git; the main checkout has them equal.
git_dir=$(git rev-parse --absolute-git-dir)
common_dir=$(git rev-parse --git-common-dir)
case "$common_dir" in
  /*) : ;;                                  # already absolute
  *)  common_dir="$(pwd)/$common_dir" ;;
esac
git_dir=$(cd "$git_dir" && pwd -P)
common_dir=$(cd "$common_dir" && pwd -P)

in_main_checkout=0
[ "$git_dir" = "$common_dir" ] && in_main_checkout=1

branch=$(git symbolic-ref --quiet --short HEAD || echo "(detached)")
on_main_branch=0
[ "$branch" = "main" ] && on_main_branch=1

if [ "$in_main_checkout" -eq 1 ] || [ "$on_main_branch" -eq 1 ]; then
  # Anything staged outside the coordination set is feature work and must not land here.
  #
  # `SPRINT.md` joined `.work/` on 2026-07-30, and it is not a loosening. The board is coordination
  # state with the same lifetime as a claim — SPRINT.md's own contract says the row is written "in
  # ONE commit" with it, and `tests/coord/board-claim-parity.sh` enforces the pair. But
  # `scripts/coord-claim` must run in the shared main checkout, so this guard made the contract
  # literally unsatisfiable by the sanctioned tool: the row-writing code was implemented, hit this
  # refusal, and was BACKED OUT again (`0c8237e60`) with the note that the fix belongs here.
  #
  # Narrow on purpose: only the root board. CHANGELOG.md, BUGS.md and the module boards stay
  # refused here, because those are written while doing the work — i.e. from a worktree — and this
  # guard is the thing that keeps feature work out of the shared checkout. The claim-scope guard
  # further down treats bookkeeping differently and correctly; the two are separate questions.
  offending=$(git diff --cached --name-only | grep -v '^\.work/' | grep -vx 'SPRINT.md' || true)
  if [ -n "$offending" ]; then
    where="the shared main checkout"
    [ "$in_main_checkout" -eq 1 ] || where="branch 'main'"
    cat >&2 <<EOF

✋ pre-commit: refusing a non-coordination commit in ${where}.

Feature work must happen in a worktree on a feature/<name> branch (AGENTS.md §1).
Quick fix:
  scripts/new-worktree <name>          # creates an external worktree off origin/main
  # or, by hand:
  MAIN=\$(git worktree list | head -1 | awk '{print \$1}')
  git -C "\$MAIN" worktree add "\$(dirname "\$MAIN")/\$(basename "\$MAIN")-wt-<name>" -b feature/<name> origin/main

Staged paths outside .work/ (coordination-only commits ARE allowed here):
$(printf '  %s\n' $offending)

Override (rarely correct): git commit --no-verify
EOF
    exit 1
  fi
fi

# ─────────────────────────────────────────────────────────────────────────────
# Claim scope guard (specs/claim-mutex.md, layer 3).
#
# In a feature/<slug> worktree, staged paths must fall inside the `paths:` its claim declares on
# origin/main. This is the gate for the 2026-07-27 case where an agent holding one claim did the
# work of another agent's claim and nothing objected.
#
# Two deliberate softenings, without which the guard would be disabled by whoever it first annoys:
#   - a shared set every task legitimately touches is always allowed;
#   - no claim, or a claim that declares no `paths:`, is allowed with a note (backward compatible).
# ─────────────────────────────────────────────────────────────────────────────
case "$branch" in
  feature/*)
    slug=${branch#feature/}
    claim_paths=$(git show "origin/main:.work/active/${slug}.claim" 2>/dev/null |
                    sed -n 's/^paths:[[:space:]]*//p' | head -1 || true)
    if [ -n "$claim_paths" ]; then
      staged=$(git diff --cached --name-only)
      outside=""
      for f in $staged; do
        # Match the BASENAME, not the whole path. Third time this exact drift has bitten: layer 2
        # (pre-push) was fixed on 2026-07-30 (301202efc) after the per-module split turned every
        # `v2/SPRINT.md`, `scripts/BACKLOG.md`, `tests/conformance/BUGS.md` into an ordinary
        # claimable path — and this layer kept comparing bare basenames against the full path, so
        # `v2/BUGS.md` was still exclusive HERE while shared THERE. Found by an agent who could
        # claim narrowly, pass the overlap guard, and then not commit a one-line `kind:` tag.
        #
        # The comment below already says why: duplicated logic needs the same vocabulary on both
        # sides, or it is not one guard but two. Both sides now key on the basename.
        case "${f##*/}" in
          # Shared bookkeeping / coordination — every task touches these by design.
          SPRINT.md|BACKLOG.md|CHANGELOG.md|BUGS.md|MILESTONES.md|AGENTS.md|README.md) continue ;;
        esac
        case "$f" in
          .work/*|specs/*) continue ;;
        esac
        ok=0
        for p in $claim_paths; do
          # Strip the scope LEVEL prefix before comparing (specs/claim-mutex.md §Hierarchy).
          #
          # Layer 2 (pre-push) learned `repo:` / `mod:` / `file:` on 2026-07-30; this layer did not, so
          # it compared the literal `file:scripts/foo` against the staged path `scripts/foo` and
          # refused. The new scope level could therefore be CLAIMED and could pass the overlap guard,
          # but nothing could be COMMITTED under it — the finest granularity was the one that did not
          # work, which is the opposite of the intent. Found by the first claim to use `file:`.
          #
          # Same shape as the note further up about shared bookkeeping: that exemption lived in this
          # layer and not in layer 2, and four finished items sat un-ticked because of it. Duplicated
          # logic needs the same vocabulary on both sides, or it is not one guard but two.
          # `dir:` added 2026-08-30 for the same reason `file:` was added on 2026-07-30, and found
          # the same way — by the first claim to use it. A `dir:` scope could be claimed and could
          # pass the overlap guard, but nothing under it could be committed, because this line
          # compared the literal `dir:v3/tests/front` against the staged `v3/tests/front/x`.
          p="${p#repo:}"; p="${p#mod:}"; p="${p#dir:}"; p="${p#file:}"
          # Declared paths are PREFIXES; tolerate a trailing glob people write out of habit
          # (`scljet/**` and `scljet/` must mean the same thing, or the guard fires on its own author).
          while [ "${p%\*}" != "$p" ]; do p="${p%\*}"; done
          case "$f" in "$p"*) ok=1; break ;; esac
        done
        [ "$ok" -eq 1 ] || outside="$outside $f"
      done
      if [ -n "$outside" ]; then
        cat >&2 <<EOF

✋ pre-commit: these staged paths are outside what claim '${slug}' declared.

Declared paths: ${claim_paths}
Outside them:
$(printf '  %s\n' $outside)

Working outside your own claim is how one agent silently redid another's task on 2026-07-27
(specs/claim-mutex.md). Pick one:
  - widen the claim:  edit .work/active/${slug}.claim 'paths:' in the MAIN checkout, push it, then
                      re-run this commit — that also lets the pre-push guard spot a real overlap;
  - or claim the other work separately and do it in its own worktree.

Override (rarely correct): git commit --no-verify
EOF
        exit 1
      fi
    fi
    ;;
esac

# ─────────────────────────────────────────────────────────────────────────────
# `area:` must be in the enum — checked HERE, at the author's commit, not by the
# shared gate after the push.
#
# THREE TIMES on 2026-08-04/05 an entry landed with a value that is not in
# `specs/bugs-index.md` — `gate`, `corpus`, and one before them. Each turned
# `bugs-index-gate` red on main for EVERY agent until its author noticed, and each
# was a single word. The gate is not at fault: it caught all three. It just runs
# after the damage, and the suite it lives in takes minutes, so people push first.
#
# Only STAGED BUGS.md files, only the `area:` lines, so the cost is a grep.
staged_bugs="$(git diff --cached --name-only --diff-filter=ACM | grep -E '(^|/)BUGS\.md$' || true)"
if [ -n "$staged_bugs" ]; then
  # The enum lives in specs/bugs-index.md; read it from there rather than repeating
  # it, so the two cannot drift — a hard-coded copy here would become the fourth
  # place this list is written down.
  enum_line="$(grep -m1 '^| `area`' specs/bugs-index.md 2>/dev/null || true)"
  allowed="$(printf '%s' "$enum_line" | grep -oE '`[a-z-]+`' | tr -d '`' | grep -v '^area$' || true)"
  if [ -n "$allowed" ]; then
    bad=0
    for f in $staged_bugs; do
      while IFS= read -r val; do
        printf '%s
' "$allowed" | grep -qx "$val" || {
          [ "$bad" -eq 0 ] && echo "✋ pre-commit: an \`area:\` value is not in the enum." >&2
          bad=1
          echo "   $f: area: $val" >&2
        }
      done < <(git show ":$f" 2>/dev/null | grep -oE '^ *area: *[a-z-]+' | awk '{print $2}')
    done
    if [ "$bad" -ne 0 ]; then
      echo "" >&2
      echo "   Allowed (specs/bugs-index.md): $(printf '%s' "$allowed" | tr '\n' ' ')" >&2
      echo "   This is the check that stops the SHARED bugs-index gate going red on main for" >&2
      echo "   everyone — it has happened three times, each for one word." >&2
      echo "   Override (rarely correct): git commit --no-verify" >&2
      exit 1
    fi
  fi
fi

# ─────────────────────────────────────────────────────────────────────────────
# `kind:` must be PRESENT on an entry this commit ADDS — same reasoning as the `area:` check above,
# one field over, and the same three-in-a-row to justify it.
#
# `kind:` became required on 2026-08-16. Within hours, three entries landed without one —
# `v3-a-toplevel-def-used-as-a-value-is-an-unknown-name`, `math-round-and-f-round-disagree-at-a-tie`,
# `js-mathround-is-not-in-isIntExpr` — and each turned `bugs-index-gate` red on main for EVERY agent,
# because that gate runs inside `smoke-ci` and `smoke-ci` is the push path. Each cost one word. None
# of the authors did anything unusual: they filed an entry the way entries have always been filed.
#
# SCOPED TO ADDED HEADINGS, AND THAT IS THE WHOLE DESIGN. 779 of 1052 entries carried no kind when
# the field was introduced, and `classify-the-50-kindless` is still working through them. A check
# that demanded `kind:` from every entry in a staged board would refuse nearly every commit that
# touches one — worse than the problem it solves. So: only `## slug` lines the diff ADDS.
#
# `git diff --cached -U0` gives added lines only; an added heading is then looked up in the STAGED
# file to read the header block that follows it.
staged_bugs="$(git diff --cached --name-only --diff-filter=ACM | grep -E '(^|/)BUGS\.md$' || true)"
if [ -n "$staged_bugs" ]; then
  kindless=""
  for f in $staged_bugs; do
    # Headings this commit adds, without the leading '+'.
    added_heads="$(git diff --cached -U0 -- "$f" | grep -E '^\+## ' | sed 's/^\+//' || true)"
    [ -z "$added_heads" ] && continue
    staged_content="$(git show ":$f" 2>/dev/null || true)"
    while IFS= read -r head; do
      [ -z "$head" ] && continue
      # The entry's header block: from its heading to the first `-->`. If that window carries no
      # `kind:`, the entry is the shape that reddens main.
      #
      # NOTE THE ASSIGNMENT: this was `printf … | awk … | grep -q` and it reported THIS FILE'S OWN
      # entry as kindless while printing `printf: Broken pipe`. Under `set -o pipefail` a `grep -q`
      # that matches EARLY closes the pipe, `printf` dies of SIGPIPE, and the pipeline's status makes
      # a HIT read as a MISS. Capture first, match second — never `… | grep -q` where the status is
      # the answer.
      hdr="$(awk -v h="$head" 'index($0,h)==1{f=1} f{print} f&&/-->/{exit}' <<<"$staged_content")"
      if ! grep -qE '^ *kind: *[a-z]' <<<"$hdr"; then
        kindless="$kindless
   $f: ${head}"
      fi
    done <<EOF
$added_heads
EOF
  done
  if [ -n "$kindless" ]; then
    kind_enum="$(grep -m1 '^| `kind`' specs/bugs-index.md 2>/dev/null | grep -oE '`[a-z-]+`' | tr -d '`' | grep -v '^kind$' | tr '\n' ' ' || true)"
    {
      echo "✋ pre-commit: an entry this commit ADDS declares no \`kind:\`."
      echo "$kindless"
      echo ""
      echo "   Allowed (specs/bugs-index.md): ${kind_enum:-bug perf feature regression apparatus programme}"
      echo "   \`kind:\` is required since 2026-08-16 and \`bugs-index-gate\` runs inside smoke-ci, so"
      echo "   an entry without one turns EVERY agent's push red until its author notices. That"
      echo "   happened three times on the day the field became required, each costing one word."
      echo "   Only entries this commit ADDS are checked — older kindless entries are somebody"
      echo "   else's task (classify-the-50-kindless) and never fail this."
      echo "   Override (rarely correct): git commit --no-verify"
    } >&2
    exit 1
  fi
fi

exit 0
