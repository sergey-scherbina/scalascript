#!/usr/bin/env bash
#
# build-ram-guard — shed build load BEFORE the host swaps itself to death. Runs from launchd.
#
# ─────────────────────────────────────────────────────────────────────────────
# WHY THIS REPLACES ~/.local/bin/jvm-mem-guard.sh
# ─────────────────────────────────────────────────────────────────────────────
# That guard was written after the 2026-07-20 kernel panic (~19 build JVMs, ~79 GB resident on a
# 36 GB host; watchdogd could not check in; the machine force-rebooted). It has been loaded and
# running every 20 s ever since, and it has **never taken a single action**:
#
#     $ ls -la ~/Library/Logs/jvm-mem-guard.log
#     -rw-r--r--  1 sergiy  staff  0 Jul 21 06:17        # 0 bytes, a week later
#
# through a SECOND event on 2026-07-28 (139,831 pageouts, 526 MB swap). Three defects, all measured:
#
#   1. WRONG SIGNAL. It exits early on `kern.memorystatus_level >= 25`. Measured, that sysctl reads
#      93 % on an idle host, 74 % mid-event, and 62 % while the host held 630 MB of swap and an
#      11.3 GB compressor. It is a JETSAM indicator — it collapses only once the machine is already
#      in the death zone. The guard's cheap fast path read "healthy" the whole way down.
#   2. WRONG TARGETS. Its regex matched sbt/bloop/scala-cli/ForkMain. The processes behind the
#      07-28 event were the conformance runner's `java … -jar bin/ssc.jar` forks and its `node`
#      forks. Neither matches, so even at critical it would have shed the wrong things.
#   3. SILENT EITHER WAY. A guard that logs nothing when healthy is indistinguishable from a guard
#      that is not running. That ambiguity is precisely why nobody noticed for a week.
#
# ─────────────────────────────────────────────────────────────────────────────
# THE SIGNAL (measured 2026-07-28, and reproducible with scripts/build-ram-report)
# ─────────────────────────────────────────────────────────────────────────────
#   available   free+inactive+speculative+purgeable. 17 GB healthy. Reclaimable-on-demand pages
#               count; using only `Pages free` reads as an emergency on a perfectly fine machine.
#   pageout rate  `Pageouts` is CUMULATIVE. Delta measured 0 per 5 s on a healthy host, and the
#               07-28 event moved it by 139,831. The RATE is what says "thrashing right now";
#               absolute swap-in-use is useless as a trigger because macOS does not drain swap, so
#               a one-off spike would leave the guard hair-triggered for the rest of the uptime.
#
# `memorystatus_level` is still REPORTED on every line and never TRIGGERS anything. Keeping it
# visible next to the signals that work is what stops this being rediscovered a third time.
#
# ─────────────────────────────────────────────────────────────────────────────
# THE LADDER — what gets killed, in what order
# ─────────────────────────────────────────────────────────────────────────────
# The old guard had exactly one action: kill the single heaviest build JVM. That is simultaneously
# too blunt (the heaviest JVM is often an agent's active compile) and too narrow. Escalate instead,
# cheapest-to-lose first, and stop as soon as the host recovers:
#
#   T1 ORPHANED   worktree deleted -> nobody can be using it. Always safe, no work lost.
#   T2 IDLE       live worktree, but no CPU burned across the sample window. Loses a warm server;
#                 the next `sbt` just pays the ~9-15 s build load again.
#   T3 HEAVIEST   genuine emergency only (low available AND active pageouts). This one CAN kill
#                 running work — that is the trade against a kernel panic, and it is logged.
#
# Usage:
#   scripts/build-ram-guard              # one tick (this is what launchd runs)
#   scripts/build-ram-guard --dry-run    # decide and log, kill nothing
#   scripts/build-ram-guard --explain    # print the current reading and the tier, then exit
#   scripts/build-ram-guard --self-test  # synthetic-pressure gate, kills nothing
#
# Env: SSC_GUARD_{REAP_FLOOR_MB,SHED_FLOOR_MB,RECOVER_MB,THRASH_PAGES,MAX_KILLS,LOG,STATE,IDLE_SAMPLE}
set -uo pipefail

REAP_FLOOR_MB="${SSC_GUARD_REAP_FLOOR_MB:-8192}"   # below this (or any thrashing) -> start reclaiming
SHED_FLOOR_MB="${SSC_GUARD_SHED_FLOOR_MB:-3072}"   # below this AND thrashing -> may kill live work
RECOVER_MB="${SSC_GUARD_RECOVER_MB:-6144}"         # stop shedding once back above this
THRASH_PAGES="${SSC_GUARD_THRASH_PAGES:-200}"      # pageouts/tick that count as "thrashing now"
MAX_KILLS="${SSC_GUARD_MAX_KILLS:-6}"
IDLE_SAMPLE="${SSC_GUARD_IDLE_SAMPLE:-3}"
LOG="${SSC_GUARD_LOG:-$HOME/Library/Logs/build-ram-guard.log}"
STATE="${SSC_GUARD_STATE:-${TMPDIR:-/tmp}/ssc-build-ram-guard.state}"
HEARTBEAT_EVERY="${SSC_GUARD_HEARTBEAT_EVERY:-90}" # log a healthy line at most this often (ticks)

DRY=0; EXPLAIN=0; SELFTEST=0
while [ $# -gt 0 ]; do
  case "$1" in
    --dry-run)   DRY=1; shift ;;
    --explain)   EXPLAIN=1; shift ;;
    --self-test) SELFTEST=1; shift ;;
    -h|--help)   sed -n '2,60p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
    *) echo "build-ram-guard: unknown flag '$1'" >&2; exit 2 ;;
  esac
done

mkdir -p "$(dirname "$LOG")" 2>/dev/null
log() { printf '[%s] %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" >>"$LOG"; }

# ── readings ─────────────────────────────────────────────────────────────────
available_mb() {
  if [ "$(uname -s)" = "Darwin" ]; then
    vm_stat 2>/dev/null | awk '
      /page size of/       { for(i=1;i<=NF;i++) if($i=="of") ps=$(i+1) }
      /^Pages free/        { gsub(/\./,"",$3); f=$3 }
      /^Pages inactive/    { gsub(/\./,"",$3); i=$3 }
      /^Pages speculative/ { gsub(/\./,"",$3); s=$3 }
      /^Pages purgeable/   { gsub(/\./,"",$3); p=$3 }
      END { printf "%d", (f+i+s+p) * ps / 1048576 }'
  else
    awk '/^MemAvailable:/{printf "%d", $2/1024}' /proc/meminfo
  fi
}
pageouts_total() {
  if [ "$(uname -s)" = "Darwin" ]; then
    vm_stat 2>/dev/null | sed -n 's/^Pageouts: *\([0-9]*\)\./\1/p'
  else
    awk '/^pswpout/{print $2}' /proc/vmstat
  fi
}
level_pct() { sysctl -n kern.memorystatus_level 2>/dev/null || echo "?"; }

# Pageouts is cumulative, so the RATE needs the previous tick. Missing/again-zero state simply means
# "no rate yet", which is treated as not-thrashing — fail toward doing nothing, never toward killing.
read_state() { PREV_PAGEOUTS=0; TICK=0; [ -r "$STATE" ] && read -r PREV_PAGEOUTS TICK < "$STATE" 2>/dev/null; :; }
write_state() { printf '%s %s\n' "$1" "$2" > "$STATE" 2>/dev/null; :; }

# ── the killable set ─────────────────────────────────────────────────────────
# Wider than the old guard's, because the old one could not see what actually caused the 07-28
# event. Still narrow enough that it can only ever hit build tooling: never the OS, GUI apps,
# rozum, Claude, or a bare `java` a human launched.
BUILD_RE='sbt-launch|xsbt\.boot|sbt\.script|sbt/standalone|bloop|scala-cli|scalacli|scala\.cli|ForkMain|zinc|metals|BspServer|ssc\.lib\.path|ssc\.jar|ssc-tools|org\.openjdk\.jmh'

build_pids() {
  ps ax -o pid=,command= 2>/dev/null |
    grep -E "$BUILD_RE" | grep -v -e grep -e build-ram-guard -e jvm-mem-guard | awk '{print $1}'
}
cwd_of() { lsof -a -p "$1" -d cwd -Fn 2>/dev/null | sed -n 's/^n//p' | head -1; }
rss_mb()  { echo $(( $(ps -o rss= -p "$1" 2>/dev/null | tr -d ' ' || echo 0) / 1024 )); }
cpu_secs() {
  ps -o time= -p "$1" 2>/dev/null | tr -d ' ' | awk '
    { t=$0; d=0; if (t ~ /-/) { split(t,a,"-"); d=a[1]; t=a[2] }
      n=split(t,p,":"); s=0; for (i=1;i<=n;i++) s = s*60 + int(p[i]); printf "%d", d*86400+s }'
}

kill_pid() { # kill_pid <pid> <tier> <why>
  if [ "$DRY" = 1 ] || [ "$SELFTEST" = 1 ]; then
    log "DRY $2 would-kill pid=$1 ($3)"
    return 0
  fi
  if kill "$1" 2>/dev/null; then log "$2 KILL pid=$1 ($3)"; return 0; fi
  return 1
}

# ── tiers ────────────────────────────────────────────────────────────────────
tier1_orphans() { # -> count killed
  local n=0 pid cwd
  for pid in $(build_pids); do
    cwd="$(cwd_of "$pid")"
    [ -n "$cwd" ] && [ ! -d "$cwd" ] || continue
    kill_pid "$pid" T1-orphan "rss=$(rss_mb "$pid")MB cwd-gone=$cwd" && n=$((n+1))
  done
  echo "$n"
}

tier2_idle() { # -> count killed. Only sbt/bloop servers: a fork mid-run is not "idle", it is slow.
  local n=0 pid cwd before after
  local cands=""
  for pid in $(ps ax -o pid=,command= 2>/dev/null |
      grep -E 'sbt-launch|xsbt\.boot|sbt/standalone|bloop' | grep -v grep | awk '{print $1}'); do
    cands="$cands $pid|$(cpu_secs "$pid")"
  done
  [ -n "$cands" ] || { echo 0; return; }
  sleep "$IDLE_SAMPLE"
  for entry in $cands; do
    pid="${entry%%|*}"; before="${entry##*|}"
    after="$(cpu_secs "$pid")"
    [ -n "$after" ] || continue
    [ "$after" -gt "$before" ] && continue          # burned CPU: it is working
    cwd="$(cwd_of "$pid")"
    kill_pid "$pid" T2-idle "rss=$(rss_mb "$pid")MB no-cpu-in-${IDLE_SAMPLE}s cwd=${cwd:-?}" && n=$((n+1))
  done
  echo "$n"
}

tier3_heaviest() { # -> count killed
  local n=0 line pid rss
  while [ "$n" -lt "$MAX_KILLS" ]; do
    [ "$(available_mb)" -ge "$RECOVER_MB" ] && break
    line="$(ps -axo pid=,rss=,command= 2>/dev/null | grep -E "$BUILD_RE" |
            grep -v -e grep -e build-ram-guard | sort -k2,2 -rn | head -1)"
    [ -n "$line" ] || { log "T3 no build JVMs left to shed; available=$(available_mb)MB"; break; }
    pid="$(awk '{print $1}' <<<"$line")"
    rss="$(( $(awk '{print $2}' <<<"$line") / 1024 ))"
    kill_pid "$pid" T3-heaviest "rss=${rss}MB available=$(available_mb)MB" || break
    n=$((n+1))
    { [ "$DRY" = 1 ] || [ "$SELFTEST" = 1 ]; } && break     # one pass when not really killing
    sleep 1
  done
  echo "$n"
}

# ── decide ───────────────────────────────────────────────────────────────────
read_state
avail="$(available_mb)"
po_now="$(pageouts_total)"; po_now="${po_now:-0}"
rate=0
[ "$PREV_PAGEOUTS" -gt 0 ] && [ "$po_now" -ge "$PREV_PAGEOUTS" ] && rate=$(( po_now - PREV_PAGEOUTS ))
TICK=$(( TICK + 1 ))
write_state "$po_now" "$TICK"

thrashing=0; [ "$rate" -ge "$THRASH_PAGES" ] && thrashing=1
tier=0
if [ "$avail" -lt "$SHED_FLOOR_MB" ] && [ "$thrashing" -eq 1 ]; then tier=3
elif [ "$avail" -lt "$REAP_FLOOR_MB" ] || [ "$thrashing" -eq 1 ]; then tier=1
fi

reading="available=${avail}MB pageouts_rate=${rate}/tick thrashing=${thrashing} level=$(level_pct)% tier=T${tier}"

if [ "$EXPLAIN" = 1 ]; then
  printf '%s\n' "$reading"
  printf 'floors: reap<%sMB shed<%sMB recover>=%sMB thrash>=%s pages/tick\n' \
    "$REAP_FLOOR_MB" "$SHED_FLOOR_MB" "$RECOVER_MB" "$THRASH_PAGES"
  printf 'note: kern.memorystatus_level is REPORTED, never TRIGGERS — measured 62-93%% straight through two OOM events.\n'
  exit 0
fi

if [ "$SELFTEST" = 1 ]; then
  fail=0
  ok() { printf '✓ %s\n' "$*"; }
  bad() { printf '✗ %s\n' "$*"; fail=1; }
  echo "── build-ram-guard self-test (kills nothing)"
  # Tier selection is pure arithmetic over (available, thrashing) — check every corner, both ways,
  # because a guard that always fires and a guard that never fires look identical from one sample.
  t() { # t <avail> <thrashing> <expected-tier>
    local a="$1" th="$2" want="$3" got=0
    if [ "$a" -lt "$SHED_FLOOR_MB" ] && [ "$th" -eq 1 ]; then got=3
    elif [ "$a" -lt "$REAP_FLOOR_MB" ] || [ "$th" -eq 1 ]; then got=1; fi
    [ "$got" = "$want" ] && ok "avail=${a}MB thrash=${th} -> T${got}" \
      || bad "avail=${a}MB thrash=${th}: expected=T${want} got=T${got}"
  }
  t 20000 0 0     # healthy
  t 20000 1 1     # plenty of RAM but actively paging -> still reclaim
  t  5000 0 1     # low, not paging -> reclaim only
  t  1000 0 1     # very low but NOT paging -> must NOT reach T3 (this is the false-alarm guard)
  t  1000 1 3     # low AND paging -> emergency
  # The old guard's trigger must not be able to come back. Scoped to the DECISION BLOCK rather than
  # the whole file — a whole-file grep matches this very check and reports a defect that is not
  # there, which is its own small lesson about apparatus that pre-judges.
  grep -q 'memorystatus_level' "$0" && ok "memorystatus_level is mentioned (it is reported)"
  decide_block="$(sed -n '/^# ── decide/,/^reading=/p' "$0")"
  if [ -z "$decide_block" ]; then
    bad "could not locate the decision block — this check would pass vacuously, which is worse than failing"
  elif printf '%s' "$decide_block" | grep -q 'memorystatus'; then
    bad "the decision block consults memorystatus_level — that IS the defect this script exists to fix"
  else
    ok "the decision block never consults memorystatus_level (only available + pageout rate)"
  fi
  # Targets must cover what the 2026-07-28 event actually ran.
  for pat in 'ssc\.jar' 'ssc\.lib\.path' 'ForkMain' 'bloop' 'scala-cli'; do
    case "$BUILD_RE" in *"$pat"*) ok "killable set covers $pat" ;;
      *) bad "killable set does NOT cover $pat" ;; esac
  done
  before="$(build_pids | wc -l | tr -d ' ')"
  DRY=1 tier1_orphans >/dev/null; DRY=1 tier3_heaviest >/dev/null
  after="$(build_pids | wc -l | tr -d ' ')"
  [ "$after" -ge "$before" ] && ok "self-test killed nothing (build procs before=$before after=$after)" \
    || bad "self-test KILLED something: before=$before after=$after"
  echo
  [ "$fail" -eq 0 ] && { echo "✓ build-ram-guard self-test PASSED"; exit 0; }
  echo "✗ build-ram-guard self-test FAILED"; exit 1
fi

# ── act ──────────────────────────────────────────────────────────────────────
if [ "$tier" -eq 0 ]; then
  # A healthy tick still leaves a trace, just a rare one. "The log is empty" must mean "the guard is
  # not running" and NEVER "everything was fine" — that ambiguity is the whole reason the previous
  # guard's silence went unread for a week across two OOM events.
  # (TICK-1) % N, not TICK % N: the latter is never 1 when N is 1, so setting HEARTBEAT_EVERY=1 to
  # get a line every tick produced NO lines at all — caught by the gate, and exactly the kind of
  # off-by-one that would have left this "silent but healthy" all over again.
  [ $(( (TICK - 1) % HEARTBEAT_EVERY )) -eq 0 ] && log "ok $reading (tick=$TICK)"
  exit 0
fi

log "ACT $reading"
k1="$(tier1_orphans)"
avail="$(available_mb)"
if [ "$avail" -ge "$REAP_FLOOR_MB" ]; then
  log "recovered after T1: killed=$k1 available=${avail}MB"
  exit 0
fi

k2="$(tier2_idle)"
avail="$(available_mb)"
if [ "$tier" -lt 3 ] || [ "$avail" -ge "$RECOVER_MB" ]; then
  log "done T1=$k1 T2=$k2 available=${avail}MB tier=T${tier}"
  exit 0
fi

log "EMERGENCY available=${avail}MB (< ${SHED_FLOOR_MB}) and thrashing — shedding live build work"
k3="$(tier3_heaviest)"
log "done T1=$k1 T2=$k2 T3=$k3 available=$(available_mb)MB"
exit 0
