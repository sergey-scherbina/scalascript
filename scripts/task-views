#!/usr/bin/env python3
"""task-views — the entry list inside a TASK/ document is GENERATED, the analysis around it is not.

Sergiy asked for `TASK/<subtype>.md` so that opening one file shows all the work of one type.
The objection raised in the room is correct and this tool is the answer to it: a second axis in the
filesystem gives an entry two plausible homes, and then "0 duplicate slugs" stops holding and
"in neither file" becomes possible.

So a TASK file is not a home. It is a **document with a generated hole in it**:

    prose, analysis, measurement protocol, refuted ideas   ← hand-written, never touched here
    <!-- task-views:begin <filter> -->
    | slug | module | status | gate |                      ← GENERATED from the module boards
    <!-- task-views:end -->
    more prose                                             ← hand-written

The entry list is derived from the same headers `bugs-report` reads, so it cannot disagree with the
boards. Everything a header cannot express — why a ratio is what it is, which optimisations were
measured and refuted, how to measure at all — stays prose, because that is the part worth having
and no schema will ever hold it.

    scripts/task-views --check     regenerate in memory, diff, exit 1 on drift  (this is the gate)
    scripts/task-views --write     rewrite the generated regions in place

Filters are the flag syntax of `bugs-report`, e.g. `kind=perf status=open` or `module=v2 lane=native`.
An unknown field name is an error, not an empty table: a filter that silently matches nothing is the
exact failure this project keeps re-finding — a view that is green because it cannot see.
"""
import argparse, difflib, pathlib, re, sys

sys.path.insert(0, str(pathlib.Path(__file__).resolve().parent))
from importlib.machinery import SourceFileLoader

_br = SourceFileLoader("bugs_report", str(pathlib.Path(__file__).resolve().parent / "bugs-report")).load_module()

BEGIN = re.compile(r"^<!-- task-views:begin (?P<filter>[^>]*?) -->$", re.M)
END = "<!-- task-views:end -->"

# Every field a filter may name. Listed rather than accepted blindly so that `kidn=perf` is a loud
# error instead of a table with nothing in it.
FILTERABLE = {"kind", "status", "lane", "area", "module", "gate"}


def parse_filter(text):
    terms = {}
    for tok in text.split():
        if "=" not in tok:
            raise SystemExit(f"task-views: filter term {tok!r} is not field=value")
        k, v = tok.split("=", 1)
        if k not in FILTERABLE:
            raise SystemExit(f"task-views: unknown filter field {k!r} — known: {', '.join(sorted(FILTERABLE))}")
        terms[k] = v
    if not terms:
        raise SystemExit("task-views: empty filter — a view that selects everything is not a view")
    return terms


def select(rows, terms):
    out = []
    for r in rows:
        if all(r.get(k, "bug" if k == "kind" else None) == v for k, v in terms.items()):
            out.append(r)
    return sorted(out, key=lambda r: (r.get("module", ""), r["slug"]))


def render(rows, terms):
    """The generated region. Deliberately terse — it is an index INTO the boards, not a copy of
    them: one line each, and the slug is what you grep for. A generated block that reproduced the
    report would be a second home again, which is the thing being avoided."""
    desc = " ".join(f"{k}={v}" for k, v in sorted(terms.items()))
    if not rows:
        return [f"*No entry matches `{desc}`.* Generated by `scripts/task-views`; do not edit.", ""]
    out = [f"*{len(rows)} entr{'y' if len(rows) == 1 else 'ies'} matching `{desc}`, generated by "
           f"`scripts/task-views` — do not edit inside the markers.*", "",
           "| entry | board | status | gate |", "|---|---|---|---|"]
    for r in rows:
        board = f"`{r['module']}/{r.get('source','BUGS.md')}`"
        gate = r.get("gate", "-")
        gate = "—" if gate in (None, "-", "none") else f"`{gate}`"
        out.append(f"| `{r['slug']}` | {board} | {r.get('status', '?')} | {gate} |")
    out.append("")
    return out


def regenerate(path, rows):
    src = path.read_text()
    lines = src.split("\n")
    out, i, n_regions = [], 0, 0
    while i < len(lines):
        m = BEGIN.match(lines[i])
        out.append(lines[i])
        if not m:
            i += 1
            continue
        # Find the matching end, then replace everything between.
        j = i + 1
        while j < len(lines) and lines[j].strip() != END:
            j += 1
        if j >= len(lines):
            raise SystemExit(f"task-views: {path}: begin marker at line {i+1} has no {END}")
        out.extend(render(select(rows, parse_filter(m.group("filter"))), parse_filter(m.group("filter"))))
        out.append(END)
        n_regions += 1
        i = j + 1
    return "\n".join(out), n_regions


def main():
    ap = argparse.ArgumentParser()
    g = ap.add_mutually_exclusive_group(required=True)
    g.add_argument("--check", action="store_true", help="diff only, exit 1 on drift")
    g.add_argument("--write", action="store_true", help="rewrite in place")
    ap.add_argument("--dir", default="TASK")
    a = ap.parse_args()

    root = pathlib.Path(__file__).resolve().parent.parent
    rows = _br.all_rows(root)
    tdir = root / a.dir
    if not tdir.is_dir():
        print(f"task-views: no {a.dir}/ directory — nothing to do")
        return 0

    files = sorted(tdir.glob("*.md"))
    drift, total_regions = [], 0
    for f in files:
        new, n = regenerate(f, rows)
        total_regions += n
        if n == 0:
            continue
        old = f.read_text()
        if new == old:
            continue
        if a.write:
            f.write_text(new)
            print(f"  rewrote {f.relative_to(root)}")
        else:
            drift.append((f, old, new))

    if total_regions == 0:
        # Not an error, but say it out loud. A gate over zero regions is green for the wrong reason,
        # and that is the failure mode this repository has hit more than any other.
        print(f"task-views: {len(files)} file(s) in {a.dir}/, NO generated regions — nothing is checked")
        return 0

    if a.check and drift:
        for f, old, new in drift:
            print(f"✗ {f.relative_to(root)} — generated region is stale")
            print("\n".join(difflib.unified_diff(
                old.split("\n"), new.split("\n"), "in tree", "regenerated", lineterm="", n=1)))
            print()
        print(f"\n{len(drift)} file(s) drifted. Run: scripts/task-views --write")
        return 1

    print(f"✓ task-views: {total_regions} generated region(s) in {len(files)} file(s) up to date"
          if a.check else f"✓ task-views: {total_regions} region(s) written")
    return 0


if __name__ == "__main__":
    sys.exit(main())
