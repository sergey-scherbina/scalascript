#!/usr/bin/env bash
#
# sbt-test-shard — run one slice of `sbt test`, or print the slicing without running anything.
#
# WHY: `Test via sbt` is the longest thing in CI. MEASURED on run 30650857814, 106.5 min of test
# phase, of which `CrossBackendPropertyTest` alone was 39.0 (37 %) before the eager-clue fix took it
# to 21.2. The load inside the top suite is FLAT — 17 cases, every one 94-240 s — so there is nothing
# to make faster; only parallelism pays. Sharding BY PROJECT does not balance either: one project
# block is 88.5 min of 123.9. So the unit has to be the SUITE.
#
# HOW THE SLICE IS CHOSEN, and it is deliberately boring: enumerate every `<project>/<suite>` pair,
# sort it, and take `idx % N == i`. Round-robin rather than contiguous blocks for the same measured
# reason `run.sc` and `bc-parity-sweep` use it — the list is name-sorted and slow suites cluster by
# name, so contiguous blocks give wildly uneven shards.
#
# ⚠️ A SHARD SCHEME THAT DROPS A SUITE FAILS GREEN. Every shard passes, the union covers less than
# the whole, and the job set reports success over a hole. `tests/e2e/sbt-test-shard-gate.sh` pins the
# partition property, and `--list` exists so it can do that without sbt.
set -uo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
shard=""; list_only=0; from_file=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --shard) shard="${2:?--shard needs i/N}"; shift 2 ;;
    --list)  list_only=1; shift ;;
    # Reads an enumeration from a file instead of asking sbt — this is what lets the gate exercise
    # the partition on a synthetic list in milliseconds, and what lets a shard reuse an enumeration
    # somebody already paid for.
    --from)  from_file="${2:?--from needs FILE}"; shift 2 ;;
    -h|--help)
      cat <<'EOF'
usage: scripts/sbt-test-shard --shard i/N [--from FILE]   run this slice
       scripts/sbt-test-shard --list [--shard i/N] [--from FILE]
EOF
      exit 0 ;;
    *) echo "sbt-test-shard: unknown option: $1" >&2; exit 2 ;;
  esac
done

shard_i=0; shard_n=1
if [[ -n "$shard" ]]; then
  if [[ "$shard" =~ ^([0-9]+)/([0-9]+)$ ]]; then
    shard_i="${BASH_REMATCH[1]}"; shard_n="${BASH_REMATCH[2]}"
  else
    echo "sbt-test-shard: --shard expects i/N (e.g. 0/4), got: '$shard'" >&2; exit 2
  fi
  if (( shard_n < 1 || shard_i >= shard_n )); then
    echo "sbt-test-shard: --shard expects 0 <= i < N, got: '$shard'" >&2; exit 2
  fi
fi

# ── enumeration ──────────────────────────────────────────────────────────────
#
# `show Test/definedTestNames` prints, per project:
#     [info] <project> / Test / definedTestNames
#     [info] 	Vector(a.B, c.D)
#
# SLASH SYNTAX, AND THE COLON FORM IS NOT A STYLE CHOICE HERE — it produced NOTHING.
# This read `show test:definedTestNames` until 2026-08-15, which sbt 1.10.7 accepts, warns about
# ("sbt 0.13 shell syntax is deprecated"), COMPILES every test source for, reports `[success]` on,
# and prints no value at all. A silent no-op that costs four minutes. Measured on this build,
# warm server, same command in both forms:
#
#     show test:definedTestNames    0 headers, 0 Vector lines, 259 s, [success]
#     show Test/definedTestNames  273 headers, 274 Vector lines, 109 s, [success]
#
# So the enumeration was empty for a reason that had nothing to do with the parser or with the
# build being broken, which is why the refusal below could not name it: both of the causes it
# offered were wrong. The parser and this file's format expectations were correct throughout —
# `show Test/sources` proves the same shape independently.
# It needs the test sources COMPILED, which is why a shard job reuses the compile it already did
# rather than paying twice.
# STDERR IS KEPT, and that is the whole point of this function's shape.
#
# It used to end `2>/dev/null`, so when the enumeration came back empty the refusal below could only
# offer a disjunction — "sbt output unparsed or the test sources did not compile" — with the evidence
# for deciding between them already discarded. Measured 2026-08-15: all FOUR shards of the dispatch
# tier failed on that message, and it is not answerable from the log, because the log is what was
# thrown away. A refusal that cannot say why is a refusal somebody has to reproduce by hand.
# AND STDOUT IS KEPT TOO, for the reason the paragraph above stops one step short of. Keeping stderr
# answered "did the build fail?" and left "what did it print instead?" unanswerable — which is the
# half that actually happened. Measured on the dispatch run of 2026-08-25: all four shards refused
# with `sbt wrote nothing to stderr`, and the log contains ZERO occurrences of `definedTestNames`,
# because the enumeration goes into a pipe and the pipe is not the log. The message told the reader
# to "compare a real line against the awk header pattern" while holding the only copy of the real
# lines and dropping it.
ENUM_ERR="${TMPDIR:-/tmp}/sbt-test-shard-enum.err"
ENUM_OUT="${TMPDIR:-/tmp}/sbt-test-shard-enum.out"
enumerate() {
  if [[ -n "$from_file" ]]; then cat "$from_file"; return; fi
  # THE THIN CLIENT, THEN A COLD BATCH. `sbtc` is `sbt --client`, which exists to reuse a resident
  # server — and on a CI runner there is no resident server to reuse, so the client buys nothing
  # there and adds a way to come back empty. The batch retry costs ~8 s wall on a warm dev box where
  # it never runs, and it is the difference between a shard that reports and a shard that refuses.
  : > "$ENUM_OUT"
  "$ROOT/scripts/sbtc" "show Test/definedTestNames" 2>"$ENUM_ERR" | tee -a "$ENUM_OUT"
  if ! grep -qE '^\[info\] .* / Test / definedTestNames$' "$ENUM_OUT"; then
    echo "sbt-test-shard: the thin client produced no enumeration headers — retrying with a cold \`sbt -batch\`" >&2
    # APPEND: the refusal below prints this file, and a reader needs BOTH attempts — which one came
    # back empty is the question they are answering.
    ( cd "$ROOT" && sbt -no-colors -batch "show Test/definedTestNames" ) 2>>"$ENUM_ERR" | tee -a "$ENUM_OUT"
  fi
}

pairs="$(enumerate | awk '
  /^\[info\] [A-Za-z0-9_]+ \/ Test \/ definedTestNames$/ { proj = $2; next }
  proj != "" && /Vector\(/ {
    line = $0
    sub(/^.*Vector\(/, "", line); sub(/\).*$/, "", line)
    n = split(line, a, ", ")
    for (i = 1; i <= n; i++) if (a[i] != "") printf "%s/%s\n", proj, a[i]
    proj = ""
  }
' | LC_ALL=C sort -u)"

total="$(printf '%s\n' "$pairs" | grep -c . || true)"
# REFUSE AN EMPTY ENUMERATION rather than run zero tests and exit 0. A `testOnly` with no arguments
# runs everything; a shard that selected nothing would otherwise look like a fast green.
if [[ "$total" -lt 10 ]]; then
  echo "sbt-test-shard: enumeration produced $total suite(s) — refusing. sbt output unparsed or" >&2
  echo "  the test sources did not compile; running a slice of nothing would report green." >&2
  # SAY WHICH. The two causes above need different fixes, and the reader has no other copy of this.
  if [[ -n "$from_file" ]]; then
    echo "  (read from --from $from_file, so sbt was never run — the file is the thing to look at.)" >&2
  elif [[ -s "$ENUM_ERR" ]]; then
    echo "  ── last 20 lines of sbt stderr ──────────────────────────────────────────────" >&2
    tail -20 "$ENUM_ERR" | sed 's/^/  | /' >&2
  else
    echo "  (sbt wrote nothing to stderr — so it ran and produced output this parser did not match," >&2
    echo "   not a build that failed. The real lines are below; compare one against the awk header" >&2
    echo "   pattern in this file. Saying 'compare a real line' while discarding every real line is" >&2
    echo "   what made the 2026-08-25 dispatch run unanswerable from its own log.)" >&2
  fi
  if [[ -z "$from_file" && -s "$ENUM_OUT" ]]; then
    echo "  ── first 20 lines of what sbt actually printed ($(grep -c . "$ENUM_OUT") lines total) ──" >&2
    head -20 "$ENUM_OUT" | sed 's/^/  | /' >&2
  fi
  exit 2
fi

mine="$(printf '%s\n' "$pairs" | awk -v i="$shard_i" -v n="$shard_n" 'NR % n == i')"
mine_count="$(printf '%s\n' "$mine" | grep -c . || true)"

if (( list_only )); then printf '%s\n' "$mine"; exit 0; fi

if [[ "$mine_count" -eq 0 ]]; then
  echo "sbt-test-shard: shard $shard_i/$shard_n selected 0 of $total suites — refusing" >&2
  exit 1
fi
printf 'sbt-test-shard: shard %s/%s — %s of %s suites\n' "$shard_i" "$shard_n" "$mine_count" "$total"

# One `testOnly` per project, with that project's suites. Built as a single sbt invocation so the
# JVM and the zinc analysis are paid once.
cmds="$(printf '%s\n' "$mine" | awk -F/ '{ p=$1; sub(/^[^/]*\//,""); s[p] = s[p] " " $0 }
  END { for (p in s) printf "%s/testOnly%s; ", p, s[p] }')"
exec "$ROOT/scripts/sbtc" "$cmds"
