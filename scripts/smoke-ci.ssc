  Check("scripts", "coord-claim-broad", "tests/coord/coord-claim-broad.sh", List(), 60000),
  Check("scripts", "coord-release-note-file", "tests/e2e/coord-release-note-file-gate.sh", List(), 60000),
  // ── the six tests/coord gates that were INVOKED BY NOTHING ────────────────────────────────────
