// An interpolator is an ordinary CALL, so a program defines its own with no kernel change.
// `pfx"a${x}b"` is `pfx(List("a", "b"), List(x))` — parts always one longer than args, as in Scala.
def tag(parts: List[String], args: List[Any]): String =
  parts.mkString("<") + "/" + args.mkString(",")

def twice(parts: List[String], args: List[Any]): String =
  parts.mkString("") + parts.mkString("")

val x = 7
val name = "ada"

println(tag"a${x}b")
println(tag"${x}${name}")
println(twice"ab")
// TRIPLE-QUOTED too, and with a hole: the two spellings share one hole parser.
println(tag"""x${x}y""")
// `s` is still the built-in one and is unchanged by any of this.
println(s"still ${x} and ${name}")
