#!/usr/bin/env bash
#
# cut-release <version> [--dry-run] — the ONE way to release. Makes the tag a fully
# self-consistent snapshot (compiler version AND registry entries both already match it, in the
# SAME commit the tag points at) and leaves `main` correctly resuming development afterward.
#
# WHAT ONE RUN DOES, in order:
#   1. Bump `ThisBuild / version` in build.sbt to <version>.
#   2. Run `scripts/generate-registry-plugin-entries v<version>` — registry/packages.yaml's five
#      plugin entries now advertise the SAME version this exact commit builds.
#   3. Commit both together, push to main, tag, push the tag.
#   4. Bump `ThisBuild / version` again, to the next patch's `-SNAPSHOT`, and push that as a
#      separate, clearly-labeled commit — `main` never sits at a released version number with
#      nothing after it.
#
# WHY STEP 2 HAPPENS **BEFORE** THE TAG, NOT AFTER. The first version of this script tagged with
# build.sbt bumped but left `registry/packages.yaml` for `native-release.yml`'s `release` job to
# commit to `main` AFTER the tag existed — which worked (nothing reads the registry file from the
# tag; `ssc search`/`add`/`plugin install` read the GitHub Pages-served copy, rebuilt from
# whatever `registry/packages.yaml` reads on `main` — `.github/workflows/pages.yml`'s
# `paths: registry/packages.yaml` trigger), but left the tag itself an inconsistent snapshot for
# no reason: nothing about the registry bump needs the build to have happened first — the entries
# it writes are just `<id>-plugin.sscpkg` + the tag string, both known upfront. Asked directly why
# not do it before tagging instead: no good reason. Doing it here means one fewer moving part in
# CI (`native-release.yml`'s `release` job no longer pushes to `main` at all), no push-race window
# between "the release job's checkout of main" and "someone else moving main", and a `git show
# <tag>:registry/packages.yaml` that actually reflects what that tag shipped.
#
# WHY STEP 4 EXISTS. Preparing v0.2.1, `ThisBuild / version` still read a PRIOR release's
# `-SNAPSHOT` — nobody had bumped it forward after that release, so it silently described nothing
# real for however long main sat that way (BUGS.md `native-release-version-not-bumped-before-tag`).
# Bumping forward immediately after tagging is what step 1's guarantee needs on the OTHER side: a
# tag can only stay meaningful if the version *after* it starts moving again right away.
#
# `.github/workflows/native-release.yml`'s `qualifier-contract` job independently verifies
# `ThisBuild / version` equals the tag being released — a safety net for a tag created by hand
# instead of via this script, not the primary guarantee. It runs first (everything else `needs:`
# it), so a mismatch fails in seconds instead of after hours of native-image builds.
#
# WHAT THIS DOES NOT DO: it does not run this repo's board-claim machinery (a release is not
# BUGS.md-tracked "feature work" — nothing here touches project source), so it makes its own
# throwaway worktree rather than going through `scripts/new-worktree`. The pre-commit hook that
# refuses a non-coordination commit in the SHARED checkout would otherwise refuse the `build.sbt`
# bump there.
set -euo pipefail

usage() {
  echo "usage: scripts/cut-release <version> [--dry-run]   e.g. scripts/cut-release 0.2.1" >&2
}

version=""
dry_run=0
for arg in "$@"; do
  case "$arg" in
    --dry-run) dry_run=1 ;;
    --*) echo "cut-release: unknown flag '$arg'" >&2; usage; exit 2 ;;
    *)
      if [[ -n "$version" ]]; then
        echo "cut-release: unexpected extra argument '$arg'" >&2; usage; exit 2
      fi
      version="$arg"
      ;;
  esac
done

if [[ -z "$version" ]]; then
  usage
  exit 2
fi
if ! [[ "$version" =~ ^([0-9]+)\.([0-9]+)\.([0-9]+)$ ]]; then
  echo "cut-release: '$version' is not X.Y.Z" >&2
  exit 2
fi
major="${BASH_REMATCH[1]}"
minor="${BASH_REMATCH[2]}"
patch="${BASH_REMATCH[3]}"
next_snapshot="${major}.${minor}.$((patch + 1))-SNAPSHOT"
tag="v$version"

MAIN=$(git worktree list | head -1 | awk '{print $1}')

git -C "$MAIN" fetch -q origin

if git -C "$MAIN" rev-parse -q --verify "refs/tags/$tag" >/dev/null 2>&1 \
   || git -C "$MAIN" ls-remote --exit-code --tags origin "$tag" >/dev/null 2>&1; then
  echo "cut-release: tag $tag already exists (locally or on origin)" >&2
  exit 1
fi

if [[ "$dry_run" == 1 ]]; then
  echo "would: bump build.sbt + registry/packages.yaml to \"$version\", commit, push to main,"
  echo "       tag $tag, push tag, then bump build.sbt to \"$next_snapshot\" and push that too"
  exit 0
fi

wt="$(dirname "$MAIN")/$(basename "$MAIN")-wt-cut-release-${version}"
if [[ -e "$wt" ]]; then
  echo "cut-release: $wt already exists — a previous cut-release did not clean up? remove it (git worktree remove) first" >&2
  exit 1
fi
git -C "$MAIN" worktree add -q "$wt" origin/main
cleanup() { git -C "$MAIN" worktree remove --force "$wt" >/dev/null 2>&1 || true; }
trap cleanup EXIT

bump_version() {
  local target="$1"
  # BOTH build definitions, not just the root. uniml/build.sbt is a STANDALONE build over the same
  # sources, and its own UnimlCoordinatesSpec fails when the two versions drift — measured
  # 2026-09-01, the first `cd uniml && sbt test` after v0.3.0: the root had moved to
  # 0.3.1-SNAPSHOT and standalone still said 0.2.0-SNAPSHOT, "the same sources would publish as
  # two versions of one artifact". This script was the writer that moved one and not the other.
  local f
  for f in "$wt/build.sbt" "$wt/uniml/build.sbt"; do
    sed -i.bak -E "s/^(ThisBuild \/ version[[:space:]]*:=[[:space:]]*)\"[^\"]+\"/\1\"$target\"/" "$f"
    rm -f "$f.bak"
    if ! grep -qE "^ThisBuild / version[[:space:]]*:=[[:space:]]*\"$target\"" "$f"; then
      echo "cut-release: failed to rewrite $f's version line to \"$target\" — no 'ThisBuild / version := \"...\"' found?" >&2
      exit 1
    fi
  done
}

bump_version "$version"
( cd "$wt" && python3 scripts/generate-registry-plugin-entries "$tag" )

# `git commit` with nothing staged exits nonzero — harmless in general, but WRONG here: if both
# files already read the target version (e.g. an earlier, unpushed run of this same script left
# them there), skipping the commit is correct and the tag should still be created against
# whatever main already has.
if ! git -C "$wt" diff --quiet -- build.sbt registry/packages.yaml; then
  git -C "$wt" add build.sbt uniml/build.sbt registry/packages.yaml
  git -C "$wt" commit -q -m "release: cut $tag"
  git -C "$wt" push -q origin HEAD:main
fi
git -C "$wt" tag "$tag"
git -C "$wt" push -q origin "$tag"

bump_version "$next_snapshot"
git -C "$wt" add build.sbt uniml/build.sbt
git -C "$wt" commit -q -m "release: resume development at $next_snapshot"
git -C "$wt" push -q origin HEAD:main

echo "cut-release: pushed $tag (a fully self-consistent snapshot: build.sbt and"
echo "  registry/packages.yaml both already say \"$version\") and resumed main at $next_snapshot"
echo "  .github/workflows/native-release.yml will run now — watch it at:"
# Plain bash parameter expansion, not a regex sed: `+?` (non-greedy) is a GNU-only ERE extension
# and silently errors on BSD sed (macOS) — caught by testing this against a real, non-GitHub
# remote URL, not by reading the pattern.
origin_url="$(git -C "$wt" remote get-url origin)"
repo_path="${origin_url#*github.com[:/]}"
repo_path="${repo_path%.git}"
echo "  https://github.com/$repo_path/actions"
