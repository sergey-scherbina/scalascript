#!/usr/bin/env bash
#
# launcher-input-digest — a content digest of everything that can affect the staged toolchain
# (`bin/lib`), so a build can be SKIPPED when nothing that feeds it has changed.
#
# WHY NOT THE HEAD SHA. `bin/lib/.build-stamp` records the commit HEAD was at, and both `bin/ssc` and
# `scripts/smoke-ci` compare against it. That is wrong in both directions: a commit touching only
# `SPRINT.md` makes a byte-identical toolchain read as STALE (so CI rebuilds ~3.5 min for nothing,
# and an agent is told to rebuild before measuring), while nothing at all is gained in the other
# direction, because a commit that DOES change the compiler changes the SHA anyway. The question the
# guard actually wants to ask is "was this built from the same inputs as the tree in front of me".
#
# THE LIST IS INVERTED ON PURPOSE, and this is the load-bearing design decision.
#
# The obvious implementation enumerates the paths that DO feed the build — build.sbt, project/, v1/,
# v2/, and whichever of the ~250 sbt projects `cli` transitively depends on. Miss one and the digest
# is stable across a change to a compiler source: CI restores a stale toolchain from cache, runs the
# suite with the PREVIOUS commit's compiler, and reports a green verdict about code it never
# executed. That is the single worst failure this repository has (`feedback: the apparatus lies
# green`), and it would be invisible.
#
# So the list below is what provably CANNOT affect the compiled bytes — documentation, boards,
# claims, the corpus, workflows. Miss an entry here and the digest changes when it did not have to:
# the cost is one unnecessary rebuild. **An error in an exclusion list costs time; an error in an
# inclusion list costs correctness.** Everything not named below is INCLUDED, including directories
# that do not exist yet.
#
# Usage:
#   scripts/launcher-input-digest           print the digest
#   scripts/launcher-input-digest --explain print what went into it, one line per input

set -euo pipefail

ROOT="$(git -C "$(dirname "${BASH_SOURCE[0]}")" rev-parse --show-toplevel)"
cd "$ROOT"

# Top-level entries that cannot reach the compiled toolchain.
#
#   .work        claim files and the ledger
#   .github      workflow definitions — they invoke the build, they are not an input to it
#   .agents      the skills submodule
#   TASK docs site specs        prose
#   bench releases scratch      outputs and scratch space
#   bin          the STAGED OUTPUT itself; including it would make the digest self-referential
#   examples tests               corpus and samples — read at RUN time, never compiled into bin/lib
#
# `tests/` is the one worth justifying: the conformance corpus is data the launcher READS, not code
# it contains, so changing a `.ssc` case cannot change a staged jar. `v1/runtime/std/*.ssc` is the
# same kind of data — but it lives under `v1/`, which stays INCLUDED, because separating the two
# would mean reasoning about which files under a compiled tree are data. That reasoning is exactly
# the inclusion-list mistake this design avoids, and the cost of not making it is a rebuild.
EXCLUDE=(.work .github .agents TASK docs site specs bench releases scratch bin examples tests)

# Per-module BOARD files, at any depth. These live inside INCLUDED trees — `scripts/SPRINT.md`,
# `v1/BUGS.md`, `payments/BACKLOG.md` — and they are the most-edited files in the repository: 37 of
# the last 200 commits touched nothing but boards and `.work/`. Excluding them by NAME rather than
# by extension is deliberate.
#
# `**/*.md` would have been the obvious rule and it would have been WRONG. There are markdown files
# under `v1/tools/cli/src/main/resources/templates/*/README.md` — the scaffolding `ssc new` writes —
# and sbt packages `src/main/resources` into the jar. A blanket extension rule would have excluded a
# real build input: the inclusion-list mistake wearing a different hat. Verified: no file with a
# board name lives under a `resources/` path.
EXCLUDE_BASENAME=(SPRINT.md BACKLOG.md BUGS.md MILESTONES.md SPRINT-ARCHIVE.md)

is_excluded_top() {
  local candidate="$1" excluded
  for excluded in "${EXCLUDE[@]}"; do
    [[ "$candidate" == "$excluded" ]] && return 0
  done
  # Root-level markdown: AGENTS.md, CHANGELOG.md, README.md, POLICY.md.
  [[ "$candidate" != */* && "$candidate" == *.md ]] && return 0
  return 1
}

is_excluded_path() {
  local path="$1" base="${1##*/}" excluded
  is_excluded_top "${path%%/*}" && return 0
  for excluded in "${EXCLUDE_BASENAME[@]}"; do
    [[ "$base" == "$excluded" ]] && return 0
  done
  return 1
}

included=()
while IFS=$'\t' read -r _meta path; do
  is_excluded_top "$path" || included+=("$path")
done < <(git ls-tree HEAD)

if [[ ${#included[@]} -eq 0 ]]; then
  echo "launcher-input-digest: no included top-level paths — refusing to emit a digest over nothing." >&2
  echo "  A digest of an empty input set is stable forever, which would pin a stale toolchain." >&2
  exit 1
fi

inputs() {
  # ONE CANONICAL LINE PER PATH: `<content-sha>\t<path>`, sorted by path.
  #
  # The three sources below say where a path's bytes come from, NOT how the line is spelled. That
  # distinction is the whole fix. Each source used to write its own format —
  #
  #     git ls-tree   ->  "<mode> <type> <sha>\t<path>"
  #     git diff      ->  "dirty <path> <sha>"
  #     ls-files -o   ->  "untracked <path> <sha>"
  #
  # — so a file moved between spellings as its GIT STATE changed, with its content untouched, and
  # the digest changed with it. `git add` shifted it once and `git commit` shifted it again.
  # Measured 2026-08-01: one unchanged file moved the digest TWICE in a single edit-commit cycle.
  #
  # The cost was exactly what this tool exists to prevent. It replaced `.build-stamp` because a HEAD
  # sha forced "a ~3.5 min rebuild for nothing" on a docs-only commit — and then forced a full
  # rebuild after EVERY commit, for the same reason wearing different clothes. The workaround people
  # reached for (commit first, verify second) inverts the order POLICY.md P-1.4 asks for.
  #
  # Precedence is WORKING TREE over HEAD, and it has to be: a path that is both committed and
  # modified must digest as what is on disk, because that is what a build would compile.
  local tmp
  tmp="$(mktemp)"

  # 1. committed content
  git ls-tree -r HEAD -- "${included[@]}" | while IFS=$'\t' read -r meta path; do
    is_excluded_path "$path" && continue
    # `${meta##* }` and NOT `$(printf … | awk …)`: ls-tree meta is `<mode> <type> <sha>`, so the sha
    # is the last space-separated field and bash can take it with no process at all. The substitution
    # spawned TWO processes per line over 7272 lines — ~15k spawns — and that was the whole cost of
    # this script: 11.3 s locally, and the gate built on it reached 225.5 s of the smoke suite's
    # 500 s budget on CI, 27% of the whole run and 3x the next check.
    # BUGS `launcher-digest-gate-is-225s-of-a-500s-budget`.
    printf '%s\t%s\n' "${meta##* }" "$path"
  done >> "$tmp"

  # 2. uncommitted TRACKED changes, staged or not — these OVERRIDE (1). Without them a dirty
  # worktree digests as its HEAD and the guard calls a toolchain current while its source is edited.
  git diff HEAD --name-only -- "${included[@]}" | while IFS= read -r path; do
    is_excluded_path "$path" && continue
    if [[ -f "$path" ]]; then printf '%s\t%s\n' "$(git hash-object "$path")" "$path"
    else printf 'deleted\t%s\n' "$path"; fi
  done >> "$tmp"

  # 3. untracked files under included paths. A brand-new .scala source is invisible to both commands
  # above, and it is exactly the shape of "I added a file and the build did not pick it up".
  git ls-files --others --exclude-standard -- "${included[@]}" | while IFS= read -r path; do
    [[ -n "$path" ]] || continue
    is_excluded_path "$path" && continue
    printf '%s\t%s\n' "$(git hash-object "$path")" "$path"
  done >> "$tmp"

  # Later wins per path, then sort so the ORDER of the three passes cannot change the digest either.
  awk -F'\t' '{ last[$2] = $1 } END { for (p in last) printf "%s\t%s\n", last[p], p }' "$tmp" | LC_ALL=C sort
  rm -f "$tmp"
}

if [[ "${1:-}" == "--explain" ]]; then
  printf 'included top-level paths (%s):\n' "${#included[@]}"
  printf '  %s\n' "${included[@]}"
  printf 'excluded: %s + root *.md\n' "${EXCLUDE[*]}"
  printf 'digest inputs:\n'
  inputs | sed 's/^/  /'
  exit 0
fi

inputs | shasum -a 256 | cut -d' ' -f1
