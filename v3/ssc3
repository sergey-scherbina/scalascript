#!/usr/bin/env bash
# ssc3 — the ScalaScript 3 driver.
#
#   v3/ssc3 run   <file.ssc>    compile and run on v3's OWN runtime
#   v3/ssc3 run --bridge <f>    the same program through the v2 VM — the compatibility lane
#   v3/ssc3 ir    <file.ssc>    print the SSC IR the front produced
#   v3/ssc3 build <file.ssc>    print the v2 Core IR the bridge produced
#   v3/ssc3 <anything else>     passed straight to the kernel (check, fmt, sample, selftest)
#
# It lives in `v3/` rather than `bin/` because `.gitignore` says bin/ is GENERATED and wrapper
# sources belong in scripts/launchers/ — which is shared infrastructure this claim does not hold.
# Staging it as `bin/ssc3` is a one-line install.sh follow-up, not a blocker.
#
# The PIPING lives here and not in the kernel. Spawning a process is a host call, and the kernel's
# only door to the host is `Prim` (v3/specs/00-charter.md I-1) — a compiler that shells out from
# inside its own core has a dependency it cannot state.
#
# `run` today means: .ssc -> AST -> SSC IR -> verify -> v2 Core IR -> the v2 VM. The last hop is
# SSC3-3's bridge, which is why v3 has the whole v2 backend fleet without having written one.
#
# WHY JARS AND NOT `scala-cli run`. Every invocation used to compile both trees through scala-cli
# into their shared `.scala-build`. Any CONCURRENT scala-cli on the same tree — another gate,
# another agent — cleans that directory underneath the running one, and the compile dies with
# `NoSuchFileException` writing a `.tasty`. The program then produces NO OUTPUT, which a gate
# comparing output reads as a wrong answer.
#
# Measured: the same fixture, run ten times by hand, came back empty on runs 2, 3 and 5. It cost a
# round of chasing a v3 defect that did not exist.
#
# So the driver packages each tree ONCE per source digest and runs the jar. The race window shrinks
# from every invocation to the first, a failed package is a non-zero exit rather than silence, and
# the gates get several times faster as a side effect.
set -uo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
JARS="$ROOT/v3/.jars"

# ── THE SCALA TOOLCHAIN, and there is no `scala-cli` in it ───────────────────────────────────────
#
# v3 used to shell into `scala-cli` for every artifact. It does not any more, and the reason it CAN
# not is invariant I-1: `v3/src` and `v2/src` declare zero dependencies, and dependency resolution
# is the only thing `scala-cli` offers over the compiler itself. So the compiler is fetched once,
# PINNED TO THE VERSION THE SOURCES DECLARE, and invoked directly.
#
# The pin is the point. The `scalac` on this host is 3.7.2 while every source file says
# `//> using scala 3.8.3`, so a build through the launcher on `PATH` silently used a different
# compiler than the one declared — measured, and it compiled, which is how that kind of drift
# survives. Reading the version out of the source is what makes the two impossible to disagree.
SCALA_V="$(grep -h '^//> using scala ' "$ROOT/v3/src"/*.scala | head -1 | awk '{print $NF}')"

toolchain() {
  local f="$JARS/toolchain-$SCALA_V.cp"
  if [ -s "$f" ]; then cat "$f"; return 0; fi
  mkdir -p "$JARS"
  if ! command -v cs >/dev/null 2>&1; then
    echo "ssc3: coursier ('cs') is needed to fetch the Scala $SCALA_V compiler — see setup.sh" >&2
    return 1
  fi
  if ! cs fetch "org.scala-lang:scala3-compiler_3:$SCALA_V" \
                "org.scala-lang:scala3-library_3:$SCALA_V" 2>/dev/null \
       | tr '\n' ':' | sed 's/:$//' > "$f"; then
    rm -f "$f"
    echo "ssc3: could not fetch the Scala $SCALA_V toolchain" >&2
    return 1
  fi
  [ -s "$f" ] || { rm -f "$f"; return 1; }
  cat "$f"
}

# The compiled classes for one or more source trees, built if this exact source has not been built.
#
# CONTENT-ADDRESSED, and that is a bug fix rather than a style: the output directory's NAME carries
# the digest, so it is written once and never rewritten. The previous design cached a path that
# `scala-cli` overwrote on the next compile of the same inputs, so returning to an earlier source
# state — an A/B, or a gate self-test that plants a defect and reverts it — served the OTHER state's
# classes. Choosing the output directory ourselves makes that unrepresentable.
#
#   classes_for <name> <extra-classpath|""> <tree> [tree …]
classes_for() {
  local name="$1" extra="$2"; shift 2
  local tc dg out tmp opts srcs=()
  tc="$(toolchain)" || return 1
  local t
  for t in "$@"; do srcs+=("$t"/*.scala); done
  dg="$(cat "${srcs[@]}" <(printf '%s' "$extra$SCALA_V") | shasum | cut -c1-16)"
  out="$JARS/$name-$dg"
  if [ -d "$out" ]; then printf '%s' "$out"; return 0; fi
  # The compiler flags the sources themselves declare — `-deprecation`, `-Wunused:imports` — read
  # rather than duplicated here, for the same reason the version is.
  opts="$(grep -h '^//> using options ' "$1"/*.scala | head -1 | cut -d' ' -f4-)"
  tmp="$out.$$.tmp"
  rm -rf "$tmp"; mkdir -p "$tmp"
  if ! java -cp "$tc" dotty.tools.dotc.Main \
         -classpath "$tc${extra:+:$extra}" $opts -d "$tmp" "${srcs[@]}" >&2; then
    rm -rf "$tmp"
    echo "ssc3: failed to compile $*" >&2
    return 1
  fi
  # A rename onto a name that does not exist; if a concurrent build won the race, keep theirs.
  if [ -d "$out" ]; then rm -rf "$tmp"; else mv "$tmp" "$out" 2>/dev/null || rm -rf "$tmp"; fi
  [ -d "$out" ] || return 1
  printf '%s' "$out"
}


TC="$(toolchain)" || exit 2
# The kernel is `v3/src` PLUS `alphabet/src` — the lexical alphabet, one copy shared with UniML.
# A source directory, not a dependency: the kernel still builds with nothing but a Scala compiler
# and files from this repository, which is what invariant I-1 asks and what self-hosting needs.
V3CP="$(classes_for ssc3 "" "$ROOT/v3/src" "$ROOT/alphabet/src")" || exit 2
SSC3=(java -cp "$V3CP:$TC" ssc3.ssc3)
V2=(java -Xss512m -cp "$(classes_for ssc2 "" "$ROOT/v2/src"):$TC" ssc.cli)

# ── THE PLUGIN FLEET, IF IT IS BUILT ─────────────────────────────────────────────────────────────
#
# `v2/runtime/std/*-plugin/` already implements seventeen of the nineteen host names the corpus
# refuses; what was missing was a way to reach them. Availability is an explicit cached fact — the
# `.cp` file exists or it does not — for the same reason the second front's is: a caller not using
# the fleet must not wait for sbt, and a failed plugin build must not fail `ssc3 run`.
# Refresh it with `v3/plugin-classpath.sh`.
#
# BOTH LANES OR NEITHER. The executor answers through `ssc3.plugins.V2Fleet`, which installs the
# fleet into `ssc3.Plugins` before lowering; the bridge answers because its own `ssc.cli` process
# gets the SAME jars and `NativePluginHost` finds them by ServiceLoader. Wiring one and not the
# other is what once diverged eleven corpus cases and printed five wrong answers — the executor
# stayed silent while v2's plugins answered on the bridge — so the two are set together, from one
# file, or not at all.
PLUGIN_CP_FILE="$JARS/plugins.cp"
# ON BY DEFAULT SINCE 2026-08-18 — the owner's decision, and it changes ONE of the two guarantees
# `plugin-classpath.sh` was written under. That file says a caller who is not using the fleet has no
# business waiting for sbt, and a build failure has no business making `ssc3 run` fail. The first
# lapses when everybody uses the fleet; THE SECOND IS KEPT — the build is attempted once, its output
# is discarded, and a failure leaves the fleet absent and the run going, exactly as a missing file
# did before.
#
# `SSC3_FLEET=off` turns it off, in the same spirit as `SSC3_PRELUDE=` and `SSC3_FRONT=v3`: a
# mechanism that cannot be switched off cannot be measured, and every floor this fleet holds was
# established by running the corpus with it off as the control.
# THE IMPORTABLE JVM LIBRARIES, on the same terms as the fleet: a cached fact, built on first use,
# never fatal. `v3/jvm-classpath.sh` says which ones — a declared list, because an import that
# resolves to whatever happens to be built is an import whose meaning depends on the build order.
JVM_CP_FILE="$JARS/jvm.cp"
jvm_cp() {
  [ "${SSC3_FLEET:-on}" = "off" ] && { printf ''; return 0; }
  if [ ! -s "$JVM_CP_FILE" ]; then
    "$ROOT/v3/jvm-classpath.sh" >/dev/null 2>&1 || true
  fi
  [ -s "$JVM_CP_FILE" ] && cat "$JVM_CP_FILE" || printf ''
}

fleet_cp() {
  [ "${SSC3_FLEET:-on}" = "off" ] && { printf ''; return 0; }
  if [ ! -s "$PLUGIN_CP_FILE" ]; then
    "$ROOT/v3/plugin-classpath.sh" >/dev/null 2>&1 || true
  fi
  [ -s "$PLUGIN_CP_FILE" ] && cat "$PLUGIN_CP_FILE" || printf ''
}
_jcp0="$(jvm_cp)"
_pcp0="$(fleet_cp)"
[ -n "$_jcp0" ] && _pcp0="${_pcp0:+$_pcp0:}$_jcp0"
if [ -n "$_pcp0" ]; then
  _pcp="$_pcp0"
  # `v3/plugins` is a THIRD source directory, compiled with the kernel exactly as `alphabet/src`
  # is — the kernel itself still references nothing outside the JDK, and the adapter that does is
  # over here. The fleet's classpath is `extra`, so it is part of the content-addressed digest and
  # a rebuilt fleet gets its own output directory rather than overwriting one.
  if V3PCP="$(classes_for ssc3p "$_pcp" "$ROOT/v3/src" "$ROOT/alphabet/src" "$ROOT/v3/plugins")"; then
    SSC3=(java -cp "$V3PCP:$_pcp:$TC" ssc3.ssc3)
    # `ssc3.plugins.v2cli`, not `ssc.cli`: the jars on the classpath are not enough, because
    # `ssc.cli` never asks the ServiceLoader for them. One `loadAll()` in that process fills the
    # registry that `Prims.resolve` already consults.
    V2=(java -Xss512m -cp "$V3PCP:$(classes_for ssc2 "" "$ROOT/v2/src"):$_pcp:$TC" ssc3.plugins.v2cli)
  else
    echo "ssc3: the plugin fleet is present but did not compile — running without it" >&2
  fi
fi

# The SECOND front, if it is available. Availability is an explicit cached fact — the classpath file
# exists or it does not — rather than something the driver discovers by running sbt, because a
# build of something the caller is not using has no business blocking `ssc3 run`.
# Refresh it with `v3/uniml-classpath.sh`.
UNIML_CP_FILE="$JARS/uniml.cp"
uniml_available() { [ -s "$UNIML_CP_FILE" ]; }

# The uniml front is compiled, not packaged: its classpath is directories that an assembly does not
# embed — measured, and the assembly ran with a NoClassDefFoundError on every fixture.
# CACHED on a digest of both source trees, for the same reason the jars are: without it every
# invocation recompiles, and the front-diff gate runs one per fixture.
# The second front's classpath: its own classes, UniML's jars, and the toolchain.
#
# IT USED TO CACHE A PATH `scala-cli` OWNED, and that cost an hour. `scala-cli` rewrites its output
# directory on every compile of the same inputs, so a digest-keyed cache of that path served the
# WRONG state's classes whenever the source went back to an earlier one — an A/B, or a gate
# self-test that plants a defect and reverts it. Three gates then reported a defect I had already
# fixed, which is the expensive kind of wrong answer because it points at working code.
#
# `classes_for` makes it unrepresentable rather than guarded: the output directory's NAME carries
# the digest, so it is written once and never rewritten, and going back to an earlier state finds
# that state's own directory still intact.
#
# HISTORICAL NOTE, kept because the shape recurs: `jar_for` sat six lines from the broken function
# and was always sound, for exactly this reason — it cached an artifact FILE keyed on the digest.
uniml_classpath() {
  local ucp out tc
  ucp="$(cat "$UNIML_CP_FILE")"
  tc="$(toolchain)" || return 1
  # `alphabet/src` belongs here for the same reason it is in the kernel's unit on line ~109: since
  # the two copies of the lexical alphabet were merged into one shared source directory,
  # `v3/src/Lexer.scala` references `scalascript.alphabet.Alphabet`, so compiling `v3/src` WITHOUT
  # it fails. The kernel's unit was updated by that refactor and this one was not, so the second
  # front stopped compiling — and the driver's fallback is silent by design, which turned a compile
  # error into "only these fronts are registered: none" two layers away.
  # THE FLEET BELONGS IN THIS UNIT TOO, and leaving it out is the same shape as the `alphabet/src`
  # omission described above. The uniml front is what the driver runs BY DEFAULT, so a fleet wired
  # only into the kernel's unit is wired into the lane almost nobody takes: `Cli.run` looks the
  # adapter up BY NAME, finds nothing here, and every host function stays refused while the kernel
  # lane answers. Measured exactly that way before this line existed.
  # THE SAME DECISION, READ BACK — not a second `[ -s … ]`. Two computations of one fact can
  # disagree, and when this one disagreed the executor answered while the bridge refused. `fleet_cp`
  # is where the default and the `SSC3_FLEET=off` switch live.
  local pcp=""
  pcp="$(fleet_cp)"
  local jcp="$(jvm_cp)"
  [ -n "$jcp" ] && pcp="${pcp:+$pcp:}$jcp"
  if [ -n "$pcp" ]; then
    out="$(classes_for unimlp "$ucp:$pcp" "$ROOT/v3/src" "$ROOT/alphabet/src" "$ROOT/v3/uniml" "$ROOT/v3/plugins")" || return 1
    printf '%s' "$out:$ucp:$pcp:$tc"
  else
    out="$(classes_for uniml "$ucp" "$ROOT/v3/src" "$ROOT/alphabet/src" "$ROOT/v3/uniml")" || return 1
    printf '%s' "$out:$ucp:$tc"
  fi
}

# ── THE DEFAULT FRONT ────────────────────────────────────────────────────────────────────────────
# UniML answers when its classpath is present. `40-front-on-uniml.md` §7 makes the swap a NUMBER
# rather than a judgement, and the number is met: both fronts print the same `Ast` for 48 of 48
# fixtures and 101 of 101 corpus cases.
#
# THE KERNEL JAR IS STILL THE FALLBACK, and that is the whole reason this is a driver decision.
# Invariant I-1 says v3's kernel has zero dependencies and must build and run with UniML absent —
# `v3/src` alone is a complete language. So the uniml front is a SECOND ARTIFACT that the driver
# prefers, never a requirement.
#
# `SSC3_FRONT=v3` forces the kernel's own front. Gates that compare the two need to name them, and
# §7 promised exactly this: "a regression is one environment variable away from being isolated".
#
# Which one actually answered is reported by `ssc3 front`, and `v3/front-report-gate.sh` asserts on
# it. That gate is not optional book-keeping: the two fronts agree on every fixture BY
# CONSTRUCTION, so no program's output can distinguish them, and a gate that cannot tell which of
# two states it is in proves nothing about either.
SSC3_FRONT_SEL="v3"
if [ "${SSC3_FRONT:-auto}" != "v3" ] && uniml_available; then
  # THE COMPILER'S STDERR IS CAPTURED, NOT PASSED THROUGH, and that is the whole fix.
  #
  # `uniml.cp` names sbt's output directories, whose CONTENTS change without the file changing — so
  # after a rebase, a sibling's commit or a fresh worktree it points at stale classes and
  # `v3/uniml/UniFront.scala` fails to compile against them. What used to reach the terminal was the
  # Scala compiler's full error, ABOVE this script's own one-line diagnostic. Read top-down that says
  # "the kernel does not compile", and on 2026-08-09 it cost a discarded measurement round and twice
  # a red `front-gate` attributed to the commit under test instead of to the checkout.
  #
  # So: hold the output, ask WHY, and print the answer instead of the symptom. A genuine kernel error
  # is still shown in full — it is only the known cause that gets replaced by its name.
  _ulog="$(mktemp)"
  if _ucp="$(uniml_classpath 2>"$_ulog")"; then
    SSC3=(java -cp "$_ucp" ssc3.ssc3uniml)
    SSC3_FRONT_SEL="uniml"
  elif ! "$ROOT/v3/uniml-classpath.sh" --check >/dev/null 2>&1; then
    echo "ssc3: the UniML classpath was built from different uniml/ sources than this tree has." >&2
    echo "      Run  v3/uniml-classpath.sh  and re-run. Using v3's own front meanwhile." >&2
    echo "      (the compiler error is suppressed: it is a symptom of the stale classpath, not of your tree)" >&2
  else
    cat "$_ulog" >&2
    echo "ssc3: the uniml front is present but did not compile — using v3's own front" >&2
  fi
  rm -f "$_ulog"
fi

cmd="${1:-}"
case "$cmd" in
  # `run` is v3's OWN runtime as of 2026-08-07. It was the v2 bridge until then, and the switch was
  # made on a measurement rather than a preference: both lanes give N = 48 on the corpus with DIFF 0
  # and CRASH 0, and the executor implements EVERY primitive v3's lowering can emit — so there is no
  # capability a v3 program can reach through the bridge and not here.
  #
  # The bridge is not retired and is not a fallback. It is the COMPATIBILITY lane: `ssc3 build`
  # emits v2 Core IR, which is how v3 inherits the whole v2 backend fleet without having written
  # one. `run --bridge` runs through it, and the executor gate compares the two on every fixture.
  run)
    [ $# -ge 2 ] || { echo "usage: ssc3 run [--bridge] <file.ssc>" >&2; exit 2; }
    if [ "$2" = "--bridge" ]; then
      [ $# -ge 3 ] || { echo "usage: ssc3 run --bridge <file.ssc>" >&2; exit 2; }
      ir="$(mktemp "${TMPDIR:-/tmp}/ssc3run.XXXXXX")"
      trap 'rm -f "$ir"' EXIT
      # The build step's diagnostics go to stderr and its exit code decides. Running a program the
      # front refused would be worse than not running it at all.
      #
      # ANYTHING AFTER THE FILE IS FORWARDED. This line read `build "$3"` and dropped the rest, so
      # the bridge's own OFF flags — `--no-structured-loops`, `--no-fold-temps` — could be spelled
      # but not USED through `run --bridge`, which is the only command a gate runs the lane with.
      # An A/B whose OFF arm silently runs ON reports the rewrite as free.
      f="$3"; shift 3
      "${SSC3[@]}" build "$f" "$@" > "$ir" || exit 1
      exec "${V2[@]}" run-ir "$ir"
    fi
    exec "${SSC3[@]}" exec "$2"
    ;;
  # The v2 VM, for callers that drive it themselves — the gates run `run-ir` on a `.ssir` the front
  # produced. Exposed here rather than letting each gate spell out `scala-cli run v2/src`, which is
  # what put three of them back on the un-cached path and cost a red gate on a program that runs.
  v2)
    shift
    exec "${V2[@]}" "$@"
    ;;
  # Which fronts can actually run, one per line. Asked by `front-diff.sh` rather than duplicated
  # there: a list in two places is a list that disagrees with itself.
  fronts)
    echo "v3"
    uniml_available && echo "uniml"
    exit 0
    ;;
  # `ast <file> [front]` routes to the second front when it is the one asked for. Everything else
  # goes to the kernel, which does not know UniML exists.
  # The resolved uniml classpath, for callers that must run the second front themselves.
  # `corpus-report.sh` packages its own assembly for speed and so cannot use `$SSC3`; without this
  # it silently measured v3's own front no matter what it was asked for.
  # The kernel's and v2's classpaths, for callers that must run them directly. `corpus-report.sh`
  # starts a JVM per case per side and cannot pay a driver invocation for each; before this it
  # packaged its own copies with `scala-cli`, so it built the same sources twice and measured
  # artifacts nobody else had run.
  __kernel-cp)
    printf '%s:%s\n' "$V3CP" "$TC"
    exit 0
    ;;
  __v2-cp)
    cp2="$(classes_for ssc2 "" "$ROOT/v2/src")" || exit 2
    printf '%s:%s\n' "$cp2" "$TC"
    exit 0
    ;;
  # THE v2 ENTRY, so a caller does not have to keep its own copy of the decision.
  #
  # `v3/corpus-report.sh` did keep one — `java -cp "$(ssc3 __v2-cp)" ssc.cli run-ir` — and the two
  # copies diverged the moment this driver learned about the plugin fleet: the report BUILT the IR
  # with a front that has the fleet installed, so lowering emitted `(prim "mkdirs" …)` instead of a
  # refusal, and then RAN that IR on a plain `ssc.cli` with no plugins. The build side and the run
  # side disagreed about which prims exist, and four cases died on a prim the builder was entitled
  # to emit. Printing the whole command from here is what makes that unrepresentable.
  __v2-run)
    printf '%s\n' "${V2[@]}"
    exit 0
    ;;
  __classpath)
    uniml_available || { echo "ssc3: the uniml front is not available — run v3/uniml-classpath.sh" >&2; exit 2; }
    uniml_classpath || { echo "ssc3: could not compile the uniml front" >&2; exit 2; }
    exit 0
    ;;
  # `ast <file> [front]` NAMES its front, and names it all the way down to the artifact rather than
  # to `$SSC3` — the differential's whole job is running both on the same file, so it must not be
  # affected by which one the default happens to be. Omitting the argument gets the default.
  ast)
    want="${3:-$SSC3_FRONT_SEL}"
    if [ "$want" = "uniml" ]; then
      uniml_available || { echo "ssc3: the uniml front is not available — run v3/uniml-classpath.sh" >&2; exit 2; }
      cp="$(uniml_classpath)" || { echo "ssc3: could not compile the uniml front" >&2; exit 2; }
      exec java -cp "$cp" ssc3.ssc3uniml ast "$2"
    fi
    # THE FLEET-AWARE KERNEL, not the bare one. `$V3CP` has no `v3/plugins` on it, so the process
    # that prints v3's own tree could not answer "is this a JVM package you provide" — and a JVM
    # import therefore failed on THIS front while succeeding on the other. `front-diff` caught it on
    # the fixture's first run, which is the whole reason the differential exists. `${V3PCP:-$V3CP}`
    # keeps a tree without the fleet working exactly as before.
    exec java -cp "${V3PCP:-$V3CP}:${_pcp0:-}:$TC" ssc3.ssc3 ast "$2"
    ;;
  *)
    exec "${SSC3[@]}" "$@"
    ;;
esac
