import "../lib/irbin.ssc0"
-- The three fail-OPEN defects of the deferred v2-bin codec, pinned so a future edit cannot quietly
-- restore them (BUGS.md irbin-v2bin-codec-fails-open).
--
-- Each line prints an outcome rather than crashing, so a regression shows WHICH property broke.

-- (1) A BigInt far outside Int64. The old encoder pushed it through `big->i`, which "may overflow"
-- (10-core-ir.md §5), so the value came back CORRUPTED with no error. Measured before the fix:
-- this line printed "bigint-CORRUPTED".
def huge = match #str->big("18446744073709551617") { case Some(x) => x case None => #i->big(0) }
def bigIr = IrProg(Nil, IrLit(IrBig(huge)))
def bigCheck =
  let back = binDecode(binEncode(bigIr)) in
  if #seq(#coreir.encode(back), #coreir.encode(bigIr)) then "bigint-preserved" else "bigint-CORRUPTED"

-- (2) An unknown tag byte must FAIL CLOSED. The old decoder had a bare `else` that turned ANY
-- unrecognised tag into IrStr, so corrupt or future-versioned input decoded to a plausible-looking
-- WRONG program. 99 is not a tag this codec emits.
def unknownTag = let a = #arr.new() in let u = #arr.push(a, 99) in a
-- Matched structurally rather than through `coreir.encode`: that prim demands an IrProg, and the
-- refusal value is deliberately a bare node, so encoding it would fail for the wrong reason.
def unknownCheck =
  match binDecode(unknownTag) {
    case IrGlobal(n) => if #seq(n, "_err_irbin_unknown_tag") then "unknown-tag-refused" else "unknown-tag-WRONG-ERROR"
    case _ => "unknown-tag-ACCEPTED"
  }

-- (3) A float body that does not parse must fail closed too — it used to become 0.0, a silent
-- wrong number. Tag 19 = IrFloat, followed by a string that is not a float literal.
def badFloat =
  let a = #arr.new() in
  let u1 = #arr.push(a, 19) in
  let u2 = #arr.push(a, 3) in
  let u3 = #arr.push(a, 120) in let u4 = #arr.push(a, 121) in let u5 = #arr.push(a, 122) in a
def floatCheck =
  match binDecode(badFloat) {
    case IrGlobal(n) => if #seq(n, "_err_irbin_bad_float") then "bad-float-refused" else "bad-float-WRONG-ERROR"
    case _ => "bad-float-ACCEPTED"
  }

-- (4) NEGATIVE ZERO. The encoder used `#f->str`, the USER-VISIBLE renderer, where
-- `floatStr(-0.0) == "0" == floatStr(0.0)` — so the sign bit was lost in the ENCODER and `-0.0`
-- came back as `+0.0` with nothing to indicate it.
--
-- COMPARED THROUGH `#coreir.encode`, NOT BY VALUE, and that is the whole reason this pins anything:
-- `-0.0 == 0.0` is TRUE in IEEE-754, so a value comparison passes in BOTH states and proves nothing.
-- The canonical text codec renders through `Writer.floatLit`, which spells them `-0.0` and `0.0`,
-- so encoding is the cheapest thing here that can tell them apart.
def negZeroIr = IrProg(Nil, IrLit(IrFloat(#f.neg(0.0))))
def negZeroCheck =
  let back = binDecode(binEncode(negZeroIr)) in
  if #seq(#coreir.encode(back), #coreir.encode(negZeroIr)) then "negzero-preserved" else "negzero-COLLAPSED"

-- (5) The float SPECIALS survive. `#f->lit` spells them `nan` / `inf` / `-inf`, which `#str->f`
-- does NOT parse — Scala wants `NaN` / `Infinity` — so pairing the canonical literal with the
-- ordinary string parser would encode a special faithfully and then fail to read its own output.
-- `#lit->f` is the exact inverse, and this pins that it stayed exact.
def infIr = IrProg(Nil, IrLit(IrFloat(#f.div(1.0, 0.0))))
def infCheck =
  let back = binDecode(binEncode(infIr)) in
  if #seq(#coreir.encode(back), #coreir.encode(infIr)) then "inf-preserved" else "inf-LOST"

-- (6) `IrBytes` had NO representation: the encoder had no case for it at all, so a bytes literal
-- could not survive a round trip in either direction. Tag 25 carries it as lowercase hex — the same
-- spelling the canonical text codec writes inside `(bytes HEX)`, so the two codecs agree on the
-- wire form instead of each inventing one.
def bytesCheck =
  match #hex->bytes("00ff10") {
    case None => "bytes-HEX-REFUSED"
    case Some(b) =>
      let ir = IrProg(Nil, IrLit(IrBytes(b))) in
      if #seq(#coreir.encode(binDecode(binEncode(ir))), #coreir.encode(ir)) then "bytes-preserved" else "bytes-LOST"
  }

-- …and the hex decoder must FAIL CLOSED on input it cannot represent exactly: an odd length is
-- half a byte, and a codec that guesses is the very thing this entry is named after.
def hexOddCheck = match #hex->bytes("abc") { case None => "odd-hex-refused" case Some(x) => "odd-hex-ACCEPTED" }

def main = () => #io.println(Pair(bigCheck, Pair(unknownCheck, Pair(floatCheck, Pair(negZeroCheck, Pair(infCheck, Pair(bytesCheck, hexOddCheck)))))))
