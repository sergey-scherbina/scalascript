#!/usr/bin/env bash
# Read-only GitHub Actions status. Exact-SHA for ci.yml by default; any workflow on request.
#
# It used to hardcode `--workflow ci.yml --event push`, which meant NO automated check in this repo
# ever looked at the other four workflows. Measured 2026-07-27: `corpus-contract.yml` had 0 successes
# in its last 12 runs (4 failure, 7 cancelled, 1 running) — every one of them scheduled, therefore
# invisible to every tool an agent runs — and `native-release.yml` had never run at all. A status tool
# that structurally cannot see a red is the apparatus-lies-green shape this project keeps paying for.
#
# The no-argument behaviour is unchanged on purpose (agents and AGENTS.md §4c depend on it, and
# tests/e2e/ci-status-guard.sh asserts the exact filter set it sends).

set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
GH_BIN="${SSC_CI_GH:-gh}"
SHA=""
WORKFLOW="ci.yml"
EVENT="push"
BRANCH="main"
LATEST=0
ALL_WORKFLOWS=0
EXACT_ONLY=0
COVERED_BY=""

usage() {
  cat <<'EOF'
Usage: scripts/ci-status [--sha GIT_SHA] [--workflow FILE] [--event E|any]
                         [--branch B] [--latest] [--all-workflows]

Default (no arguments): the push-triggered ci.yml run for exactly one commit,
using the locally fetched origin/main commit. This is the AGENTS.md §4c check
and its behaviour is deliberately unchanged.

  --workflow FILE    workflow file to query (default: ci.yml)
  --event E          trigger to filter on; `any` disables the filter. A
                     SCHEDULED workflow has no push run, so `--event any` (or
                     --latest) is the only way to see it at all.
  --branch B         branch filter (default: main)
  --latest           ignore the SHA and take the most recent run. Scheduled
                     runs fire against whatever main was at the time, so an
                     exact-SHA query almost never matches one.
  --exact-only       do NOT fall back to a descendant run. GitHub creates one
                     run per PUSH, attributed to the push's tip, so a code
                     commit pushed together with a later docs commit has no run
                     of its own even though it was fully tested. By default a
                     run whose head is a DESCENDANT of the requested SHA is
                     reported as covering it, labelled `(descendant)`; this
                     flag restores the strict exact-SHA-or-nothing answer.
  --all-workflows    one line per workflow in .github/workflows, from its most
                     recent run of any kind. This is the blind-spot check: it
                     is what makes a workflow that is red every night, or that
                     has never run, impossible to miss.

For ci.yml the three per-push jobs (Lint, Validate, Conformance) must each be green;
`sbt — compile and test` is additionally required on non-push runs, which is where it
runs (see BUGS ci-sbt-job-is-28x-the-code-push-interval). For any other workflow
the rule is simply that the run completed successfully AND every job in it
succeeded — required-job lists are workflow-specific and inventing one for a
workflow this script does not know would be a guess.

Exit codes:
  0  run completed and all required jobs succeeded
  1  run completed red or omitted a required job
  2  run is pending, absent, or could not be queried
EOF
}

while [[ $# -gt 0 ]]; do
  case "$1" in
    --sha)
      if [[ $# -lt 2 || -z "$2" ]]; then
        printf 'ci-status: --sha requires a value\n' >&2
        usage >&2
        exit 2
      fi
      SHA="$2"
      shift 2
      ;;
    --workflow)
      if [[ $# -lt 2 || -z "$2" ]]; then
        printf 'ci-status: --workflow requires a value\n' >&2; usage >&2; exit 2
      fi
      WORKFLOW="$2"; shift 2 ;;
    --event)
      if [[ $# -lt 2 || -z "$2" ]]; then
        printf 'ci-status: --event requires a value\n' >&2; usage >&2; exit 2
      fi
      EVENT="$2"; shift 2 ;;
    --branch)
      if [[ $# -lt 2 || -z "$2" ]]; then
        printf 'ci-status: --branch requires a value\n' >&2; usage >&2; exit 2
      fi
      BRANCH="$2"; shift 2 ;;
    --latest) LATEST=1; shift ;;
    --exact-only) EXACT_ONLY=1; shift ;;
    --all-workflows) ALL_WORKFLOWS=1; shift ;;
    --help|-h)
      usage
      exit 0
      ;;
    *)
      printf 'ci-status: unknown argument: %s\n' "$1" >&2
      usage >&2
      exit 2
      ;;
  esac
done

if [[ -z "$SHA" ]]; then
  if ! SHA="$(git -C "$ROOT" rev-parse --verify 'origin/main^{commit}' 2>/dev/null)"; then
    printf 'CI UNKNOWN origin/main\n'
    printf '  reason: origin/main is unavailable; fetch the remote first\n'
    exit 2
  fi
fi

unknown() {
  local reason="$1"
  local detail="${2:-}"
  printf 'CI UNKNOWN %s\n' "$SHA"
  printf '  reason: %s\n' "$reason"
  if [[ -n "$detail" ]]; then
    while IFS= read -r line; do
      printf '  gh: %s\n' "$line"
    done <<<"$detail"
  fi
  exit 2
}

if ! command -v "$GH_BIN" >/dev/null 2>&1; then
  unknown "GitHub CLI is unavailable: $GH_BIN"
fi

# ── --all-workflows: the blind-spot sweep ────────────────────────────────────
# One line per workflow FILE that exists, taken from its most recent run of any trigger. No branch,
# event or commit filter — those filters are exactly what hid the scheduled workflows. A workflow
# with no runs at all is reported loudly but does NOT set the exit code: a tag-triggered release
# workflow legitimately has none, and making that permanently non-zero would train everyone to
# ignore the command.
if [[ "$ALL_WORKFLOWS" -eq 1 ]]; then
  any_red=0
  any_unknown=0
  for wf in "$ROOT"/.github/workflows/*.yml; do
    [[ -e "$wf" ]] || continue
    name="$(basename "$wf")"
    set +e
    payload="$(cd "$ROOT" && "$GH_BIN" run list --workflow "$name" --limit 1 \
      --json status,conclusion,event,headSha,createdAt,url \
      --jq 'if length == 0 then "NONE" else .[0] | "\(.status)|\(.conclusion // "")|\(.event)|\(.headSha[0:9])|\(.createdAt)|\(.url)" end' 2>&1)"
    code=$?
    set -e
    if [[ "$code" -ne 0 ]]; then
      printf '  %-24s QUERY-FAILED  %s\n' "$name" "$(head -1 <<<"$payload")"
      any_unknown=1
      continue
    fi
    if [[ "$payload" == "NONE" || -z "$payload" ]]; then
      printf '  %-24s NEVER-RUN\n' "$name"
      continue
    fi
    IFS='|' read -r st concl ev sha created url <<<"$payload"
    verdict="$st/${concl:-pending}"
    case "$concl" in
      success) mark="GREEN" ;;
      failure|cancelled|timed_out|startup_failure) mark="RED"; any_red=1 ;;
      *) mark="PENDING"; any_unknown=1 ;;
    esac
    printf '  %-24s %-8s %-22s %s %s %s\n' "$name" "$mark" "$verdict" "$ev" "$sha" "$created"
  done
  if [[ "$any_red" -eq 1 ]]; then
    printf 'WORKFLOWS RED\n'; exit 1
  fi
  if [[ "$any_unknown" -eq 1 ]]; then
    printf 'WORKFLOWS PENDING/UNKNOWN\n'; exit 2
  fi
  printf 'WORKFLOWS GREEN\n'; exit 0
fi

list_args=(run list --workflow "$WORKFLOW" --branch "$BRANCH")
if [[ "$EVENT" != "any" ]]; then list_args+=(--event "$EVENT"); fi
list_args_nocommit=("${list_args[@]}")
if [[ "$LATEST" -eq 0 ]]; then list_args+=(--commit "$SHA"); fi

set +e
run_payload="$(
  cd "$ROOT" && "$GH_BIN" "${list_args[@]}" \
    --limit 5 \
    --json databaseId,headSha,status,conclusion,url,event \
    --jq 'if length == 0 then empty else .[0] | "RUN_ID=\(.databaseId)\nRUN_SHA=\(.headSha)\nRUN_STATUS=\(.status)\nRUN_CONCLUSION=\(.conclusion // "")\nRUN_URL=\(.url)\nRUN_EVENT=\(.event)" end' \
    2>&1
)"
run_code=$?
set -e

if [[ "$run_code" -ne 0 ]]; then
  unknown "gh run list failed" "$run_payload"
fi
# ── descendant fallback (BUGS.md ci-status-sha-misses-commits-covered-by-a-later-tip) ────────
# GitHub creates ONE run per PUSH, attributed to the push's TIP commit. A push of
# code-commit -> docs-commit therefore produces a single run named after the DOCS commit: the code
# WAS fully tested, but an exact-SHA query finds nothing and the old answer was `CI UNKNOWN`. That
# answer is wrong in the direction that costs the most — it pushes people to re-run CI or to accept
# weaker evidence for a commit that already has strong evidence.
#
# A run whose head is a DESCENDANT of the requested SHA contains that SHA's tree, so its verdict
# covers it. This is the green-descendant rung of the AGENTS.md §4c ladder, made mechanical instead
# of manual. It is always LABELLED `(descendant)` and names the covering SHA, because "tested as
# part of a later tip" is genuinely weaker than "tested alone" and must never read as the latter.
# `--exact-only` restores the strict answer.
find_covering_descendant() { # -> sets run_payload/COVERED_BY, or returns 1
  local candidates head
  set +e
  candidates="$(cd "$ROOT" && "$GH_BIN" "${list_args_nocommit[@]}" --limit 40 \
    --json databaseId,headSha,status,conclusion,url,event \
    --jq '.[] | "\(.headSha)|\(.databaseId)|\(.status)|\(.conclusion // "")|\(.url)|\(.event)"' 2>/dev/null)"
  set -e
  [[ -n "$candidates" ]] || return 1
  # Oldest first: the NEAREST descendant is the most specific evidence. gh lists newest first.
  local best_line=""
  while IFS= read -r line; do
    [[ -n "$line" ]] || continue
    head="${line%%|*}"
    # Unknown locally (not fetched) or not a descendant -> not evidence.
    git -C "$ROOT" cat-file -e "${head}^{commit}" 2>/dev/null || continue
    git -C "$ROOT" merge-base --is-ancestor "$SHA" "$head" 2>/dev/null || continue
    [[ "$head" == "$SHA" ]] && continue
    best_line="$line"
  done <<<"$candidates"
  [[ -n "$best_line" ]] || return 1
  IFS='|' read -r d_sha d_id d_status d_concl d_url d_event <<<"$best_line"
  COVERED_BY="$d_sha"
  run_payload="RUN_ID=$d_id
RUN_SHA=$d_sha
RUN_STATUS=$d_status
RUN_CONCLUSION=$d_concl
RUN_URL=$d_url
RUN_EVENT=$d_event"
  return 0
}

if [[ -z "$run_payload" && "$EXACT_ONLY" -eq 0 && "$LATEST" -eq 0 ]]; then
  find_covering_descendant || true
fi

if [[ -z "$run_payload" ]]; then
  if [[ "$WORKFLOW" == "ci.yml" && "$EVENT" == "push" && "$LATEST" -eq 0 ]]; then
    unknown "no push ci.yml run found for the exact SHA"
  fi
  scope="$WORKFLOW (event=$EVENT, branch=$BRANCH)"
  if [[ "$LATEST" -eq 1 ]]; then
    unknown "no run found for $scope"
  fi
  unknown "no run found for $scope at the exact SHA"
fi

run_id=""
run_sha=""
run_status=""
run_conclusion=""
run_url=""
run_event=""
while IFS= read -r line; do
  case "$line" in
    RUN_ID=*) run_id="${line#RUN_ID=}" ;;
    RUN_SHA=*) run_sha="${line#RUN_SHA=}" ;;
    RUN_STATUS=*) run_status="${line#RUN_STATUS=}" ;;
    RUN_CONCLUSION=*) run_conclusion="${line#RUN_CONCLUSION=}" ;;
    RUN_URL=*) run_url="${line#RUN_URL=}" ;;
    RUN_EVENT=*) run_event="${line#RUN_EVENT=}" ;;
  esac
done <<<"$run_payload"

if [[ -z "$run_id" || -z "$run_sha" || -z "$run_status" || -z "$run_url" ]]; then
  unknown "malformed gh run list response" "$run_payload"
fi
# In --latest mode the SHA is informational: a scheduled run fires against whatever main was at the
# time, so demanding a match would reject exactly the runs this mode exists to surface.
if [[ "$LATEST" -eq 0 && -z "$COVERED_BY" && "$run_sha" != "$SHA" ]]; then
  unknown "GitHub returned SHA $run_sha for requested SHA $SHA" "$run_payload"
fi
if [[ "$LATEST" -eq 1 ]]; then SHA="$run_sha"; fi

set +e
jobs_payload="$(
  cd "$ROOT" && "$GH_BIN" run view "$run_id" \
    --json jobs \
    --jq '.jobs[] | "\(.name)|\(.status)|\(.conclusion // "")"' \
    2>&1
)"
jobs_code=$?
set -e
if [[ "$jobs_code" -ne 0 ]]; then
  unknown "gh run view failed for run $run_id" "$jobs_payload"
fi

# A run with NO jobs at all is not "a workflow that dropped four jobs" — it is a run that never
# started one, which today means it was cancelled by queue eviction or superseded by the concurrency
# group. Listing the four required names as "missing" sends the reader hunting for a workflow-config
# problem that does not exist; observed for real on run 30310314697 (completed/cancelled, 0 jobs).
if [[ -z "${jobs_payload//[[:space:]]/}" ]]; then
  detail="${run_conclusion:-$run_status}"
  headline_suffix=""
  [[ -n "$COVERED_BY" ]] && headline_suffix=" (descendant)"
  if [[ "$run_status" != "completed" ]]; then
    printf 'CI PENDING%s %s %s\n' "$headline_suffix" "$SHA" "$run_url"
    [[ -n "$COVERED_BY" ]] && printf '  covered by: %s\n' "$COVERED_BY"
    printf '  run has not started any job yet (%s)\n' "$detail"
    exit 2
  fi
  printf 'CI RED%s %s %s\n' "$headline_suffix" "$SHA" "$run_url"
  [[ -n "$COVERED_BY" ]] && printf '  covered by: %s\n' "$COVERED_BY"
  printf '  run completed/%s with ZERO jobs — it never started one, so it is evidence of nothing.\n' "$detail"
  printf '  A cancelled run is RED, not neutral (MILESTONES.md). See BUGS ci-runs-cancelled-under-churn.\n'
  exit 1
fi

# ci.yml has a known contract — those four jobs must exist AND be green, so a run that silently
# dropped one is RED rather than accidentally green. For any other workflow there is no such list,
# and inventing one would be a guess: the rule there is that every job the run DID have succeeded.
if [[ "$WORKFLOW" == "ci.yml" ]]; then
  # These three are the PER-PUSH verdict and must always be green.
  required_jobs=(
    "Lint Markdown"
    "Validate ScalaScript"
    "Conformance Suite"
  )
  # `sbt — compile and test` is required only where it actually runs. It was moved off the push path
  # (ci.yml `if: github.event_name != 'push'`) because it takes 196 min against a 7-min mean code-push
  # interval, so at most 1 commit in 28 could reach a verdict (BUGS
  # `ci-sbt-job-is-28x-the-code-push-interval`). Keeping it in this list for push runs would have made
  # THIS script report every push RED — the verdict tool contradicting the workflow it verifies, which
  # is the same self-inflicted apparatus break the project keeps paying for. Keyed off the RUN's own
  # event, not the --event FILTER, so `--event any` landing on a push run does not produce a false red.
  if [[ "$run_event" != "push" ]]; then
    required_jobs+=("sbt — compile and test")
  fi
else
  required_jobs=()
  while IFS='|' read -r jname _jstatus _jconcl; do
    [[ -n "$jname" ]] && required_jobs+=("$jname")
  done <<<"$jobs_payload"
  if [[ "${#required_jobs[@]}" -eq 0 ]]; then
    unknown "run $run_id for $WORKFLOW reported no jobs" "$jobs_payload"
  fi
fi

report=""
all_success=true
for required in "${required_jobs[@]}"; do
  found=false
  found_status=""
  found_conclusion=""
  while IFS='|' read -r name status conclusion; do
    if [[ "$name" == "$required" ]]; then
      found=true
      found_status="$status"
      found_conclusion="$conclusion"
      break
    fi
  done <<<"$jobs_payload"

  if $found; then
    display_conclusion="${found_conclusion:-pending}"
    report="${report}  ${required}: ${found_status}/${display_conclusion}"$'\n'
    if [[ "$found_status" != "completed" || "$found_conclusion" != "success" ]]; then
      all_success=false
    fi
  else
    report="${report}  missing required job: ${required}"$'\n'
    all_success=false
  fi
done

# A descendant verdict is real evidence but NOT the same claim as an exact-SHA run, so it is marked
# in the headline itself rather than in a trailing note someone can skim past.
suffix=""
coverage=""
if [[ -n "$COVERED_BY" ]]; then
  suffix=" (descendant)"
  coverage="  covered by: ${COVERED_BY} — one run per PUSH, so this commit has no run of its own"$'\n'
fi

if [[ "$run_status" != "completed" ]]; then
  printf 'CI PENDING%s %s %s\n' "$suffix" "$SHA" "$run_url"
  printf '%s' "$coverage"
  printf '%s' "$report"
  exit 2
fi

if [[ "$run_conclusion" == "success" ]] && $all_success; then
  printf 'CI GREEN%s %s %s\n' "$suffix" "$SHA" "$run_url"
  printf '%s' "$coverage"
  printf '%s' "$report"
  exit 0
fi

printf 'CI RED%s %s %s\n' "$suffix" "$SHA" "$run_url"
printf '%s' "$coverage"
printf '%s' "$report"
if [[ -n "$run_conclusion" ]]; then
  printf '  workflow: completed/%s\n' "$run_conclusion"
else
  printf '  workflow: completed/unknown\n'
fi
exit 1
