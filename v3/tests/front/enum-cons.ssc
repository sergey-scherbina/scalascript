enum Color:
  case Red
  case Green
  case Blue

enum Shape:
  case Circle(r: Int)
  case Rect(w: Int, h: Int)

def name(c: Color): String =
  c match
    case Red => "red"
    case Green => "green"
    case Blue => "blue"

def area(s: Shape): Int =
  s match
    case Circle(r) => 3 * r * r
    case Rect(w, h) => w * h

println(name(Green))
println(area(Circle(2)))
println(area(Rect(3, 4)))

def total(xs: Int): Int =
  xs match
    case h :: t => h + total(t)
    case Nil => 0
println(total(List(1, 2, 3, 4)))
