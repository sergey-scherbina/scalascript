-- ssc1-run: end-to-end .ssc Markdown runner (KC13)
-- Usage: ssc run bin/ssc1-run.ssc0 <file.ssc>
-- Pipeline: extractFences → filter scalascript blocks → concat → lex/parse/lower → emit Core IR
--           …plus [names](path.ssc) module loading (v2-native-front-ssc-module-loading).
import "../lib/mira-md.ssc0"
import "../lib/ssc1-lower.ssc0"

-- Collect source of every "scalascript" fenced block into one string.
def joinScalaScript = (blocks) =>
  let rec go = (bs, acc) =>
    match bs {
      case Nil => acc
      case Cons(b, rest) =>
        match b {
          case Pair(lang, src) =>
            let langTok = fenceLangTok(lang) in
            -- `@doc` = documentation, never lowered into the program (specs/ssc-doc-blocks.md).
            let isDoc = fenceHasFlag(lang, "doc") in
            let isCode =
              if isDoc then false
              else (if #seq(langTok, "scalascript") then true else #seq(langTok, "scala")) in
            if isCode then
              let sep = if #i.eq(slen(acc), 0) then "" else "\n\n" in
              go(rest, #sconcat(acc, #sconcat(sep, src)))
            else
              go(rest, acc)
        }
    } in
  go(blocks, "")

-- Collect executable source while retaining the heading-scoped YAML section
-- contract.  The generic Markdown extractor deliberately returns only fences,
-- so it cannot associate a yaml/yml fence with its nearest heading.
def sscAsciiDigit = (c) => if #i.ge(c, 48) then #i.le(c, 57) else false
def sscAsciiAlpha = (c) =>
  let upper = if #i.ge(c, 65) then #i.le(c, 90) else false in
  if upper then true else (if #i.ge(c, 97) then #i.le(c, 122) else false)
def sscAsciiAlnum = (c) => if sscAsciiAlpha(c) then true else sscAsciiDigit(c)
def sscUpperAscii = (s, i) =>
  let c = #scodeAt(s, i) in
  if #i.ge(c, 97) then
    if #i.le(c, 122) then #sfromCodes(Cons(#i.sub(c, 32), Nil))
    else #sslice(s, i, #i.add(i, 1))
  else #sslice(s, i, #i.add(i, 1))
def sscSkipHashes = (s, i) =>
  if #i.ge(i, #slen(s)) then i
  else if #i.eq(#scodeAt(s, i), 35) then sscSkipHashes(s, #i.add(i, 1)) else i
def sscHeadingWords = (s, i, inWord, words, acc) =>
  if #i.ge(i, #slen(s)) then acc
  else
    let c = #scodeAt(s, i) in
    if sscAsciiAlnum(c) then
      let piece =
        if inWord then #sslice(s, i, #i.add(i, 1))
        else if #i.gt(words, 0) then sscUpperAscii(s, i)
        else #sslice(s, i, #i.add(i, 1)) in
      sscHeadingWords(s, #i.add(i, 1), true, words, #sconcat(acc, piece))
    else
      sscHeadingWords(s, #i.add(i, 1), false,
        if inWord then #i.add(words, 1) else words, acc)
def sscHeadingId = (line) =>
  let t = strip(line) in
  if #i.eq(#slen(t), 0) then ""
  else if #i.eq(#scodeAt(t, 0), 35) then
    let body = strip(#sslice(t, sscSkipHashes(t, 0), #slen(t))) in
    let raw = sscHeadingWords(body, 0, false, 0, "") in
    if #i.eq(#slen(raw), 0) then ""
    else if sscAsciiDigit(#scodeAt(raw, 0)) then #sconcat("_", raw)
    else raw
  else ""
def sscAppendSource = (acc, chunk) =>
  if #i.eq(#slen(chunk), 0) then acc
  else if #i.eq(#slen(acc), 0) then chunk
  else #sconcat(acc, #sconcat("\n\n", chunk))

-- SQL fences stay opaque to the language parser, but their `${expr}` binds are
-- a source-language safety boundary. Rewrite them here, while exact document
-- order and the enclosing heading are still available.
def sscFenceTokenEnd = (s, i) =>
  if #i.ge(i, #slen(s)) then i
  else
    let c = #scodeAt(s, i) in
    if #i.eq(c, 32) then i else (if #i.eq(c, 9) then i else sscFenceTokenEnd(s, #i.add(i, 1)))
def sscFenceToken = (s) => #sslice(s, 0, sscFenceTokenEnd(s, 0))
def sscFindText = (s, needle, i) =>
  if #i.gt(#i.add(i, #slen(needle)), #slen(s)) then #i.neg(1)
  else if #seq(#sslice(s, i, #i.add(i, #slen(needle))), needle) then i
  else sscFindText(s, needle, #i.add(i, 1))
def sscAttrEnd = (s, i) =>
  if #i.ge(i, #slen(s)) then i
  else
    let c = #scodeAt(s, i) in
    if #i.eq(c, 32) then i else (if #i.eq(c, 9) then i else sscAttrEnd(s, #i.add(i, 1)))
def sscFenceAttr = (lang, name, fallback) =>
  let prefix = #sconcat("@", #sconcat(name, "=")) in
  let at = sscFindText(lang, prefix, 0) in
  if #i.lt(at, 0) then fallback
  else
    let start = #i.add(at, #slen(prefix)) in
    let value = #sslice(lang, start, sscAttrEnd(lang, start)) in
    if #i.eq(#slen(value), 0) then fallback else value

def sscSqlBindEnd = (s, i, depth, quote, escaped) =>
  if #i.ge(i, #slen(s)) then #i.neg(1)
  else
    let c = #scodeAt(s, i) in
    if #i.gt(quote, 0) then
      if escaped then sscSqlBindEnd(s, #i.add(i, 1), depth, quote, false)
      else if #i.eq(c, 92) then sscSqlBindEnd(s, #i.add(i, 1), depth, quote, true)
      else if #i.eq(c, quote) then sscSqlBindEnd(s, #i.add(i, 1), depth, 0, false)
      else sscSqlBindEnd(s, #i.add(i, 1), depth, quote, false)
    else if #i.eq(c, 34) then sscSqlBindEnd(s, #i.add(i, 1), depth, 34, false)
    else if #i.eq(c, 39) then sscSqlBindEnd(s, #i.add(i, 1), depth, 39, false)
    else if #i.eq(c, 123) then sscSqlBindEnd(s, #i.add(i, 1), #i.add(depth, 1), 0, false)
    else if #i.eq(c, 125) then
      if #i.eq(depth, 0) then i
      else sscSqlBindEnd(s, #i.add(i, 1), #i.sub(depth, 1), 0, false)
    else sscSqlBindEnd(s, #i.add(i, 1), depth, 0, false)

def sscSqlRewrite = (s, i, sql, binds) =>
  if #i.ge(i, #slen(s)) then Pair("__ok__", Pair(sql, reverse(binds)))
  else
    let c = #scodeAt(s, i) in
    if #i.eq(c, 36) then
      if #i.lt(#i.add(i, 1), #slen(s)) then
        let next = #scodeAt(s, #i.add(i, 1)) in
        if #i.eq(next, 36) then
          sscSqlRewrite(s, #i.add(i, 2), #sconcat(sql, "$"), binds)
        else if #i.eq(next, 123) then
          let end = sscSqlBindEnd(s, #i.add(i, 2), 0, 0, false) in
          if #i.lt(end, 0) then Pair("__bad__", Pair(sql, reverse(binds)))
          else
            let expr = strip(#sslice(s, #i.add(i, 2), end)) in
            if #i.eq(#slen(expr), 0) then Pair("__bad__", Pair(sql, reverse(binds)))
            else sscSqlRewrite(s, #i.add(end, 1), #sconcat(sql, "?"), Cons(expr, binds))
        else sscSqlRewrite(s, #i.add(i, 1), #sconcat(sql, "$"), binds)
      else sscSqlRewrite(s, #i.add(i, 1), #sconcat(sql, "$"), binds)
    else sscSqlRewrite(s, #i.add(i, 1),
      #sconcat(sql, #sslice(s, i, #i.add(i, 1))), binds)

def sscSqlBindArgs = (binds) =>
  match binds {
    case Nil => ""
    case Cons(expr, rest) =>
      match rest {
        case Nil => expr
        case _ => #sconcat(expr, #sconcat(", ", sscSqlBindArgs(rest)))
      }
  }
def sscSqlValName = (index) => #sconcat("_sqlBlock_", #i->str(index))
def sscSqlFenceSource = (lang, source, heading, index, firstInSection) =>
  let side = sscFenceAttr(lang, "side", "server") in
  if #seq(side, "client") then "__unsupported_client_sql_fence"
  else
    match sscSqlRewrite(source, 0, "", Nil) {
      case Pair(status, data) =>
        if #seq(status, "__bad__") then "__malformed_sql_bind"
        else match data {
          case Pair(sql, binds) =>
            let name = sscSqlValName(index) in
            let db = sscFenceAttr(lang, "db", "default") in
            let call = #sconcat("val ", #sconcat(name,
              #sconcat(" = Db.sql(", #sconcat(sscQuoteYamlString(db),
                #sconcat(", ", #sconcat(sscQuoteYamlString(sql),
                  #sconcat(", List(", #sconcat(sscSqlBindArgs(binds), "))")))))))) in
            if firstInSection then
              #sconcat(call, #sconcat("\nval ", #sconcat(heading,
                #sconcat(" = sqlSection(", #sconcat(name, ")")))))
            else call
        }
    }

def sscFenceSource = (lang, source, heading, sqlIndex, firstSqlInSection) =>
  -- Dispatch on the info string's FIRST WORD, never on the whole string: `lang` still
  -- carries the attributes (`@db=`, `@side=`, `@id=`) that sscSqlFenceSource reads back
  -- out of it. Matching the whole string made EVERY attributed fence fall through to
  -- the final "" and be dropped, code and all -- see BUGS.md
  -- v2-native-front-drops-attributed-code-fence.
  let token = sscFenceToken(lang) in
  let isCode = if #seq(token, "scalascript") then true else #seq(token, "scala") in
  -- `@doc` marks a DOCUMENTATION block: parsed like any other, never lowered into the
  -- program (specs/ssc-doc-blocks.md). Checked before `isCode` so it wins for every tag.
  if fenceHasFlag(lang, "doc") then ""
  -- Per-block auto-output (BUGS.md v2-native-multiblock-auto-output-missing): the block
  -- boundary dies in the join below, so mark it while it still exists. F consumes the
  -- sentinel in walkTop and wraps the statement in front of it in the __autoOutput__ PRIM.
  -- A prim, not a .ssc helper: the Unit test is not expressible portably in source.
  else if isCode then #sconcat(source, "\n__sscBlockEnd__")
  else if #seq(token, "yaml") then
    #sconcat("val __yaml_", #sconcat(heading,
      #sconcat(" = __yamlSection__(", #sconcat(sscQuoteYamlString(source), ")"))))
  else if #seq(token, "yml") then
    #sconcat("val __yaml_", #sconcat(heading,
      #sconcat(" = __yamlSection__(", #sconcat(sscQuoteYamlString(source), ")"))))
  else if #seq(token, "sql") then
    sscSqlFenceSource(lang, source, heading, sqlIndex, firstSqlInSection)
  else ""
def sscSourceLines = (lines, heading, inFence, lang, curLines, sqlIndex, sqlSections, acc) =>
  match lines {
    case Nil =>
      if inFence then
        let token = sscFenceToken(lang) in
        let isSql = #seq(token, "sql") in
        let first = if isSql then (if #seq(heading, "S0") then false else (if sscMem(sqlSections, heading) then false else true)) else false in
        sscAppendSource(acc, sscFenceSource(lang, joinLines(reverse(curLines)), heading, sqlIndex, first))
      else acc
    case Cons(line, rest) =>
      if inFence then
        if isClosingFence(line) then
          let source = joinLines(reverse(curLines)) in
          let token = sscFenceToken(lang) in
          let isSql = #seq(token, "sql") in
          let first = if isSql then (if #seq(heading, "S0") then false else (if sscMem(sqlSections, heading) then false else true)) else false in
          sscSourceLines(rest, heading, false, "", Nil,
            if isSql then #i.add(sqlIndex, 1) else sqlIndex,
            if first then Cons(heading, sqlSections) else sqlSections,
            sscAppendSource(acc, sscFenceSource(lang, source, heading, sqlIndex, first)))
        else sscSourceLines(rest, heading, true, lang, Cons(line, curLines), sqlIndex, sqlSections, acc)
      else
        let t = strip(line) in
        if startsWith3bt(t) then
          sscSourceLines(rest, heading, true, getFenceLang(t), Nil, sqlIndex, sqlSections, acc)
        else
          let nextHeading = sscHeadingId(t) in
          sscSourceLines(rest,
            if #i.eq(#slen(nextHeading), 0) then heading else nextHeading,
            false, "", Nil, sqlIndex, sqlSections, acc)
  }
-- Whether any body line opens a ``` fence (distinguishes a literate .ssc from a
-- fenceless BARE .ssc). Fences are OPTIONAL: a bare .ssc is code in its entirety.
def sscHasFence = (lines) =>
  match lines {
    case Nil => false
    case Cons(line, rest) => if startsWith3bt(strip(line)) then true else sscHasFence(rest)
  }
def sscProgramSource = (src) =>
  let lines = splitLines(stripBom(src), 0, Nil) in
  let body = skipYaml(frontmatterLines(lines)) in
  if sscHasFence(body) then
    sscSourceLines(body, "S0", false, "", Nil, 0, Nil, "")
  else
    -- Fenceless bare .ssc: the whole body (after front-matter) is ScalaScript code.
    joinLines(body)

-- ── .ssc module loading (v2-native-front-ssc-module-loading) ─────────────────
-- The parser treats `[names](path.ssc)` markdown-link imports as a parse-only
-- no-op ("sealed"), assuming imported names are plugin globals. That holds for
-- plugin natives but NOT for ssc-DEFINED std helpers (jObj / lower /
-- staticDataTable in std/*.ssc), which stay unbound. Resolve them here: DFS +
-- load-once, extract each target .ssc's fences the same way, keep its DEFS
-- (dropping the module's own entry/prose), and prepend them to the program.

def sscApp = (xs, ys) => match xs { case Nil => ys case Cons(h, t) => Cons(h, sscApp(t, ys)) }
def sscMem = (xs, x) => match xs { case Nil => false case Cons(h, t) => if #seq(h, x) then true else sscMem(t, x) }
def sscLastSlash = (s, i, best) =>
  if #i.ge(i, #slen(s)) then best
  else (if #i.eq(#scodeAt(s, i), 47) then sscLastSlash(s, #i.add(i, 1), i) else sscLastSlash(s, #i.add(i, 1), best))
def sscDir = (path) =>
  let j = sscLastSlash(path, 0, #i.sub(0, 1)) in
  if #i.lt(j, 0) then "" else #sslice(path, 0, #i.add(j, 1))

-- keep only def/val/var statements (a module is imported for its definitions;
-- its top-level entry expressions are dropped)
-- a module is imported for its DECLARATIONS (def/val/var + case class ctors,
-- given instances, objects) — its top-level entry EXPRESSIONS are dropped.
-- Keeping casecls/given/object matters: e.g. std/dsl/pretty.ssc's `case class
-- DocLine` ctor was lost, so importers hit `unbound global: DocLine`.
def sscIsDecl = (tag) =>
  if #seq(tag, "def") then true
  else if #seq(tag, "extension_start") then true
  else if #seq(tag, "extension_end") then true
  else if #seq(tag, "val") then true
  else if #seq(tag, "var") then true
  else if #seq(tag, "casecls") then true
  else if #seq(tag, "caseobj") then true
  else if #seq(tag, "enum") then true
  else if #seq(tag, "given") then true
  else if #seq(tag, "given_obj") then true
  else if #seq(tag, "object") then true
  else if #seq(tag, "effect_decl") then true
  else false
def sscDefsOnly = (stmts) =>
  match stmts {
    case Nil => Nil
    case Cons(h, t) =>
      match h {
        case Pair(tag, d) => if sscIsDecl(tag) then Cons(h, sscDefsOnly(t)) else sscDefsOnly(t)
      }
  }

-- Markdown import scan. Only a standalone link line outside fenced code is an
-- import; prose/inline-code examples such as `` `[Button](./button.ssc)` `` are
-- documentation and MUST NOT enter the module graph.
def sscFindChar = (s, i, c) =>
  if #i.ge(i, #slen(s)) then i
  else (if #i.eq(#scodeAt(s, i), c) then i else sscFindChar(s, #i.add(i, 1), c))
def sscEndsSsc = (s) =>
  let n = #slen(s) in
  if #i.lt(n, 4) then false else #seq(#sslice(s, #i.sub(n, 4), n), ".ssc")
-- A directory import target: a relative (`./`, `../`) or `std/` path whose LAST
-- segment carries no extension (no `.`), e.g. `./import-dir`, `../examples/std-ui`.
-- Loaded as `<dir>/index.ssc`. The last-segment `.` test excludes prose links like
-- `./logo.png "Brand"` (has `.png` + a title), which must NOT be treated as imports.
def sscSegHasDot = (s) => #i.lt(sscFindChar(s, 0, 46), #slen(s))
def sscLastSeg = (segs) =>
  match segs {
    case Nil => ""
    case Cons(h, t) => match t { case Nil => h case _ => sscLastSeg(t) }
  }
def sscDirImportPath = (p) =>
  let rel = if #i.eq(#slen(p), 0) then false
            else if #i.eq(#scodeAt(p, 0), 46) then true
            else sscStartsStd(p) in
  if rel then (if sscSegHasDot(sscLastSeg(#str.split(p, "/"))) then false else true)
  else false
def sscSkipImportSpace = (s, i) =>
  if #i.ge(i, #slen(s)) then i
  else
    let c = #scodeAt(s, i) in
    if #i.eq(c, 32) then sscSkipImportSpace(s, #i.add(i, 1))
    else if #i.eq(c, 9) then sscSkipImportSpace(s, #i.add(i, 1))
    else i
def sscImportLinksFrom = (t, i, acc) =>
  let start = sscSkipImportSpace(t, i) in
  if #i.ge(start, #slen(t)) then reverse(acc)
  else if #i.eq(#scodeAt(t, start), 91) then
    let labelEnd = sscFindChar(t, #i.add(start, 1), 93) in
    if #i.ge(labelEnd, #slen(t)) then Nil
    else if #i.ge(#i.add(labelEnd, 1), #slen(t)) then Nil
    else if #i.eq(#scodeAt(t, #i.add(labelEnd, 1)), 40) then
      let close = sscFindChar(t, #i.add(labelEnd, 2), 41) in
      if #i.ge(close, #slen(t)) then Nil
      else
        let p = #sslice(t, #i.add(labelEnd, 2), close) in
        -- The LABEL travels with the path from here on. It used to be read only to find
        -- this closing bracket and then dropped, which is why no `[x as y]` ever bound
        -- anything on this lane (v2/BUGS.md native-import-link-alias-is-ignored).
        let lab = #sslice(t, #i.add(start, 1), labelEnd) in
        if sscEndsSsc(p) then
          sscImportLinksFrom(t, #i.add(close, 1), Cons(Pair(lab, p), acc))
        else if sscDirImportPath(p) then
          sscImportLinksFrom(t, #i.add(close, 1), Cons(Pair(lab, p), acc))
        else Nil
    else Nil
  else Nil
def sscImportLinksOn = (line) =>
  let t = strip(line) in
  if #i.lt(#slen(t), 8) then Nil else sscImportLinksFrom(t, 0, Nil)
def sscPushLinks = (links, acc) =>
  match links {
    case Nil => acc
    case Cons(lp, rest) => sscPushLinks(rest, Cons(lp, acc))
  }
def sscStartsChar = (s, c) =>
  if #i.eq(#slen(s), 0) then false else #i.eq(#scodeAt(s, 0), c)
def sscWrappedImportStart = (t) =>
  if sscStartsChar(t, 91) then #i.ge(sscFindChar(t, 1, 93), #slen(t))
  else false
def sscPendingBreak = (t) =>
  if #i.eq(#slen(t), 0) then true
  else if sscStartsChar(t, 35) then true
  else startsWith3bt(t)
def sscPendingJoin = (pending, t) =>
  if #i.eq(#slen(pending), 0) then t else #sconcat(pending, #sconcat(" ", t))
-- Scan mode for the fence a ``` line opens. A `[names](path.ssc)` link is an import
-- wherever it stands, so a scalascript/scala fence stays TRANSPARENT to the scan (1);
-- every other fence -- sql/yaml/bash/text and any `@doc` block -- stays OPAQUE (2).
-- The predicate is deliberately the SAME one `sscFenceSource` uses to decide what is
-- program text, so the scanner and the source collector cannot disagree about which
-- fences are code (BUGS.md v2-native-front-in-fence-imports-not-followed).
def sscFenceScanMode = (t) =>
  let lang = getFenceLang(t) in
  let token = fenceLangTok(lang) in
  let isCode = if #seq(token, "scalascript") then true else #seq(token, "scala") in
  if fenceHasFlag(lang, "doc") then 2
  else if isCode then 1
  else 2
-- mode: 0 = prose, 1 = inside a CODE fence (scanned exactly like prose), 2 = opaque fence.
def sscScanLines = (lines, mode, pending, acc) =>
  match lines {
    case Nil => acc
    case Cons(line, rest) =>
      if #i.eq(mode, 2) then
        if isClosingFence(line) then sscScanLines(rest, 0, "", acc)
        else sscScanLines(rest, 2, "", acc)
      else
        let t = strip(line) in
        -- Inside a code fence only a BARE ``` closes it -- the same boundary rule
        -- sscSourceLines applies, so both walks agree on where the fence ends.
        let atFence = if #i.eq(mode, 1) then isClosingFence(line) else startsWith3bt(t) in
        let next = if #i.eq(mode, 1) then 0 else sscFenceScanMode(t) in
        if atFence then sscScanLines(rest, next, "", acc)
        else if #i.gt(#slen(pending), 0) then
          if sscPendingBreak(t) then
            if sscStartsChar(t, 91) then sscScanLines(Cons(line, rest), mode, "", acc)
            else sscScanLines(rest, mode, "", acc)
          else
            let joined = sscPendingJoin(pending, t) in
            let close = sscFindChar(joined, 1, 93) in
            if #i.lt(close, #slen(joined)) then
              let links = sscImportLinksOn(joined) in
              sscScanLines(rest, mode, "", sscPushLinks(links, acc))
            else sscScanLines(rest, mode, joined, acc)
        else
          let links = sscImportLinksOn(t) in
          match links {
            case Nil =>
              if sscWrappedImportStart(t) then sscScanLines(rest, mode, t, acc)
              else sscScanLines(rest, mode, "", acc)
            case _ => sscScanLines(rest, mode, "", sscPushLinks(links, acc))
          }
  }
-- The link view: `[Pair(label, path)]` in source order. `sscImports` is the PATH
-- projection of it, unchanged in shape, so every existing consumer -- the loaders,
-- sscOrderMod, sscResolveImports, the content projection -- sees what it always saw.
def sscImportLinks = (src) => reverse(sscScanLines(splitLines(src, 0, Nil), 0, "", Nil))
def sscImports = (src) => sscMapSnd(sscImportLinks(src))

-- resolve an import target: `std/…` maps to the std root (SSC_STD env, else the
-- in-tree v1/runtime); everything else is relative to the importing file.
def sscStartsStd = (rel) =>
  if #i.lt(#slen(rel), 4) then false else #seq(#sslice(rel, 0, 4), "std/")
def sscStdRootCell = #cell.new("")
def sscSlash = (s) =>
  if #i.eq(#slen(s), 0) then ""
  else (if #i.eq(#scodeAt(s, #i.sub(#slen(s), 1)), 47) then s else #sconcat(s, "/"))
def sscStdRoot = () =>
  let staged = #cell.get(sscStdRootCell) in
  if #seq(staged, "") then
    match #io.env("SSC_STD") {
      case Some(e) => if #seq(e, "") then "v1/runtime/" else sscSlash(e)
      case None    => "v1/runtime/"
    }
  else sscSlash(staged)

-- Lib root for BARE import paths (no `./`, `../`, or `std/` prefix): the
-- install root (ssc.lib.path), which for a dev checkout is the repo root. A
-- case can then import a module by its repo-root-relative path. Unset → "" so
-- the bare path resolves against the process cwd, matching prior behaviour.
def sscLibRootCell = #cell.new("")
def sscLibRoot = () =>
  let staged = #cell.get(sscLibRootCell) in
  if #seq(staged, "") then "" else sscSlash(staged)

-- Lexical path normalization keeps DFS/load-once stable for `./` and `../`
-- spellings without adding a platform filesystem primitive to the frozen kernel.
def sscNormSegs = (segs, acc, absolute) =>
  match segs {
    case Nil => acc
    case Cons(seg, rest) =>
      if #seq(seg, "") then sscNormSegs(rest, acc, absolute)
      else (if #seq(seg, ".") then sscNormSegs(rest, acc, absolute)
      else (if #seq(seg, "..") then
        match acc {
          case Nil => if absolute then sscNormSegs(rest, Nil, absolute)
                      else sscNormSegs(rest, Cons("..", Nil), absolute)
          case Cons(h, t) => if #seq(h, "..") then sscNormSegs(rest, Cons("..", acc), absolute)
                             else sscNormSegs(rest, t, absolute)
        }
      else sscNormSegs(rest, Cons(seg, acc), absolute)))
  }
def sscJoinSegs = (segs) =>
  match segs {
    case Nil => ""
    case Cons(h, rest) =>
      match rest { case Nil => h case _ => #sconcat(h, #sconcat("/", sscJoinSegs(rest))) }
  }
def sscNormalize = (path) =>
  let absolute = if #i.eq(#slen(path), 0) then false else #i.eq(#scodeAt(path, 0), 47) in
  let body = sscJoinSegs(reverse(sscNormSegs(#str.split(path, "/"), Nil, absolute))) in
  if absolute then #sconcat("/", body) else body
-- std/… → std root;  ./… or ../… (leading '.') → relative to the importing
-- file.  A BARE path is ambiguous — it may be a sibling of the importer (e.g.
-- std/http.ssc → `json.ssc`) OR a repo-root-relative path (a case importing
-- `tests/conformance/lib/foo.ssc`). Match v1's ImportResolver: try the importer
-- directory first, and only fall back to the lib root (repo root) when that
-- file does not exist.
def sscResolve = (dir, rel) =>
  if sscStartsStd(rel) then sscNormalize(#sconcat(sscStdRoot(), rel))
  else if sscStartsChar(rel, 46) then sscNormalize(#sconcat(dir, rel))
  else
    let srcRel = sscNormalize(#sconcat(dir, rel)) in
    if #io.exists(srcRel) then srcRel
    else sscNormalize(#sconcat(sscLibRoot(), rel))

-- ── `package:` binds a namespace (specs/native-package-namespace.md) ────────
-- A module whose front matter says `package: a.b.c` must ALSO be reachable as
-- `a.b.c.<name>`, the way v1 does it (Parser.wrapSectionInPackage +
-- SectionRuntime.packageMembers). This ADDS names; the flat splice below is
-- untouched, so unqualified `ui("x")` keeps working.
--
-- The shape is not the obvious one, and each part of it was measured:
--  * `object O: def f` lowers to the GLOBAL `O_f` (ssc1-lower `prefixDefs`), and a
--    dotted selection joins segments with `_` and requires EVERY prefix to be a
--    registered object -- `object org_example` alone gives `unbound global: org`.
--  * An `object` nested inside an object body is DROPPED by `prefixDefs`. So the
--    namespace is a CHAIN of flat objects (`a`, `a_b`, `a_b_c`), not nested ones.
--  * Each member aliases through a top-level `__pkgref_…` instead of naming its
--    source directly, because `object ns: def ui = ui` aliases under F but is
--    `unbound global: ns_ui` under the reference front -- and its parameterful
--    form `def ui(s) = ui(s)` HANGS there. An alias whose right-hand side is not
--    a member of the enclosing object is the one form both fronts agree on.
def sscHasPrefix = (s, p) =>
  if #i.lt(#slen(s), #slen(p)) then false else #seq(#sslice(s, 0, #slen(p)), p)
def sscUnquote = (s) =>
  let n = #slen(s) in
  if #i.lt(n, 2) then s
  else
    let a = #scodeAt(s, 0) in
    if #i.eq(a, #scodeAt(s, #i.sub(n, 1))) then
      (if #i.eq(a, 34) then #sslice(s, 1, #i.sub(n, 1))
       else if #i.eq(a, 39) then #sslice(s, 1, #i.sub(n, 1))
       else s)
    else s
def sscPkgFromLines = (ls) =>
  match ls {
    case Nil => ""
    case Cons(l, rest) =>
      let t = strip(l) in
      if sscHasPrefix(t, "package:") then sscUnquote(strip(#sslice(t, 8, #slen(t))))
      else sscPkgFromLines(rest)
  }
-- The module's declared package, "" when it declares none. Read from the RAW file:
-- `sscProgramSource` has already stripped the front matter out of `modSrc`.
def sscPkgName = (fileStr) =>
  match extractFrontmatter(fileStr) {
    case FrontmatterNone => ""
    case FrontmatterText(yaml) => sscPkgFromLines(splitLines(yaml, 0, Nil))
    case FrontmatterErr(message, line, column) => ""
  }
-- "a.b.c" -> ["a", "a_b", "a_b_c"]: the object name of every PREFIX, because a
-- missing intermediate is what makes the whole selection unbound.
def sscPkgPrefixes = (pkg, i, cur, acc) =>
  if #i.ge(i, #slen(pkg)) then
    (if #i.eq(#slen(cur), 0) then reverse(acc) else reverse(Cons(cur, acc)))
  else
    let c = #scodeAt(pkg, i) in
    if #i.eq(c, 46) then
      (if #i.eq(#slen(cur), 0) then sscPkgPrefixes(pkg, #i.add(i, 1), cur, acc)
       else sscPkgPrefixes(pkg, #i.add(i, 1), #sconcat(cur, "_"), Cons(cur, acc)))
    else sscPkgPrefixes(pkg, #i.add(i, 1),
                        #sconcat(cur, #sslice(pkg, i, #i.add(i, 1))), acc)
def sscPkgLeaf = (prefixes) =>
  match prefixes {
    case Nil => ""
    case Cons(p, rest) => match rest { case Nil => p case _ => sscPkgLeaf(rest) }
  }
-- A name that can appear on the left of `def <n> =` in generated source. Anything
-- else is SKIPPED rather than emitted: `std/parsing/combinators.ssc` declares
-- `def ~`, `def |`, `def ~>` and `def <~`, and emitting `def __pkgref_…__~ = ~`
-- made the whole program `_err` -- a parse failure in generated code, reported
-- against the user's file.
def sscIsAlphaU = (c) =>
  if #i.eq(c, 95) then true
  else if #i.ge(c, 65) then
    (if #i.le(c, 90) then true else (if #i.ge(c, 97) then #i.le(c, 122) else false))
  else false
def sscIsIdentTail = (c) =>
  if sscIsAlphaU(c) then true else (if #i.ge(c, 48) then #i.le(c, 57) else false)
def sscPkgIdentOk = (s) =>
  if #i.eq(#slen(s), 0) then false
  else if sscIsAlphaU(#scodeAt(s, 0)) then
    let rec go = (i) =>
      if #i.ge(i, #slen(s)) then true
      else (if sscIsIdentTail(#scodeAt(s, i)) then go(#i.add(i, 1)) else false) in
    go(1)
  else false
-- Member names of a declaration list. Three exclusions, each for its own reason:
--  * `var` -- the alias is a parameterless property and therefore EAGER, so it would
--    publish a SNAPSHOT of the cell under a name that looks live.
--  * anything between `extension_start` and `extension_end` -- an extension method
--    is a method on its receiver, not a member of the module, and its name is
--    frequently an operator. The parsed list is FLAT, so the members of an
--    extension block arrive as ordinary `def` statements and would otherwise be
--    indistinguishable from top-level ones.
--  * any name that is not a plain identifier (see above).
def sscPkgMemberNames = (stmts, inExt) =>
  match stmts {
    case Nil => Nil
    case Cons(s, rest) =>
      match s {
        case Pair(stag, sdata) =>
          if #seq(stag, "extension_start") then sscPkgMemberNames(rest, true)
          else if #seq(stag, "extension_end") then sscPkgMemberNames(rest, false)
          else if inExt then sscPkgMemberNames(rest, inExt)
          else
            let keep = if #seq(stag, "def") then true else #seq(stag, "val") in
            if keep then
              (match sdata {
                case Pair(n, sr) =>
                  if sscPkgIdentOk(n) then Cons(n, sscPkgMemberNames(rest, inExt))
                  else sscPkgMemberNames(rest, inExt)
              })
            else sscPkgMemberNames(rest, inExt)
      }
  }
-- Every prefix must be a usable object name, or nothing is emitted at all: a
-- malformed `package:` value must not turn into generated source that fails to
-- parse, because the diagnostic would name the USER's file.
def sscPkgPrefixesOk = (ps) =>
  match ps {
    case Nil => false
    case Cons(p, rest) =>
      if sscPkgIdentOk(p) then
        (match rest { case Nil => true case _ => sscPkgPrefixesOk(rest) })
      else false
  }
def sscPkgRefName = (leaf, n) =>
  #sconcat("__pkgref_", #sconcat(leaf, #sconcat("__", n)))
def sscPkgRefLines = (leaf, names) =>
  match names {
    case Nil => ""
    case Cons(n, rest) =>
      #sconcat("def ", #sconcat(sscPkgRefName(leaf, n),
        #sconcat(" = ", #sconcat(n, #sconcat("\n", sscPkgRefLines(leaf, rest))))))
  }
def sscPkgMemberLines = (leaf, names) =>
  match names {
    case Nil => ""
    case Cons(n, rest) =>
      #sconcat("  def ", #sconcat(n, #sconcat(" = ",
        #sconcat(sscPkgRefName(leaf, n),
          #sconcat("\n", sscPkgMemberLines(leaf, rest))))))
  }
-- `def m = Owner.m`: the right-hand side is a SELECTION, so it never collides with
-- the member being defined -- no indirection needed, and both fronts agree on it.
def sscPkgFwdLines = (owner, names) =>
  match names {
    case Nil => ""
    case Cons(n, rest) =>
      #sconcat("  def ", #sconcat(n, #sconcat(" = ",
        #sconcat(owner, #sconcat(".", #sconcat(n,
          #sconcat("\n", sscPkgFwdLines(owner, rest))))))))
  }
-- A registration object must be non-empty, hence `__pkg`. Teaching the front to
-- register an empty object is a front change for a cosmetic gain.
-- EACH STUB CARRIES ITS NEXT SEGMENT, and that member is the whole reason a dotted package name
-- resolves under F. The stubs used to be flat and empty --
--
--     object org:          def __pkg = 0
--     object org_example:  def __pkg = 0
--
-- so nothing connected `org` to `example`. The reference lowerer never cared: it collapses the whole
-- chain to the mangled global `org_example_ui_Card_render` out of its own object registry. F instead
-- asks `isObjMember(receiver, member)` against the registry the SOURCE declares, found no `example`
-- on `org`, and fell through to method dispatch:
--
--     ssc: __method__: no method 'example' in method-object
--
-- That is Validate's "package: keyword across four lanes" step, red since 2026-08-20, plus the
-- alias/root row of the same gate whose CONTROL is this same call.
--
-- Emitting `def example = org_example` into `object org` makes the member real, so F's own
-- isObjMember answers yes and the chain collapses one segment at a time. It costs the reference lane
-- nothing: that lane already resolved the chain without reading these members.
--
-- The tail is bound as `rest2`, NOT as `_`: this parser takes `_` only as a whole pattern, and a
-- wildcard nested inside a constructor makes the WHOLE RUNNER unparseable -- every program, even
-- `println("hi")`, dies with `ssc: expected identifier, got Underscore`.
def sscPkgLastSeg = (s) => sscPkgLastSegGo(s, #i.sub(#slen(s), 1))
def sscPkgLastSegGo = (s, i) => if #i.lt(i, 0) then s else sscPkgLastSegAt(s, i)
def sscPkgLastSegAt = (s, i) => if #i.eq(#scodeAt(s, i), 95) then #sslice(s, #i.add(i, 1), #slen(s)) else sscPkgLastSegGo(s, #i.sub(i, 1))
def sscPkgStub = (name) => #sconcat("object ", #sconcat(name, ":\n  def __pkg = 0\n"))
def sscPkgStubLinked = (name, nextPrefix) => #sconcat("object ", #sconcat(name, #sconcat(":\n  def __pkg = 0\n  def ", #sconcat(sscPkgLastSeg(nextPrefix), #sconcat(" = ", #sconcat(nextPrefix, "\n"))))))
def sscPkgStubs = (prefixes) =>
  match prefixes {
    case Nil => ""
    case Cons(p, rest) =>
      match rest {
        case Nil => ""
        case Cons(nxt, rest2) => #sconcat(sscPkgStubs(rest), sscPkgStubLinked(p, nxt))
      }
  }
-- A NESTED OBJECT IS A MEMBER OF ITS PACKAGE, and the leaf object never said so. `sscPkgMemberNames`
-- keeps `def` and `val` only, so `object Card` inside `package: org.example.ui` was emitted as the
-- top-level `org_example_ui_Card` and NOTHING named it from `org_example_ui`. The reference lane
-- mangles the whole selection to one global and never asks; F asks its object registry and got
--
--     ssc: __method__: no method 'Card' in method-object
--
-- one hop further along than the `example` failure the stubs above fix. Same shape, same remedy: a
-- real member, aliased by VALUE, emitted after the object it names.
def sscPkgObjNames = (stmts) =>
  match stmts {
    case Nil => Nil
    case Cons(s, rest) =>
      match s {
        case Pair(tag, data) =>
          if #seq(tag, "object") then
            (match data {
              case Pair(oname, ostmts) =>
                if sscPkgIdentOk(oname) then Cons(oname, sscPkgObjNames(rest)) else sscPkgObjNames(rest)
            })
          else sscPkgObjNames(rest)
      }
  }
def sscPkgObjMemberLines = (leaf, onames) =>
  match onames {
    case Nil => ""
    case Cons(n, rest) =>
      #sconcat("  def ", #sconcat(n, #sconcat(" = ", #sconcat(leaf, #sconcat("_", #sconcat(n,
        #sconcat("\n", sscPkgObjMemberLines(leaf, rest))))))))
  }
def sscPkgObjBlocks = (leaf, stmts) =>
  match stmts {
    case Nil => ""
    case Cons(s, rest) =>
      match s {
        case Pair(tag, data) =>
          if #seq(tag, "object") then
            (match data {
              case Pair(oname, ostmts) =>
                if sscPkgIdentOk(oname) then
                  #sconcat("object ", #sconcat(leaf, #sconcat("_", #sconcat(oname,
                    #sconcat(":\n  def __pkg = 0\n",
                      #sconcat(sscPkgFwdLines(oname, sscPkgMemberNames(ostmts, false)),
                        sscPkgObjBlocks(leaf, rest)))))))
                else sscPkgObjBlocks(leaf, rest)
            })
          else sscPkgObjBlocks(leaf, rest)
      }
  }
-- The whole namespace, as SOURCE. Built from the already-parsed declaration list
-- rather than re-scanned from the text, so it cannot disagree about what was
-- actually spliced -- and it needs no parameter lists, the alias being by VALUE.
def sscPkgNsSource = (pkg, defs) =>
  if #seq(pkg, "") then ""
  else
    let prefixes = sscPkgPrefixes(pkg, 0, "", Nil) in
    if sscPkgPrefixesOk(prefixes) then
      (let leaf = sscPkgLeaf(prefixes) in
       let names = sscPkgMemberNames(defs, false) in
       -- ORDER IS LOAD-BEARING: a stub names the object one segment deeper as a VALUE, and a
       -- global is not in scope before its declaration -- emitting the stubs first cost
       -- `ssc: unbound global: std_yaml` on EVERY program, the tower's own `package: std.yaml`
       -- module included. So the leaf object goes out first and the stubs follow it deepest-first,
       -- each one emitted after the object it names.
       #sconcat(sscPkgRefLines(leaf, names),
         #sconcat(sscPkgObjBlocks(leaf, defs),
           #sconcat("object ", #sconcat(leaf, #sconcat(":\n  def __pkg = 0\n",
             #sconcat(sscPkgMemberLines(leaf, names),
               #sconcat(sscPkgObjMemberLines(leaf, sscPkgObjNames(defs)), sscPkgStubs(prefixes)))))))))
    else ""

-- ── `as` in an import link (v2/BUGS.md native-import-link-alias-is-ignored) ──
-- `[greet as g](./plain.ssc)` must bind `g`, and on this lane it bound nothing: the
-- scanner above read the label `[...]` only to find its closing bracket and threw the
-- text away. Every other lane threads the bindings (v1 `imp.bindings` with
-- `binding.alias`; JvmGen builds its import list from them).
--
-- ONE scanner, two views. `sscScanLines` collects `Pair(label, path)` and `sscImports`
-- projects the paths back out, so the module graph, `sscOrderMod`, the content
-- projection and the F runner all see exactly what they saw before. A SECOND scanner
-- would have had to repeat the fence-mode and wrapped-link handling, and a copy of that
-- is how a link inside an opaque ```text fence becomes an import.
def sscSndOf = (p) => match p { case Pair(a, b) => b }
def sscMapSnd = (xs) =>
  match xs { case Nil => Nil case Cons(h, t) => Cons(sscSndOf(h), sscMapSnd(t)) }

-- `x as y` -> Pair(x, y); a bare `x` -> Pair(x, x). Matched as the WORD `as` with a
-- space on each side, so a name that merely contains the letters (`aspect`, `class`)
-- is untouched.
def sscAsAt = (s, i) =>
  if #i.gt(#i.add(i, 4), #slen(s)) then #slen(s)
  else if #seq(#sslice(s, i, #i.add(i, 4)), " as ") then i
  else sscAsAt(s, #i.add(i, 1))
def sscBindingOf = (item) =>
  let t = strip(item) in
  let j = sscAsAt(t, 0) in
  if #i.ge(j, #slen(t)) then Pair(t, t)
  else Pair(strip(#sslice(t, 0, j)), strip(#sslice(t, #i.add(j, 4), #slen(t))))
def sscSplitCommas = (s, i, cur, acc) =>
  if #i.ge(i, #slen(s)) then reverse(Cons(cur, acc))
  else
    let c = #scodeAt(s, i) in
    if #i.eq(c, 44) then sscSplitCommas(s, #i.add(i, 1), "", Cons(cur, acc))
    else sscSplitCommas(s, #i.add(i, 1), #sconcat(cur, #sslice(s, i, #i.add(i, 1))), acc)
-- Only the RENAMING bindings: a bare `[greet]` already resolves through the flat splice,
-- and both sides must be plain identifiers or the emitted source would not parse — the
-- same guard the package namespace needs, for the same reason.
def sscAliasesOfLabel = (label) =>
  let rec go = (items) =>
    match items {
      case Nil => Nil
      case Cons(item, rest) =>
        match sscBindingOf(item) {
          case Pair(orig, alias) =>
            if #seq(orig, alias) then go(rest)
            else if sscPkgIdentOk(orig) then
              (if sscPkgIdentOk(alias) then Cons(Pair(orig, alias), go(rest)) else go(rest))
            else go(rest)
        }
    } in
  go(sscSplitCommas(label, 0, "", Nil))

def sscFirstSeg = (pkg) => #sslice(pkg, 0, sscFindChar(pkg, 0, 46))
def sscReplaceFirstSeg = (pkg, seg) =>
  let j = sscFindChar(pkg, 0, 46) in
  if #i.ge(j, #slen(pkg)) then seg else #sconcat(seg, #sslice(pkg, j, #slen(pkg)))

-- Alias source for ONE link. The two sub-cases are not the same emission:
--  * a MEMBER alias is a value alias -- the flat splice already defined `greet`.
--  * the package ROOT is not. `org` is a synthetic namespace object and objects are NOT
--    first-class values on this lane (`val Card = Card` answers `unbound global: Card`),
--    so that row needs a second namespace CHAIN rooted at the alias, whose members
--    forward to the very same `__pkgref_…` top-level refs the real chain uses. That is
--    `sscPkgNsSource` again with the first segment replaced -- one definition, now three
--    names, still no copy.
-- Is `name` a top-level `object` of this module, and what does it hold? An object
-- cannot be aliased by value -- `def C = Card` binds something whose `.render` answers
-- `unhandled runtime effect: C.render` -- so it needs an object of its own that
-- forwards, exactly like a package namespace member.
def sscIsObjectNamed = (defs, name) =>
  match defs {
    case Nil => false
    case Cons(s, rest) =>
      match s {
        case Pair(tag, data) =>
          if #seq(tag, "object") then
            (match data {
              case Pair(oname, ostmts) =>
                if #seq(oname, name) then true else sscIsObjectNamed(rest, name)
            })
          else sscIsObjectNamed(rest, name)
      }
  }
def sscObjMembersNamed = (defs, name) =>
  match defs {
    case Nil => Nil
    case Cons(s, rest) =>
      match s {
        case Pair(tag, data) =>
          if #seq(tag, "object") then
            (match data {
              case Pair(oname, ostmts) =>
                if #seq(oname, name) then sscPkgMemberNames(ostmts, false)
                else sscObjMembersNamed(rest, name)
            })
          else sscObjMembersNamed(rest, name)
      }
  }
def sscAliasSrcFor = (dir, rel, label) =>
  let target = sscResolve(dir, rel) in
  let path = if sscEndsSsc(target) then target else #sconcat(target, "/index.ssc") in
  let modStr = #utf8->str(#io.readFile(path)) in
  let modDefs = sscDefsOnly(parse(sscProgramSource(modStr))) in
  let pkg = sscPkgName(modStr) in
  let root = if #seq(pkg, "") then "" else sscFirstSeg(pkg) in
  let rec go = (bs) =>
    match bs {
      case Nil => ""
      case Cons(b, rest) =>
        match b {
          case Pair(orig, alias) =>
            let one =
              if #seq(orig, root) then
                sscPkgNsSource(sscReplaceFirstSeg(pkg, alias), modDefs)
              else if sscIsObjectNamed(modDefs, orig) then
                #sconcat("object ", #sconcat(alias, #sconcat(":\n  def __pkg = 0\n",
                  sscPkgFwdLines(orig, sscObjMembersNamed(modDefs, orig)))))
              else #sconcat("def ", #sconcat(alias, #sconcat(" = ", #sconcat(orig, "\n")))) in
            #sconcat(one, go(rest))
        }
    } in
  go(sscAliasesOfLabel(label))

-- Every aliased link in a file, as one source string. Files with no `as` anywhere pay
-- one label scan and read no extra files.
def sscAliasSource = (fileStr, dir) =>
  let rec go = (links) =>
    match links {
      case Nil => ""
      case Cons(lp, rest) =>
        match lp {
          case Pair(label, rel) =>
            match sscAliasesOfLabel(label) {
              case Nil => go(rest)
              case _   => #sconcat(sscAliasSrcFor(dir, rel, label), go(rest))
            }
        }
    } in
  go(sscImportLinks(fileStr))
def sscAliasDefs = (fileStr, dir) =>
  let src = sscAliasSource(fileStr, dir) in
  if #i.eq(#slen(src), 0) then Nil else sscDefsOnly(parse(src))

def sscLoadMod = (rawPath, seen) =>
  let path0 = sscNormalize(rawPath) in
  -- Directory import: `[names](./dir)` with no `.ssc` extension loads `dir/index.ssc`
  -- (the directory's entry module), matching the bridge's package-import convention.
  let path = if sscEndsSsc(path0) then path0 else #sconcat(path0, "/index.ssc") in
  if sscMem(seen, path) then Pair(Nil, seen)
  else
    let fileStr = #utf8->str(#io.readFile(path)) in
    let modSrc = sscProgramSource(fileStr) in
    let defs = sscDefsOnly(parse(modSrc)) in
    -- `package: a.b.c` in the front matter ALSO publishes the module under that
    -- name. Appended AFTER `defs`, never before: each alias is a parameterless
    -- property and therefore EAGER, so its right-hand side must already exist.
    let nsSrc = sscPkgNsSource(sscPkgName(fileStr), defs) in
    let nsDefs = if #i.eq(#slen(nsSrc), 0) then Nil else sscDefsOnly(parse(nsSrc)) in
    -- `[x as y]` aliases sit BETWEEN the imports and this module's own defs: their
    -- right-hand sides come from the imports, and this module's code may use them.
    let alDefs = sscAliasDefs(fileStr, sscDir(path)) in
    match sscLoadImps(sscImports(fileStr), sscDir(path), Cons(path, seen)) {
      case Pair(impDefs, seen2) =>
        Pair(sscApp(impDefs, sscApp(alDefs, sscApp(defs, nsDefs))), seen2)
    }
def sscLoadImps = (imps, dir, seen) =>
  match imps {
    case Nil => Pair(Nil, seen)
    case Cons(rel, rest) =>
      match sscLoadMod(sscResolve(dir, rel), seen) {
        case Pair(d1, seen2) => match sscLoadImps(rest, dir, seen2) { case Pair(d2, seen3) => Pair(sscApp(d1, d2), seen3) }
      }
  }

-- Explicit command-line roots keep their entry expressions; imported modules
-- contribute definitions only. The seen set is shared across all roots.
def sscLoadRoot = (rawPath, seen) =>
  let path = sscNormalize(rawPath) in
  let bytes = #io.readFile(path) in
  let fileStr = #utf8->str(bytes) in
  let src = sscProgramSource(fileStr) in
  -- A DOC-ONLY .ssc is a legitimate no-op, not an error (`feedback_ssc_fences_by_design`:
  -- "doc-only = no-op + stderr note"); v1 exits 0 on examples/deploy.ssc, which has ZERO
  -- `scalascript` fences. Keep the stderr note, then take the SAME path as a normal file: an empty
  -- source parses to an empty statement list and the file's CONTENT module is still produced —
  -- which the structural ABI requires, since it checks content root identities against the source
  -- roots. Short-circuiting to an empty program instead only trades `exit 1` for an ABI error.
  if #i.eq(slen(src), 0) then
    let z = #io.eprint(#sconcat("ssc1-run: no scalascript blocks found: ", #sconcat(path, "\n"))) in
    let stmts = parse(src) in
    match sscLoadImps(sscImports(fileStr), sscDir(path), Cons(path, seen)) {
      case Pair(impDefs, seen2) => Pair(sscApp(impDefs, stmts), seen2)
    }
  else
    let stmts = parse(src) in
    -- A root keeps its top-level EXPRESSIONS, so the aliases have to be defined before
    -- them, not after: a value alias is a parameterless property and therefore eager.
    let alDefs = sscAliasDefs(fileStr, sscDir(path)) in
    match sscLoadImps(sscImports(fileStr), sscDir(path), Cons(path, seen)) {
      case Pair(impDefs, seen2) => Pair(sscApp(impDefs, sscApp(alDefs, stmts)), seen2)
    }
def sscLoadRoots = (paths, seen) =>
  match paths {
    case Nil => Pair(Nil, seen)
    case Cons(path, rest) =>
      match sscLoadRoot(path, seen) {
        case Pair(stmts, seen2) =>
          match sscLoadRoots(rest, seen2) {
            case Pair(more, seen3) => Pair(sscApp(stmts, more), seen3)
          }
      }
  }

-- Post-order path traversal for F's multi-file source closure. Mirrors the
-- sscLoad* loaders' `sscApp` accumulation EXACTLY but yields the ordered SOURCE
-- PATHS (deduped, first occurrence wins its slot) instead of parsed defs — so
-- `sscConcatSources` re-lowers the closure in the same order the legacy front's
-- `lowerProg(allStmts)` does: a module's imports (left-to-right) before the
-- module itself, and positional roots left-to-right. The flat `seen` list is
-- reverse-pre-order, which reverses SIBLINGS (multiple positional roots, or
-- multiple sibling imports) — that is the `A.ssc B.ssc` runs-B-then-A bug.
-- The shared loaders cannot be augmented to also return this list (the
-- front-matter / markdown / content projectors read their def slot), hence a
-- dedicated traversal. `seen` threading is identical to sscLoad*, so the
-- `reverse(seen)` the structural content projection consumes is unchanged.
def sscOrderMod = (rawPath, seen) =>
  let path0 = sscNormalize(rawPath) in
  let path = if sscEndsSsc(path0) then path0 else #sconcat(path0, "/index.ssc") in
  if sscMem(seen, path) then Pair(Nil, seen)
  else
    let fileStr = #utf8->str(#io.readFile(path)) in
    match sscOrderImps(sscImports(fileStr), sscDir(path), Cons(path, seen)) {
      case Pair(impPaths, seen2) => Pair(sscApp(impPaths, Cons(path, Nil)), seen2)
    }
def sscOrderImps = (imps, dir, seen) =>
  match imps {
    case Nil => Pair(Nil, seen)
    case Cons(rel, rest) =>
      match sscOrderMod(sscResolve(dir, rel), seen) {
        case Pair(p1, seen2) => match sscOrderImps(rest, dir, seen2) { case Pair(p2, seen3) => Pair(sscApp(p1, p2), seen3) }
      }
  }
def sscOrderRoot = (rawPath, seen) =>
  let path = sscNormalize(rawPath) in
  let fileStr = #utf8->str(#io.readFile(path)) in
  let src = sscProgramSource(fileStr) in
  -- A ROOT with no `scalascript` fences is a DOCUMENTATION module, not an error. This exited 1,
  -- and `sscLoadMod` a few lines up — identical in this runner and in the reference's — does the
  -- opposite and says why: "Short-circuiting to an empty program instead only trades `exit 1` for
  -- an ABI error." The reference front has no ordering pass at all (F needs one because it
  -- assembles its closure from SOURCE), so this exit had no counterpart to disagree with and the
  -- divergence was F's alone: `ssc run std/index.ssc` failed on F and printed nothing on the
  -- reference. Keep the stderr note — "this file has no code" is worth saying — and order the file
  -- like any other, so its CONTENT module is still produced.
  --
  -- Five corpus files: std/index.ssc, std/graphql.ssc, examples/deploy.ssc and the two frontend
  -- dashboards, all prose with ```sh / ```text blocks.
  let z = (if #i.eq(slen(src), 0) then #io.eprint(#sconcat("ssc1-run: no scalascript blocks found: ", #sconcat(path, "\n"))) else 0) in
  match sscOrderImps(sscImports(fileStr), sscDir(path), Cons(path, seen)) {
    case Pair(impPaths, seen2) => Pair(sscApp(impPaths, Cons(path, Nil)), seen2)
  }
def sscOrderRoots = (paths, seen) =>
  match paths {
    case Nil => Pair(Nil, seen)
    case Cons(path, rest) =>
      match sscOrderRoot(path, seen) {
        case Pair(p1, seen2) =>
          match sscOrderRoots(rest, seen2) {
            case Pair(more, seen3) => Pair(sscApp(p1, more), seen3)
          }
      }
  }

-- Build and evaluate a configuration-only CoreIR program from the canonical
-- ScalaScript YAML module. The user program is never executed during compile;
-- only yamlParse calls over front-matter strings run in this nested pure VM.
def sscEscapeYamlString = (s, i) =>
  if #i.ge(i, #slen(s)) then ""
  else
    let c = #scodeAt(s, i) in
    let piece =
      if #i.eq(c, 34) then "\\\""
      else (if #i.eq(c, 92) then "\\\\"
      else (if #i.eq(c, 10) then "\\n"
      else (if #i.eq(c, 13) then "\\r"
      else (if #i.eq(c, 9) then "\\t"
      else #sslice(s, i, #i.add(i, 1)))))) in
    #sconcat(piece, sscEscapeYamlString(s, #i.add(i, 1)))

def sscQuoteYamlString = (s) => #sconcat("\"", #sconcat(sscEscapeYamlString(s, 0), "\""))

def sscFrontmatterCall = (path) =>
  let fileStr = #utf8->str(#io.readFile(path)) in
  match extractFrontmatter(fileStr) {
    case FrontmatterNone => "None"
    case FrontmatterText(yaml) =>
      #sconcat("Some(yamlParse(", #sconcat(sscQuoteYamlString(yaml), "))"))
    case FrontmatterErr(message, line, column) =>
      #sconcat("Some(YamlErr(",
        #sconcat(sscQuoteYamlString(message),
          #sconcat(", 0, ",
            #sconcat(#i->str(line),
              #sconcat(", ", #sconcat(#i->str(column), ")))"))))))
  }

def sscFrontmatterCalls = (paths) =>
  match paths {
    case Nil => ""
    case Cons(path, rest) =>
      match rest {
        case Nil => sscFrontmatterCall(path)
        case _ => #sconcat(sscFrontmatterCall(path), #sconcat(", ", sscFrontmatterCalls(rest)))
      }
  }

def sscParseFrontmatters = (paths) =>
  let yamlPath = sscResolve("", "std/yaml-core.ssc") in
  match sscLoadMod(yamlPath, Nil) {
    case Pair(yamlDefs, yamlSeen) =>
      let callSource = #sconcat("List(", #sconcat(sscFrontmatterCalls(paths), ")")) in
      let callStmts = parse(callSource) in
      #coreir.eval(lowerProg(sscApp(yamlDefs, callStmts)))
  }

-- Evaluate the canonical pure Markdown Profile for every root source. The
-- frozen ssc0 tower still bootstraps the module definitions with mira-md, but
-- ordinary roots cross the Scala seed boundary only as structural
-- MarkdownDocument/MarkdownError values — the host never reparses their text.
def sscMarkdownCall = (path) =>
  let fileStr = #utf8->str(#io.readFile(path)) in
  #sconcat("markdownParse(", #sconcat(sscQuoteYamlString(fileStr), ")"))

def sscMarkdownCalls = (paths) =>
  match paths {
    case Nil => ""
    case Cons(path, rest) =>
      match rest {
        case Nil => sscMarkdownCall(path)
        case _ => #sconcat(sscMarkdownCall(path), #sconcat(", ", sscMarkdownCalls(rest)))
      }
  }

def sscParseMarkdowns = (paths) =>
  let markdownPath = sscResolve("", "std/markdown-core.ssc") in
  match sscLoadMod(markdownPath, Nil) {
    case Pair(markdownDefs, markdownSeen) =>
      let callSource = #sconcat("List(", #sconcat(sscMarkdownCalls(paths), ")")) in
      let callStmts = parse(callSource) in
      #coreir.eval(lowerProg(sscApp(markdownDefs, callStmts)))
  }

-- Build the complete immutable content-module closure in the self-hosted
-- tower. Direct import edges, namespace selection, heading/fence attributes,
-- section trees, and structured fence data are all projected by .ssc code;
-- the Scala seed receives only validated structural values.
def sscResolvedImports = (path) =>
  let fileStr = #utf8->str(#io.readFile(path)) in
  sscResolveImports(sscImports(fileStr), sscDir(path))
def sscResolveImports = (imports, dir) =>
  match imports {
    case Nil => Nil
    case Cons(rel, rest) => Cons(sscResolve(dir, rel), sscResolveImports(rest, dir))
  }
def sscQuotedStrings = (values) =>
  match values {
    case Nil => ""
    case Cons(value, rest) =>
      match rest {
        case Nil => sscQuoteYamlString(value)
        case _ => #sconcat(sscQuoteYamlString(value), #sconcat(", ", sscQuotedStrings(rest)))
      }
  }
def sscContentModuleCall = (path, roots) =>
  let explicitRoot = if sscMem(roots, path) then "true" else "false" in
  let imports = #sconcat("List(", #sconcat(sscQuotedStrings(sscResolvedImports(path)), ")")) in
  #sconcat("contentProjectModule(",
    #sconcat(sscQuoteYamlString(path),
      #sconcat(", ",
        #sconcat(explicitRoot,
          #sconcat(", ",
            #sconcat(imports,
              #sconcat(", ",
                #sconcat(sscFrontmatterCall(path),
                  #sconcat(", ", #sconcat(sscMarkdownCall(path), ")"))))))))))
def sscContentModuleCalls = (paths, roots) =>
  match paths {
    case Nil => ""
    case Cons(path, rest) =>
      match rest {
        case Nil => sscContentModuleCall(path, roots)
        case _ => #sconcat(sscContentModuleCall(path, roots), #sconcat(", ", sscContentModuleCalls(rest, roots)))
      }
  }
def sscParseContents = (modulePaths, roots) =>
  let contentPath = sscResolve("", "std/content-core.ssc") in
  match sscLoadMod(contentPath, Nil) {
    case Pair(contentDefs, contentSeen) =>
      let callSource = #sconcat("List(", #sconcat(sscContentModuleCalls(modulePaths, roots), ")")) in
      let callStmts = parse(callSource) in
      #coreir.eval(lowerProg(sscApp(contentDefs, callStmts)))
  }

def sscStructuralCell = #cell.new(false)
def sscNativeArgs = (args) =>
  match args {
    case Cons(flag, rest) =>
      if #seq(flag, "--std-root") then
        match rest {
          case Cons(root, paths) =>
            let z = #cell.set(sscStdRootCell, sscNormalize(root)) in sscNativeArgs(paths)
          case Nil => Nil
        }
      else if #seq(flag, "--lib-root") then
        match rest {
          case Cons(root, paths) =>
            let z = #cell.set(sscLibRootCell, sscNormalize(root)) in sscNativeArgs(paths)
          case Nil => Nil
        }
      else if #seq(flag, "--mutable") then
        let z = #cell.set(mutableFlagCell, true) in sscNativeArgs(rest)
      else (if #seq(flag, "--fsub-src") then
        match rest {
          case Cons(p, paths) =>
            let z = #cell.set(sscFsubSrcCell, sscNormalize(p)) in sscNativeArgs(paths)
          case Nil => Nil
        }
      else (if #seq(flag, "--fsub-ir") then
        match rest {
          case Cons(p, paths) =>
            let z = #cell.set(sscFsubIrCell, sscNormalize(p)) in sscNativeArgs(paths)
          case Nil => Nil
        }
      else (if #seq(flag, "--structural") then
        let z = #cell.set(sscStructuralCell, true) in sscNativeArgs(rest)
      else args)))
    case Nil => Nil
  }

-- F4 front swap (SSC_FRONT=F, REVERSIBLE): this runner is a byte-for-byte copy of ssc1-run.ssc0 with
-- ONE change to `main` — the user program's Core IR is produced by F (specs/v2.2-p6.5-fsub.ssc), the
-- self-hosting subset compiler, INSTEAD of ssc1-lower's `lowerProg`. Everything else (fence extraction,
-- multi-file source closure, YAML front-matter, content-module structural projection, the
-- NativeCompilation structural ABI) is reused unchanged, so RunNativeV2 needs no structural-decode
-- change. F's source path arrives via --fsub-src (staged beside this file by installBin).
--
-- The mechanic (validated byte-identical to the F0.ir gate path): compile F's own source with the
-- current front (parse+lowerProg), append a top-level expression `compile(userSrc, dq, bs)`, and
-- #coreir.eval it — F then lowers the user source to Core IR TEXT; the self-hosted irTextToData (see
-- D2 block below) turns that text back into the IrProg Data tree the structural ABI carries — WITHOUT
-- #coreir.decode, so no ssc.Reader is class-loaded on the F native path. dq/bs are the `"`/`\` strings
-- F splices into its output (P6.6b escape-free design), built via #sfromCodes so this driver has no
-- `"`-in-a-string.
def sscFsubSrcCell = #cell.new("")
-- Path of the PRE-LOWERED front (`--fsub-ir`). Empty = no cache; the runner then behaves exactly
-- as it did before this existed.
def sscFsubIrCell = #cell.new("")
def sscConcatSources = (paths) =>
  match paths {
    case Nil => ""
    case Cons(p, rest) =>
      let fileStr = #utf8->str(#io.readFile(p)) in
      let src0 = sscProgramSource(fileStr) in
      -- The `package:` namespace has to be appended HERE as well as in sscLoadMod:
      -- F assembles its closure from SOURCE (this function), not from the shared
      -- loaders' parsed defs, so a namespace added only there would exist on one
      -- front and not the other -- and which front runs a file is not a choice.
      -- Parsing is guarded on the package being declared, so a module without one
      -- pays nothing.
      let pkg = sscPkgName(fileStr) in
      let src1 =
        if #seq(pkg, "") then src0
        else #sconcat(src0,
               #sconcat("\n\n", sscPkgNsSource(pkg, sscDefsOnly(parse(src0))))) in
      -- `[x as y]` aliases are PREPENDED to the importing file's own source, not
      -- appended: this list is post-order so the targets are already above, and this
      -- file's top-level expressions may use the alias. Appending would define it after
      -- they had run.
      let alSrc = sscAliasSource(fileStr, sscDir(p)) in
      let src = if #i.eq(#slen(alSrc), 0) then src1
                else #sconcat(alSrc, #sconcat("\n\n", src1)) in
      let more = sscConcatSources(rest) in
      if #i.eq(slen(more), 0) then src
      else (if #i.eq(slen(src), 0) then more
      else #sconcat(src, #sconcat("\n\n", more)))
  }

-- D2 (f-runner-structural-data): self-hosted S-expr -> IrProg-Data reader. Parses F's canonical
-- Core IR TEXT (the Writer form, v2/src/CoreIR.scala) into EXACTLY the IrToData Data tree
-- (v2/src/Runtime.scala) so the F native path never class-loads the Java ssc.Reader (which
-- #coreir.decode does, tripping the v21-native-plugin-boundary / v21-plugin-backend-isolation
-- smokes under an F-default `ssc run --native`). This lives in the ssc0 RUNNER — NOT in fsub.ssc —
-- because F drops '#' (opCode 35 = 0) so #str->f/#str->big would mis-lex in the X1 fixpoint, and
-- pure F cannot parse a float from a string. F's `compile` still emits text (fixpoint untouched);
-- the runner reads that text via irTextToData, which loads no ssc.Reader. F's output is
-- first-party/trusted, so this is a PLAIN recursive-descent parse — no fail-closed bounds/validation.
-- ssc0 capitalized-ctor application builds DataV byte-identical to IrToData (IrProg/IrLam/IrArm/...);
-- scalar leaves fall out as the kernel's natural IntV/StrV/BoolV/FloatV/BigV; lists are Cons/Nil.
-- Verified: irTextToData(t) == #coreir.decode(t) (structural #__eq__) over all node/const forms.
def d2fst = (p) => match p { case Pair(a, b) => a }
def d2snd = (p) => match p { case Pair(a, b) => b }
def d2isWs = (c) => if #i.eq(c, 32) then true else (if #i.eq(c, 10) then true else (if #i.eq(c, 9) then true else #i.eq(c, 13)))
def d2skipWs = (s, i, n) => if #i.ge(i, n) then i else (if d2isWs(#scodeAt(s, i)) then d2skipWs(s, #i.add(i, 1), n) else i)
def d2isDelim = (c) => if d2isWs(c) then true else (if #i.eq(c, 40) then true else (if #i.eq(c, 41) then true else #i.eq(c, 34)))
def d2atomEnd = (s, i, n) => if #i.ge(i, n) then i else (if d2isDelim(#scodeAt(s, i)) then i else d2atomEnd(s, #i.add(i, 1), n))
def d2readAtom = (s, i, n) => let i1 = d2skipWs(s, i, n) in let e = d2atomEnd(s, i1, n) in Pair(#sslice(s, i1, e), e)
def d2rparen = (s, i, n) => #i.add(d2skipWs(s, i, n), 1)
def d2strToInt = (a) => match #str->i(a) { case Some(x) => x case None => 0 }
def d2strToBig = (a) => match #str->big(a) { case Some(x) => x case None => #i->big(0) }
def d2strToFloat = (a) => match #str->f(a) { case Some(x) => x case None => 0 }
def d2hexDig = (c) => if #i.ge(c, 48) then (if #i.le(c, 57) then #i.sub(c, 48) else (if #i.ge(c, 97) then (if #i.le(c, 102) then #i.sub(c, 87) else 0) else (if #i.ge(c, 65) then (if #i.le(c, 70) then #i.sub(c, 55) else 0) else 0))) else 0
def d2hex4 = (s, i) => #i.add(#i.mul(#i.add(#i.mul(#i.add(#i.mul(d2hexDig(#scodeAt(s, i)), 16), d2hexDig(#scodeAt(s, #i.add(i, 1)))), 16), d2hexDig(#scodeAt(s, #i.add(i, 2)))), 16), d2hexDig(#scodeAt(s, #i.add(i, 3))))
-- `(bytes <hex>)` never appears in F's output (F's front has no byte-literal syntax); this ASCII-only
-- path exists for total-function completeness. Bytes >= 0x80 would need a codes->Bytes kernel prim.
def d2hexCodes = (hx, i, n) => if #i.ge(i, n) then Nil else Cons(#i.add(#i.mul(d2hexDig(#scodeAt(hx, i)), 16), d2hexDig(#scodeAt(hx, #i.add(i, 1)))), d2hexCodes(hx, #i.add(i, 2), n))
def d2hexToBytes = (hx) => #str->utf8(#sfromCodes(d2hexCodes(hx, 0, #slen(hx))))
def d2readStr = (s, i, n) => let i1 = d2skipWs(s, i, n) in d2strBody(s, #i.add(i1, 1), n, "")
def d2strBody = (s, i, n, acc) =>
  if #i.ge(i, n) then Pair(acc, i)
  else let c = #scodeAt(s, i) in
    if #i.eq(c, 34) then Pair(acc, #i.add(i, 1))
    else if #i.eq(c, 92) then d2strEsc(s, #i.add(i, 1), n, acc)
    else d2strBody(s, #i.add(i, 1), n, #sconcat(acc, #sslice(s, i, #i.add(i, 1))))
def d2strEsc = (s, i, n, acc) =>
  let e = #scodeAt(s, i) in
  if #i.eq(e, 34) then d2strBody(s, #i.add(i, 1), n, #sconcat(acc, #sfromCodes(Cons(34, Nil))))
  else if #i.eq(e, 92) then d2strBody(s, #i.add(i, 1), n, #sconcat(acc, #sfromCodes(Cons(92, Nil))))
  else if #i.eq(e, 110) then d2strBody(s, #i.add(i, 1), n, #sconcat(acc, #sfromCodes(Cons(10, Nil))))
  else if #i.eq(e, 114) then d2strBody(s, #i.add(i, 1), n, #sconcat(acc, #sfromCodes(Cons(13, Nil))))
  else if #i.eq(e, 116) then d2strBody(s, #i.add(i, 1), n, #sconcat(acc, #sfromCodes(Cons(9, Nil))))
  else if #i.eq(e, 117) then d2strBody(s, #i.add(i, 5), n, #sconcat(acc, #sfromCodes(Cons(d2hex4(s, #i.add(i, 1)), Nil))))
  else d2strBody(s, #i.add(i, 1), n, #sconcat(acc, #sslice(s, i, #i.add(i, 1))))
def d2const = (s, j, n) =>
  let i1 = d2skipWs(s, j, n) in
  if #i.eq(#scodeAt(s, i1), 40) then d2constList(s, #i.add(i1, 1), n)
  else let a = d2readAtom(s, i1, n) in let av = d2fst(a) in
    Pair(if #seq(av, "unit") then IrUnit else (if #seq(av, "true") then IrBool(true) else IrBool(false)), d2snd(a))
def d2constList = (s, i, n) =>
  let ka = d2readAtom(s, i, n) in let k = d2fst(ka) in let j = d2snd(ka) in
  if #seq(k, "int") then let a = d2readAtom(s, j, n) in Pair(IrInt(d2strToInt(d2fst(a))), d2rparen(s, d2snd(a), n))
  else if #seq(k, "big") then let a = d2readAtom(s, j, n) in Pair(IrBig(d2strToBig(d2fst(a))), d2rparen(s, d2snd(a), n))
  else if #seq(k, "float") then let a = d2readAtom(s, j, n) in Pair(IrFloat(d2strToFloat(d2fst(a))), d2rparen(s, d2snd(a), n))
  else if #seq(k, "str") then let sv = d2readStr(s, j, n) in Pair(IrStr(d2fst(sv)), d2rparen(s, d2snd(sv), n))
  else let i1 = d2skipWs(s, j, n) in
    if #i.eq(#scodeAt(s, i1), 41) then Pair(IrBytes(#str->utf8("")), #i.add(i1, 1))
    else let a = d2readAtom(s, i1, n) in Pair(IrBytes(d2hexToBytes(d2fst(a))), d2rparen(s, d2snd(a), n))
def d2term = (s, i, n) =>
  let i1 = d2skipWs(s, i, n) in
  let ha = d2readAtom(s, #i.add(i1, 1), n) in
  d2dispatch(d2fst(ha), s, d2snd(ha), n)
def d2termList = (s, i, n) =>
  let i1 = d2skipWs(s, i, n) in
  if #i.eq(#scodeAt(s, i1), 41) then Pair(Nil, #i.add(i1, 1))
  else let t = d2term(s, i1, n) in let rest = d2termList(s, d2snd(t), n) in Pair(Cons(d2fst(t), d2fst(rest)), d2snd(rest))
def d2dispatch = (h, s, j, n) =>
  if #seq(h, "lit") then let cp = d2const(s, j, n) in Pair(IrLit(d2fst(cp)), d2rparen(s, d2snd(cp), n))
  else if #seq(h, "local") then let a = d2readAtom(s, j, n) in Pair(IrLocal(d2strToInt(d2fst(a))), d2rparen(s, d2snd(a), n))
  else if #seq(h, "global") then let a = d2readAtom(s, j, n) in Pair(IrGlobal(d2fst(a)), d2rparen(s, d2snd(a), n))
  else if #seq(h, "lam") then let a = d2readAtom(s, j, n) in let b = d2term(s, d2snd(a), n) in Pair(IrLam(d2strToInt(d2fst(a)), d2fst(b)), d2rparen(s, d2snd(b), n))
  else if #seq(h, "app") then let fn = d2term(s, j, n) in let as = d2termList(s, d2snd(fn), n) in Pair(IrApp(d2fst(fn), d2fst(as)), d2snd(as))
  else if #seq(h, "let") then let i1 = d2skipWs(s, j, n) in let rhs = d2termList(s, #i.add(i1, 1), n) in let b = d2term(s, d2snd(rhs), n) in Pair(IrLet(d2fst(rhs), d2fst(b)), d2rparen(s, d2snd(b), n))
  else if #seq(h, "letrec") then let i1 = d2skipWs(s, j, n) in let ls = d2termList(s, #i.add(i1, 1), n) in let b = d2term(s, d2snd(ls), n) in Pair(IrLetRec(d2fst(ls), d2fst(b)), d2rparen(s, d2snd(b), n))
  else if #seq(h, "if") then let c = d2term(s, j, n) in let t = d2term(s, d2snd(c), n) in let e = d2term(s, d2snd(t), n) in Pair(IrIf(d2fst(c), d2fst(t), d2fst(e)), d2rparen(s, d2snd(e), n))
  else if #seq(h, "ctor") then let tg = d2readAtom(s, j, n) in let fs = d2termList(s, d2snd(tg), n) in Pair(IrCtor(d2fst(tg), d2fst(fs)), d2snd(fs))
  else if #seq(h, "prim") then let op = d2readAtom(s, j, n) in let as = d2termList(s, d2snd(op), n) in Pair(IrPrim(d2fst(op), d2fst(as)), d2snd(as))
  else if #seq(h, "while") then let c = d2term(s, j, n) in let b = d2term(s, d2snd(c), n) in Pair(IrWhile(d2fst(c), d2fst(b)), d2rparen(s, d2snd(b), n))
  else if #seq(h, "seq") then let ts = d2termList(s, j, n) in Pair(IrSeq(d2fst(ts)), d2snd(ts))
  else if #seq(h, "match") then d2pMatch(s, j, n)
  else Pair(IrLit(IrUnit), j)
def d2pMatch = (s, j, n) =>
  let sc = d2term(s, j, n) in
  let i1 = d2skipWs(s, d2snd(sc), n) in
  let arms = d2armList(s, #i.add(i1, 1), n) in
  let df = d2default(s, d2snd(arms), n) in
  Pair(IrMatch(d2fst(sc), d2fst(arms), d2fst(df)), d2snd(df))
def d2armList = (s, i, n) =>
  let i1 = d2skipWs(s, i, n) in
  if #i.eq(#scodeAt(s, i1), 41) then Pair(Nil, #i.add(i1, 1))
  else let a = d2arm(s, i1, n) in let rest = d2armList(s, d2snd(a), n) in Pair(Cons(d2fst(a), d2fst(rest)), d2snd(rest))
def d2arm = (s, i, n) =>
  let i1 = d2skipWs(s, i, n) in
  let ha = d2readAtom(s, #i.add(i1, 1), n) in
  let tg = d2readAtom(s, d2snd(ha), n) in
  let ar = d2readAtom(s, d2snd(tg), n) in
  let b = d2term(s, d2snd(ar), n) in
  Pair(IrArm(d2fst(tg), d2strToInt(d2fst(ar)), d2fst(b)), d2rparen(s, d2snd(b), n))
def d2default = (s, i, n) =>
  let i1 = d2skipWs(s, i, n) in
  if #i.eq(#scodeAt(s, i1), 41) then Pair(None, #i.add(i1, 1))
  else let ha = d2readAtom(s, #i.add(i1, 1), n) in let dt = d2term(s, d2snd(ha), n) in let k = d2rparen(s, d2snd(dt), n) in Pair(Some(d2fst(dt)), d2rparen(s, k, n))
def d2def = (t, i, n) =>
  let i1 = d2skipWs(t, i, n) in
  let ha = d2readAtom(t, #i.add(i1, 1), n) in
  let nm = d2readAtom(t, d2snd(ha), n) in
  let b = d2term(t, d2snd(nm), n) in
  Pair(IrDef(d2fst(nm), d2fst(b)), d2rparen(t, d2snd(b), n))
def d2defList = (t, i, n) =>
  let i1 = d2skipWs(t, i, n) in
  if #i.eq(#scodeAt(t, i1), 41) then Pair(Nil, #i.add(i1, 1))
  else let d = d2def(t, i1, n) in let rest = d2defList(t, d2snd(d), n) in Pair(Cons(d2fst(d), d2fst(rest)), d2snd(rest))
def d2defs = (t, i, n) =>
  let i1 = d2skipWs(t, i, n) in
  let ha = d2readAtom(t, #i.add(i1, 1), n) in
  d2defList(t, d2snd(ha), n)
def d2entry = (t, i, n) =>
  let i1 = d2skipWs(t, i, n) in
  let ha = d2readAtom(t, #i.add(i1, 1), n) in
  let e = d2term(t, d2snd(ha), n) in
  Pair(d2fst(e), d2rparen(t, d2snd(e), n))
def irTextToData = (t) =>
  let n = #slen(t) in
  let i0 = d2skipWs(t, 0, n) in
  let ha = d2readAtom(t, #i.add(i0, 1), n) in
  let defsP = d2defs(t, d2snd(ha), n) in
  let entryP = d2entry(t, d2snd(defsP), n) in
  IrProg(d2fst(defsP), d2fst(entryP))

-- THE FRONT IS LOWERED ONCE, NOT ONCE PER RUN.
--
-- Measured 2026-08-16: `parse` + `lowerProg` of F's 392 KB source costs 8.74 s, and it ran on EVERY
-- invocation before this — a one-line `println(1)` and a 121-line program cost the same, because the
-- work was never proportional to the subject file. Reading a pre-lowered F0 back with the
-- self-hosted `irTextToData` costs ~0.95 s for the same 532 KB, round-tripping byte-identical.
--
-- THE ARTIFACT IS A CLOSURE, WHICH IS WHY THIS WORKS AT ALL. The obvious cache — F0 with a `main`
-- that reads a PATH from `#io.args()`, as `specs/v2.2-p6.5-corpus.sh` has bootstrapped for years —
-- is unusable here: the driver assembles a source CLOSURE (imports, `package:` namespace, `[x as y]`
-- aliases) that exists only as a string in this process, and the tower does not control the args the
-- evaluated program sees. Bootstrapping with `def main = () => compile` instead makes `#coreir.eval`
-- hand back F's `compile` FUNCTION, which is then applied directly. Verified: the emitted user IR is
-- byte-identical to the uncached path.
--
-- `#coreir.decode` is deliberately NOT used, here or anywhere on this lane — it would class-load
-- `ssc.Reader`, and `v21-native-plugin-boundary-smoke` fails on exactly that, by name. Measured:
-- today's F path loads it 0 times, `run-ir` loads it 23. `irTextToData` is the Reader-free reader
-- D2 wrote for this and it is what both halves below use.
--
-- COLD IS CORRECT, NOT JUST SLOW. With no artifact staged the runner lowers the front as before and
-- writes it out for next time; with no `--fsub-ir` at all it does exactly what it always did. A
-- missing or unwritable cache degrades to the old cost, never to a different answer — and the JDK
-- side keys the path on the CONTENT of `fsub.ssc`, so a changed front cannot be served from a stale
-- artifact.
def sscFsubIr = (userSrc) => sscFsubIrPick(#cell.get(sscFsubIrCell), userSrc)
def sscFsubIrPick = (irPath, userSrc) =>
  if #i.eq(slen(irPath), 0) then sscFsubIrSlow(userSrc)
  else (if #io.exists(irPath) then sscFsubIrWarm(irPath, userSrc) else sscFsubIrCold(irPath, userSrc))
def sscFsubIrWarm = (irPath, userSrc) =>
  sscFsubApply(#coreir.eval(irTextToData(#utf8->str(#io.readFile(irPath)))), userSrc)
def sscFsubIrCold = (irPath, userSrc) =>
  let lowered = lowerProg(sscFsubProg()) in
  let z = #io.writeFile(irPath, #str->utf8(#coreir.encode(lowered))) in
  sscFsubApply(#coreir.eval(lowered), userSrc)
def sscFsubProg = () =>
  let fSrc = #utf8->str(#io.readFile(#cell.get(sscFsubSrcCell))) in
  sscApp(parse(fSrc), Cons(mkDef("main", Nil, mkVar("compile")), Nil))
def sscFsubApply = (f, userSrc) =>
  let dq = #sfromCodes(Cons(34, Nil)) in
  let bs = #sfromCodes(Cons(92, Nil)) in
  irTextToData(f(userSrc, dq, bs))
-- The pre-cache path, kept verbatim as the no-`--fsub-ir` behaviour. D2: F's `compile` emits the
-- user IR as canonical TEXT; `irTextToData` parses it into the IrProg Data tree WITHOUT
-- `#coreir.decode`, so the F native path class-loads no ssc.Reader. callExpr stays `compile(...)` —
-- F still emits text, so the X1 fixpoint is byte-identical.
def sscFsubIrSlow = (userSrc) =>
  let fSrc = #utf8->str(#io.readFile(#cell.get(sscFsubSrcCell))) in
  let dq = #sfromCodes(Cons(34, Nil)) in
  let bs = #sfromCodes(Cons(92, Nil)) in
  let callExpr = mkApp(mkVar("compile"), Cons(mkStr(userSrc), Cons(mkStr(dq), Cons(mkStr(bs), Nil)))) in
  let fProg = sscApp(parse(fSrc), Cons(Pair("expr", callExpr), Nil)) in
  irTextToData(#coreir.eval(lowerProg(fProg)))

def main = () =>
  let paths = sscNativeArgs(#io.args()) in
  match paths {
    case Cons(path, rest) =>
      if #i.eq(slen(#cell.get(sscFsubSrcCell)), 0) then
        let z = #io.eprint("ssc1-run-fsub: --fsub-src <F.ssc> is required (SSC_FRONT=F staging)\n") in
        #io.exit(2)
      else
      match sscOrderRoots(Cons(path, rest), Nil) {
        case Pair(orderedPaths, seen) =>
          -- orderedPaths is POST-ORDER (imports before their importer, siblings —
          -- multiple positional roots and multiple sibling imports — left-to-right),
          -- matching the legacy front's lowerProg(allStmts) statement order. The flat
          -- `seen` list is reverse-pre-order and REVERSES siblings, so concatenating it
          -- ran `A.ssc B.ssc` as B-then-A; concatenating orderedPaths preserves positional
          -- order while keeping imported modules' top-level val inits ahead of the root's
          -- bare expressions. `seen` still carries the dedup set for the content projection.
          let userSrc = sscConcatSources(orderedPaths) in
          let ir = sscFsubIr(userSrc) in
          if #cell.get(sscStructuralCell) then
            NativeCompilation(ir, sscParseFrontmatters(paths), sscParseContents(reverse(seen), paths), paths)
          else #io.print(#coreir.encode(ir))
      }
    case Nil =>
      let z = #io.eprint("usage: ssc1-run-fsub --fsub-src <F.ssc> [--std-root DIR] <file.ssc> [more.ssc ...]\n") in
      #io.exit(1)
  }
