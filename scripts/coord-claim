#!/usr/bin/env bash
#
# coord-claim — claim a task atomically, BEFORE planning it (specs/claim-mutex.md).
#
#   scripts/coord-claim <slug> --items "<id> [<id>…]" --paths "<prefix> […]" [--agent <id>]
#
# Writes `.work/active/<slug>.claim`, adds the matching `.work/active/LEDGER.tsv` line and bumps the
# ledger's generation counter, then commits and pushes to origin/main in ONE commit.
#
# Why the generation bump matters: it is what makes two concurrent claims collide. Without it each
# claim writes a disjoint file, so the loser of the push race rebases cleanly and never learns the
# winner exists — which is exactly how two agents did the same work twice on 2026-07-27.
#
# On a rejected push this does NOT auto-rebase: it stops and tells you to re-read the queue, because
# "the push was rejected" means someone else moved first and your plan may now be wrong.
set -euo pipefail

slug=""; items=""; paths=""; broad=""; agent="${SSC_AGENT_ID:-claude-code}"
while [ $# -gt 0 ]; do
  case "$1" in
    --items) items="$2"; shift 2 ;;
    --paths) paths="$2"; shift 2 ;;
    --broad) broad="$2"; shift 2 ;;
    --agent) agent="$2"; shift 2 ;;
    -*) echo "unknown flag: $1" >&2; exit 2 ;;
    *) slug="$1"; shift ;;
  esac
done

# A subtree reservation must justify itself. Unprefixed paths are grandfathered so nothing that
# exists today breaks, but anything written as mod:/repo: from now on states why.
needs_broad=""
for sc in $paths; do
  case "$sc" in
    repo:*|repo) needs_broad="$needs_broad repo:" ;;
    mod:*)       needs_broad="$needs_broad $sc" ;;
  esac
done
if [ -n "$needs_broad" ] && [ -z "$broad" ]; then
  printf 'refusing: these scopes reserve whole subtrees and need --broad "<reason>":\n' >&2
  for sc in $needs_broad; do printf '  %s\n' "$sc" >&2; done
  printf '\nA subtree is often 1000+ files. Measured 2026-07-30: one claim reserved 1777 and 9\n' >&2
  printf 'changed in two days. Prefer file: scopes, or say why the subtree is needed.\n' >&2
  exit 2
fi

if [ -z "$slug" ] || [ -z "$items" ] || [ -z "$paths" ]; then
  cat >&2 <<'EOF'
usage: scripts/coord-claim <slug> --items "<id> …" --paths "<prefix> …" [--agent <id>]

  --items  SPRINT item ids and/or BUGS slugs — the WORK, not the name. This is what lets the
           pre-push guard notice a rival claim under a different slug.
  --paths  scopes this claim may touch, each optionally LEVEL-PREFIXED
           (specs/claim-mutex.md §Hierarchy):
             file:<path>   exactly one file      — prefer this; it is what lets others work nearby
             mod:<path>    a module subtree      — requires --broad "<reason>"
             repo:         the whole repository  — requires --broad, and is almost never right
             <path>        unprefixed = mod:<path>, unchanged from before
           Measured 2026-07-30: one claim reserved 1777 files and 9 of them changed in two days.
           A subtree is 1000+ files; asking for one costs a sentence.
  --broad  justification required by any mod:/repo: scope.

Claim FIRST, then plan: a claim is one cheap revocable commit, while planning takes minutes, and
that gap is the whole race window.
EOF
  exit 2
fi

MAIN=$(git worktree list | head -1 | awk '{print $1}')
cd "$MAIN"

[ -d .git ] || { echo "✋ claim from the MAIN checkout, not a worktree (AGENTS.md)" >&2; exit 1; }
[ "$(git symbolic-ref --short HEAD)" = "main" ] || { echo "✋ main checkout must be on branch main" >&2; exit 1; }

git fetch -q origin
git merge --ff-only origin/main -q

claim=".work/active/${slug}.claim"
ledger=".work/active/LEDGER.tsv"

if git ls-tree -r --name-only origin/main -- .work/active/ | grep -Fxq "$claim"; then
  echo "✋ '${slug}' is already claimed on origin/main. Read it first:" >&2
  git show "origin/main:$claim" >&2
  exit 1
fi

ts=$(date -u +%Y-%m-%dT%H:%M:%SZ)
mkdir -p .work/active
[ -f "$ledger" ] || printf '# generation: 0\n#slug\tagent\tstarted\titems\tpaths\n' > "$ledger"

cat > "$claim" <<EOF
slug: ${slug}
branch: feature/${slug}
agent: ${agent}
started: ${ts}
heartbeat: ${ts}
status: claimed-before-planning
items: ${items}
paths: ${paths}${broad:+\nbroad: ${broad}}
scope: |
  (fill in once planned — the claim exists first so the queue is reserved while you plan)
next: plan the task into SPRINT.md, then implement
EOF

SLUG="$slug" AGENT="$agent" TS="$ts" ITEMS="$items" PATHS="$paths" python3 - "$ledger" <<'PY'
import os, re, sys
p = sys.argv[1]
lines = [l for l in open(p).read().split("\n") if l.strip() != ""]
gen = int(re.search(r"# generation: (\d+)", lines[0]).group(1))
lines[0] = f"# generation: {gen + 1}"          # the bump IS the mutex — never drop it
lines.append("\t".join([os.environ["SLUG"], os.environ["AGENT"], os.environ["TS"],
                        os.environ["ITEMS"], os.environ["PATHS"]]))
open(p, "w").write("\n".join(lines) + "\n")
PY

git add "$claim" "$ledger"
# ── the board row, in the SAME commit as the claim ────────────────────────────────────────────
#
# SPRINT.md's contract says step 3 happens "in ONE commit" with the claim, and calls a claim without
# a row "invisible work". Nothing wrote the row, so the contract was unenforceable by construction:
# measured 2026-07-30, 4 live claims and 1 board row — 75% invisible, and two of those were mine.
# A rule that depends on every agent remembering it is a wish, not a rule.
#
# The module column is derived from the claim's scopes: the longest module prefix from
# specs/work-tracking-layout.md that covers ALL of them, else *(repo-wide)*. Bookkeeping files are
# ignored when deriving it — every claim touches a board, and letting that decide the module would
# label everything `scripts`.
SLUG="$slug" ITEMS="$items" PATHS="$paths" python3 - "$root/SPRINT.md" <<'PY_ROW'
import os, sys, re
board = sys.argv[1]
slug, items, paths = os.environ["SLUG"], os.environ["ITEMS"], os.environ["PATHS"]
MODULES = ["v1/runtime/backend/interpreter", "v1/runtime/backend/js", "v1/runtime/backend/jvm",
           "v1/lang", "tests/conformance", "tests", "scripts", "uniml", "scljet", "v2", "std"]
BOOK = {"SPRINT.md", "BACKLOG.md", "BUGS.md", "CHANGELOG.md", "MILESTONES.md", "README.md"}

def bare(scope):
    for pre in ("repo:", "mod:", "file:"):
        if scope.startswith(pre): return scope[len(pre):]
    return scope

real = [bare(p) for p in paths.split() if os.path.basename(bare(p)) not in BOOK]
mods = set()
for p in real:
    hit = next((m for m in MODULES if p == m or p.startswith(m + "/")), None)
    mods.add(hit)
module = f"`{mods.pop()}`" if len(mods) == 1 and None not in mods else "*(repo-wide)*"

row = f"| `{items.split()[0]}` | {module} | `{slug}` | in progress | claimed by scripts/coord-claim |" + "\n"
text = open(board).read()
if f"`{slug}`" in text:
    sys.exit(0)                                  # idempotent: re-running must not duplicate a row
m = re.search(r"(^\|---[^\n]*\n)", text, re.M)
if not m:
    sys.stderr.write("coord-claim: no board table found in SPRINT.md; row not written\n")
    sys.exit(0)                                  # never block a claim on board shape
open(board, "w").write(text[:m.end()] + row + text[m.end():])
PY_ROW
git add SPRINT.md 2>/dev/null || true

git commit -q -m "claim: ${slug} (${items}) [skip ci]"

# Keep the push output. Swallowing it (the old `2>/dev/null`) meant an OVERLAP refusal from the
# pre-push guard and a plain generation race printed the SAME message — so an agent blocked by a real
# conflict was told to retry, and retried ~10 times before diagnosing it by reading the hook. A guard
# that cannot say WHY it refused is only half a guard.
push_log=$(mktemp)
if git push -q origin main >"$push_log" 2>&1; then
  rm -f "$push_log"
  echo "✓ claimed ${slug}  items='${items}'  paths='${paths}'"
  echo "  now: scripts/new-worktree ${slug}   then plan it into SPRINT.md"
else
  if grep -q 'overlaps a live claim' "$push_log"; then
    cat >&2 <<EOF

✋ claim REFUSED — it overlaps a live claim. This is NOT a race; retrying will not help.

$(cat "$push_log")
EOF
  else
    cat >&2 <<EOF

✋ push rejected — another agent moved first (the queue generation advanced).

Deliberately NOT auto-rebasing: someone else changed the queue, so re-read it before deciding.
  git fetch origin && git ls-tree origin/main .work/active/
Then either pick different work, or reset this claim and redo it:
  git reset --hard origin/main

$(sed -n '1,6p' "$push_log")
EOF
  fi
  rm -f "$push_log"
  exit 1
fi
