def readWidth(little: Boolean, width: Int): Int =
  val value = if little then width * 2
              else width * 3
  value + 1

def sign(n: Int): String =
  if n > 0 then "pos"
  else if n < 0 then "neg"
  else "zero"

println(readWidth(true, 4))
println(readWidth(false, 4))
println(sign(5))
println(sign(-5))
println(sign(0))
