```scalascript
effect A:
  def a(): Int
effect B:
  def b(): Int

def inner(): Int =
  val x = A.a()
  x + 1

def h(): Int =
  val x = B.b()
  x * 2

def outer(): Int =
  handle(inner()) {
    case a(k) => k(h() + 5)
  }

def top(): Int =
  handle(outer()) {
    case b(k2) => k2(3) + 1
  }

println(top())
```
