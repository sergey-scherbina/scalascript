#!/usr/bin/env bash
#
# Worktree guardrail (specs/worktree-guardrail.md).
#
# Refuses a feature commit made in the shared `main` checkout or on the `main`
# branch — that work belongs in a worktree on a feature/<name> branch (AGENTS.md §1).
# Coordination commits that touch ONLY `.work/` (claims/releases/pause) stay allowed.
# Commits in a feature worktree are never affected. Escape hatch: `git commit --no-verify`.
set -euo pipefail

# Resolve git-dir and the common git-dir as absolute paths so the comparison is correct
# from any subdirectory. A linked worktree has git-dir = …/.git/worktrees/NAME, which
# differs from the common dir …/.git; the main checkout has them equal.
git_dir=$(git rev-parse --absolute-git-dir)
common_dir=$(git rev-parse --git-common-dir)
case "$common_dir" in
  /*) : ;;                                  # already absolute
  *)  common_dir="$(pwd)/$common_dir" ;;
esac
git_dir=$(cd "$git_dir" && pwd -P)
common_dir=$(cd "$common_dir" && pwd -P)

in_main_checkout=0
[ "$git_dir" = "$common_dir" ] && in_main_checkout=1

branch=$(git symbolic-ref --quiet --short HEAD || echo "(detached)")
on_main_branch=0
[ "$branch" = "main" ] && on_main_branch=1

if [ "$in_main_checkout" -eq 1 ] || [ "$on_main_branch" -eq 1 ]; then
  # Anything staged outside .work/ is feature work and must not land here.
  offending=$(git diff --cached --name-only | grep -v '^\.work/' || true)
  if [ -n "$offending" ]; then
    where="the shared main checkout"
    [ "$in_main_checkout" -eq 1 ] || where="branch 'main'"
    cat >&2 <<EOF

✋ pre-commit: refusing a non-coordination commit in ${where}.

Feature work must happen in a worktree on a feature/<name> branch (AGENTS.md §1).
Quick fix:
  scripts/new-worktree <name>          # creates an external worktree off origin/main
  # or, by hand:
  MAIN=\$(git worktree list | head -1 | awk '{print \$1}')
  git -C "\$MAIN" worktree add "\$(dirname "\$MAIN")/\$(basename "\$MAIN")-wt-<name>" -b feature/<name> origin/main

Staged paths outside .work/ (coordination-only commits ARE allowed here):
$(printf '  %s\n' $offending)

Override (rarely correct): git commit --no-verify
EOF
    exit 1
  fi
fi

# ─────────────────────────────────────────────────────────────────────────────
# Claim scope guard (specs/claim-mutex.md, layer 3).
#
# In a feature/<slug> worktree, staged paths must fall inside the `paths:` its claim declares on
# origin/main. This is the gate for the 2026-07-27 case where an agent holding one claim did the
# work of another agent's claim and nothing objected.
#
# Two deliberate softenings, without which the guard would be disabled by whoever it first annoys:
#   - a shared set every task legitimately touches is always allowed;
#   - no claim, or a claim that declares no `paths:`, is allowed with a note (backward compatible).
# ─────────────────────────────────────────────────────────────────────────────
case "$branch" in
  feature/*)
    slug=${branch#feature/}
    claim_paths=$(git show "origin/main:.work/active/${slug}.claim" 2>/dev/null |
                    sed -n 's/^paths:[[:space:]]*//p' | head -1 || true)
    if [ -n "$claim_paths" ]; then
      staged=$(git diff --cached --name-only)
      outside=""
      for f in $staged; do
        case "$f" in
          # Shared bookkeeping / coordination — every task touches these by design.
          SPRINT.md|BACKLOG.md|CHANGELOG.md|BUGS.md|MILESTONES.md|AGENTS.md|README.md) continue ;;
          .work/*|specs/*) continue ;;
        esac
        ok=0
        for p in $claim_paths; do
          # Strip the scope LEVEL prefix before comparing (specs/claim-mutex.md §Hierarchy).
          #
          # Layer 2 (pre-push) learned `repo:` / `mod:` / `file:` on 2026-07-30; this layer did not, so
          # it compared the literal `file:scripts/foo` against the staged path `scripts/foo` and
          # refused. The new scope level could therefore be CLAIMED and could pass the overlap guard,
          # but nothing could be COMMITTED under it — the finest granularity was the one that did not
          # work, which is the opposite of the intent. Found by the first claim to use `file:`.
          #
          # Same shape as the note further up about shared bookkeeping: that exemption lived in this
          # layer and not in layer 2, and four finished items sat un-ticked because of it. Duplicated
          # logic needs the same vocabulary on both sides, or it is not one guard but two.
          p="${p#repo:}"; p="${p#mod:}"; p="${p#file:}"
          # Declared paths are PREFIXES; tolerate a trailing glob people write out of habit
          # (`scljet/**` and `scljet/` must mean the same thing, or the guard fires on its own author).
          while [ "${p%\*}" != "$p" ]; do p="${p%\*}"; done
          case "$f" in "$p"*) ok=1; break ;; esac
        done
        [ "$ok" -eq 1 ] || outside="$outside $f"
      done
      if [ -n "$outside" ]; then
        cat >&2 <<EOF

✋ pre-commit: these staged paths are outside what claim '${slug}' declared.

Declared paths: ${claim_paths}
Outside them:
$(printf '  %s\n' $outside)

Working outside your own claim is how one agent silently redid another's task on 2026-07-27
(specs/claim-mutex.md). Pick one:
  - widen the claim:  edit .work/active/${slug}.claim 'paths:' in the MAIN checkout, push it, then
                      re-run this commit — that also lets the pre-push guard spot a real overlap;
  - or claim the other work separately and do it in its own worktree.

Override (rarely correct): git commit --no-verify
EOF
        exit 1
      fi
    fi
    ;;
esac
exit 0
