#!/usr/bin/env bash
#
# Claim-overlap guard (specs/claim-mutex.md, layer 2).
#
# Refuses a push to `main` that introduces a claim overlapping a DIFFERENT live claim — the
# same-work-different-slug case the old check could not see, because it compared slug FILENAMES
# (`grep -Fx .work/active/<slug>.claim`) rather than the work itself.
#
# Overlap is judged on two declared fields of the claim file:
#   items: <id> [<id>…]   SPRINT item ids / BUGS slugs — the WORK
#   paths: <prefix> […]   path prefixes the claim may touch
#
# A claim named `verify-*` is allowed to overlap on purpose: re-checking another agent's landed
# result is valuable (it is how scljet-ipk-move-indexed-corrupts-btree was found). The point of this
# hook is that overlap be DELIBERATE, not accidental.
#
# Escape hatch: git push --no-verify
set -euo pipefail
# Globbing OFF for the whole hook. `for p in $paths` is an unquoted expansion, so a claim path
# written as `v1/runtime/**` was EXPANDED against the working tree before being compared — it became
# the directories that happen to exist today (`v1/runtime/backend` …) and stopped covering anything
# added later. That is fail-open in the same direction as the drift bug below: a rival claiming a
# not-yet-existing path under `v1/runtime/` would have been let through. The hook globs nothing on
# purpose; claim paths are literal prefixes.
set -f

# Is path $1 the same as $2, INSIDE $2, or neither?  →  same | inside | outside
#
# THE SEPARATOR IS THE WHOLE POINT. This was three copies of `case "$a" in "$b"*)`, a bare prefix
# match, so any directory whose NAME merely begins with another claimed directory's name was
# reported as living inside it: a claim on `v3/tests/front-capability` was refused as falling inside
# `v3/tests/front`, and `v1/lang/core` would block `v1/lang/core-bench`, which exists.
#
# A false refusal costs more than the inconvenience. The guard's entire value is that agents trust
# it, and the habit a wrong refusal teaches is `--no-verify` — after which the next REAL overlap goes
# through on the same reflex. Exercised by `--self-test` below, because an untested comparison is how
# this survived in three places at once.
path_rel() {
  case "$1" in
    "$2")   printf 'same'   ;;
    "$2"/*) printf 'inside' ;;
    *)      printf 'outside' ;;
  esac
}

if [ "${1:-}" = "--self-test" ]; then
  st_fail=0
  st() { # st <a> <b> <expected>
    got="$(path_rel "$1" "$2")"
    if [ "$got" = "$3" ]; then printf '  ok   %-34s vs %-22s -> %s\n' "$1" "$2" "$got"
    else printf '  FAIL %-34s vs %-22s -> %s, want %s\n' "$1" "$2" "$got" "$3"; st_fail=1; fi
  }
  echo "── pre-push path containment ───────────────────────────────────────────"
  # THE INCIDENT, first: siblings that share a prefix are not containment.
  st "v3/tests/front-capability" "v3/tests/front"  outside
  st "v1/lang/core-bench"        "v1/lang/core"    outside
  # …and the containment it must still catch, so the fix is not simply "admit everything".
  st "v3/tests/front/x.ssc"      "v3/tests/front"  inside
  st "v2/src/Runtime.scala"      "v2/src"          inside
  st "v3/tests/front"            "v3/tests/front"  same
  # Reverse direction: the outer path is not inside the inner one. The containment test runs both
  # ways, and getting this backwards would refuse every pair that has any relation at all.
  st "a/b"                       "a/b/c"           outside
  # A one-segment name is the case a naive `${a#$b}` fix gets wrong.
  st "v3x"                       "v3"              outside
  st "v3/x"                      "v3"              inside
  echo
  [ "$st_fail" = 0 ] && echo "== pre-push self-test: PASS ==" || echo "== pre-push self-test: FAIL =="
  exit "$st_fail"
fi

remote_tip=""
local_tip=""
while read -r _local_ref local_sha remote_ref remote_sha; do
  [ "$remote_ref" = "refs/heads/main" ] || continue
  [ "$local_sha" = "0000000000000000000000000000000000000000" ] && continue   # branch delete
  local_tip="$local_sha"
  remote_tip="$remote_sha"
done

# Nothing aimed at main (or nothing to compare against) — not our business.
[ -n "$local_tip" ] || exit 0
case "$remote_tip" in ""|0000000000000000000000000000000000000000) exit 0 ;; esac

# ── an orphaned `fixed-in:` must not reach main ──────────────────────────────────────────────────
#
# `tests/e2e/bugs-index-gate.sh` already refuses a `fixed-in:` sha that is not an ancestor of HEAD —
# but it runs in SMOKE, which is AFTER the push, so the first people to learn are everyone else.
# THREE entries did this in two days (`rust-backend-two-tests-red…`,
# `lower-has-six-hand-written-Expr-walkers…`, `smoke-suite-over-its-own-budget`), each turning the
# suite red for the whole repository until its owner noticed.
#
# THE CAUSE IS STRUCTURAL, NOT CARELESSNESS, which is why a line in a document would not have helped:
# the sha is written into the entry in the same commit as the fix, and the rebase-and-push loop then
# REWRITES that commit. The value was true when it was typed. Closing the entry in a SECOND commit,
# after the fix has landed, is what survives — and the message says so, because a guard that only
# refuses teaches `--no-verify`.
#
# PLACED HERE, ABOVE THE CLAIM-OVERLAP CHECKS, and that position was found by a control rather than
# chosen. The first version sat at the END of the file, below `[ -n "$incoming" ] || exit 0` — the
# early exit for a push that adds no claim file — so it ran only when the same push happened to add
# a claim, which is almost never. Its first "it refuses" test passed only because that branch
# carried a claim-update commit. **A guard downstream of an early exit is a guard that does not run**,
# and the way that was caught was asking the opposite question: does a push it should IGNORE come
# back clean, and does the one it should catch still get caught from a branch that carries nothing
# else?
#
# ONLY THE SHAS THIS PUSH ADDS are checked. A pre-existing orphan on main belongs to another entry,
# and blocking unrelated work on it would make the guard the problem.
# JUDGE ONLY A PUSH THAT COULD LAND. If the remote tip is not an ancestor of what is being pushed,
# git will refuse it as a non-fast-forward anyway, and every sha already on main then looks like an
# orphan of THIS branch — which is a false refusal on a stale branch, before the rebase that would
# have made it right. Caught by the control: a perfectly valid ancestor sha was refused from a
# branch that had simply not been rebased yet. A guard that refuses correct work teaches
# `--no-verify`, and this hook's own comments say that is the habit that lets the next real problem
# through.
if git merge-base --is-ancestor "$remote_tip" "$local_tip" 2>/dev/null; then
orphans=""
while read -r fx; do
  [ -n "$fx" ] || continue
  git cat-file -e "$fx^{commit}" 2>/dev/null || continue      # unknown here: not this hook's call
  git merge-base --is-ancestor "$fx" "$local_tip" 2>/dev/null && continue
  orphans="$orphans  $fx
"
done <<EOF
$(git diff "$remote_tip" "$local_tip" -- '*BUGS.md' 2>/dev/null \
   | sed -n 's/^+.*fixed-in:[[:space:]]*\([0-9a-f]\{7,40\}\).*/\1/p' | LC_ALL=C sort -u)
EOF

if [ -n "$orphans" ]; then
  cat >&2 <<EOF

✋ pre-push: a \`fixed-in:\` sha you are adding is not an ancestor of what you are pushing.

$orphans
It exists in your object store but not in this history — the classic shape is that you wrote it into
the entry in the SAME commit as the fix, and the rebase-and-push loop then rewrote that commit. The
value was true when you typed it.

What survives a rebase: land the change first, read the sha back with \`git rev-parse\`, and close
the entry in a SECOND commit. Three entries turned SMOKE red for the whole repository this way in
two days, which is why this is refused here instead of discovered after it lands.

Override (rarely correct): git push --no-verify
EOF
  exit 1
fi
fi

# Field lookup: `items:`/`paths:` from a claim blob, whitespace-separated.
field() { # field <sha>:<path> <name>
  git show "$1" 2>/dev/null | sed -n "s/^$2:[[:space:]]*//p" | head -1
}

# Same fields, but from the LEDGER row — the mutex's authoritative active scope
# (`.work/active/LEDGER.tsv`, columns: slug agent started items paths).
ledger_field() { # ledger_field <sha> <slug> <items|paths>
  git show "$1:.work/active/LEDGER.tsv" 2>/dev/null |
    awk -F'\t' -v s="$2" -v w="$3" '$1 == s { print (w == "items" ? $4 : $5); exit }' || true
}

# Order-insensitive normal form, so "A B" and "B A" are the same declaration.
norm() { tr ' \t' '\n\n' | sed '/^$/d' | LC_ALL=C sort -u | tr '\n' ' ' | sed 's/ *$//'; }

# ─────────────────────────────────────────────────────────────────────────────
# Scope is stored TWICE — in the ledger row and in the `.claim` — and nothing used to check that the
# two agree. The guard read only the `.claim`, so a claim whose LEDGER row declared a path its
# `.claim` did not was invisible here and a rival claiming that exact path was let through
# (BUGS.md `claim-ledger-claimfile-scope-drift`, observed at `0fade8820`). Duplicated state with no
# consistency check does not stay consistent.
#
# Two rules, and they are deliberately different because the pusher can only fix one of them:
#
#   1. A claim THIS PUSH adds or rewrites must agree with its own ledger row. Refused — you are the
#      one who can fix it, and the alternative is that the hole is created right here.
#   2. A claim already on the remote that disagrees with its row is compared on the UNION of both
#      declarations, and named in a warning. Union is the fail-CLOSED reading: the widest declared
#      scope wins, so neither copy can hide work. Refusing instead would let one agent's stale row
#      block every other agent, which is how a mutex turns into a deadlock.
claim_scope() { # claim_scope <sha> <claim-path> <slug> <items|paths>  → union of both copies
  printf '%s %s' "$(field "$1:$2" "$4")" "$(ledger_field "$1" "$3" "$4")" | norm
}

# Claims this push ADDS (or rewrites) relative to the remote tip.
incoming=$(git diff --name-only --diff-filter=AM "$remote_tip" "$local_tip" -- '.work/active/*.claim' 2>/dev/null || true)
[ -n "$incoming" ] || exit 0

# Claims already live on the remote tip.
live=$(git ls-tree -r --name-only "$remote_tip" -- .work/active/ 2>/dev/null | grep '\.claim$' || true)
[ -n "$live" ] || exit 0

# ─────────────────────────────────────────────────────────────────────────────
# Shared bookkeeping files are EXEMPT from the overlap comparison.
#
# Layer 3 (pre-commit) already exempts exactly this set — "every task touches these by design" —
# but layer 2 did not, so a claim that merely NAMED SPRINT.md was refused as an overlap. The two
# layers disagreed about the same files, and the result was that a finished task could not be
# ticked off: on 2026-07-27 four completed items sat open on the board because nobody could commit
# the tick, which is the exact drift this mutex exists to prevent.
#
# These files are line-oriented and append-mostly; two agents editing different lines rebase
# cleanly. The overlap guard is for WORK, not for the notebook the work is recorded in — an item
# claimed twice is still caught by `items:`, which is the check that actually matters.
is_shared_bookkeeping() {
  # Match the BASENAME, not the whole scope. The per-module split (specs/work-tracking-layout.md)
  # moved bookkeeping into `v2/SPRINT.md`, `scripts/BACKLOG.md`, `tests/conformance/BUGS.md` and so
  # on — and this function used to compare bare basenames against the FULL scope string, so it
  # exempted only the ROOT files. Every module board silently became an ordinary claimable path.
  #
  # That is the exact serialisation the shared set exists to prevent, restored one level down:
  # work-tracking-layout.md says the root files had to be shared "precisely because a per-file mutex
  # would serialise the whole project", and a module board inherits that property the moment it
  # becomes where work is written. Measured 2026-07-30: a live claim held `scripts/BACKLOG.md`, so a
  # second agent could not even record that it was blocked.
  #
  # A bookkeeping file is append-mostly by many agents BY DESIGN. A rebase conflict there is cheap;
  # a refusal is not.
  case "${1##*/}" in
    SPRINT.md|BACKLOG.md|CHANGELOG.md|BUGS.md|MILESTONES.md|README.md) return 0 ;;
    *) return 1 ;;
  esac
}

# Rule 1 — a claim this push touches must agree with its own ledger row.
drift=""
# ── scope-level helpers (specs/claim-mutex.md §Hierarchy) ──────────────────────────────────────
# A scope is `<level>:<path>`, or a bare path meaning the legacy subtree level.
scope_level() {
  case "$1" in
    repo:*|repo) printf 'repo' ;;
    mod:*)       printf 'mod'  ;;
    file:*)      printf 'file' ;;
    *)           printf 'mod'  ;;   # unprefixed = subtree, exactly the pre-2026-07-30 meaning
  esac
}
scope_path() {
  local v="${1#repo:}"; v="${v#mod:}"; v="${v#file:}"
  while [ "${v%\*}" != "$v" ]; do v="${v%\*}"; done   # normalise trailing globs
  printf '%s' "${v%/}"
}



# Does the broad claim `$1` (whose scopes are `$2`) actually hold file `$3`?
#
# Declared: the file appears verbatim among its scopes.
# Modified: its worktree has the file dirty, or its branch changed the file since the claim started.
#
# FAIL-CLOSED. If the owner's worktree is absent, or its start timestamp cannot be read, or git
# errors, the answer is YES (held) — an undecidable case must refuse, never admit. Weakening the
# mutex to gain parallelism is how two agents end up doing the same work, which is the whole thing
# specs/claim-mutex.md exists to stop.
owner_holds_file() {
  local slug="$1" scopes="$2" want="$3" wt started base
  for sc in $scopes; do
    [ "$(scope_path "$sc")" = "$want" ] && return 0      # declared explicitly
  done
  wt="$(dirname "$(git rev-parse --show-toplevel)")/$(basename "$(git rev-parse --show-toplevel)" | sed 's/-wt-.*//')-wt-$slug"
  [ -d "$wt" ] || return 0                               # cannot look ⇒ refuse
  git -C "$wt" status --porcelain -- "$want" 2>/dev/null | grep -q . && return 0
  started="$(field "$remote_tip:.work/active/$slug.claim" started 2>/dev/null)"
  [ -n "$started" ] || return 0                          # cannot date it ⇒ refuse
  base="$(git rev-list -1 --before="$started" origin/main 2>/dev/null)"
  # No commit precedes the claim's start (a very old or hand-written timestamp): fall back to the
  # root commit, i.e. "everything ever" counts as touched. Conservative on purpose — it can only
  # ADD refusals, never remove one.
  [ -n "$base" ] || base="$(git rev-list --max-parents=0 origin/main 2>/dev/null | tail -1)"
  [ -n "$base" ] || return 0
  git -C "$wt" diff --name-only "$base"..HEAD -- "$want" 2>/dev/null | grep -q . && return 0
  git diff --name-only "$base"..origin/main -- "$want" 2>/dev/null | grep -q . && return 0
  return 1                                               # neither declared nor touched ⇒ admit
}

for new in $incoming; do
  new_slug=$(basename "$new" .claim)
  c_items=$(field "$local_tip:$new" items | norm)
  c_paths=$(field "$local_tip:$new" paths | norm)
  l_items=$(ledger_field "$local_tip" "$new_slug" items | norm)
  l_paths=$(ledger_field "$local_tip" "$new_slug" paths | norm)
  # Declaring nothing ANYWHERE stays allowed — that is the documented backward-compatible claim.
  if [ -n "$c_items$c_paths$l_items$l_paths" ]; then
    if [ "$c_items" != "$l_items" ]; then
      drift="$drift\n  '$new_slug' items disagree:\n    .claim : ${c_items:-<none>}\n    ledger : ${l_items:-<none>}"
    fi
    if [ "$c_paths" != "$l_paths" ]; then
      drift="$drift\n  '$new_slug' paths disagree:\n    .claim : ${c_paths:-<none>}\n    ledger : ${l_paths:-<none>}"
    fi
  fi
done

if [ -n "$drift" ]; then
  cat >&2 <<EOF

✋ pre-push: a claim disagrees with its LEDGER row.
$(printf '%b' "$drift")

Scope lives in BOTH .work/active/<slug>.claim and the LEDGER row, and the overlap guard needs them
to say the same thing — a path declared in only one copy is a hole another agent can claim through
(specs/claim-mutex.md; BUGS.md claim-ledger-claimfile-scope-drift). Update the copy you changed by
hand so both match, then push again.

Override (rarely correct): git push --no-verify
EOF
  exit 1
fi

problems=""
warnings=""
for new in $incoming; do
  new_slug=$(basename "$new" .claim)
  case "$new_slug" in verify-*) continue ;; esac          # deliberate re-verification
  new_items=$(claim_scope "$local_tip" "$new" "$new_slug" items)
  new_paths=$(claim_scope "$local_tip" "$new" "$new_slug" paths)
  [ -n "$new_items$new_paths" ] || continue               # undeclared → nothing to compare (compat)

  for old in $live; do
    old_slug=$(basename "$old" .claim)
    [ "$old_slug" = "$new_slug" ] && continue             # same slug: a re-write of one's own claim
    # Rule 2 — the remote copy may be inconsistent and is not this push's to repair; compare on the
    # UNION so neither copy can hide work, and say so rather than fail on someone else's drift.
    old_items=$(claim_scope "$remote_tip" "$old" "$old_slug" items)
    old_paths=$(claim_scope "$remote_tip" "$old" "$old_slug" paths)
    if [ "$(field "$remote_tip:$old" paths | norm)" != "$(ledger_field "$remote_tip" "$old_slug" paths | norm)" ]; then
      case "$warnings" in
        *"'$old_slug'"*) : ;;
        *) warnings="$warnings\n  note: live claim '$old_slug' disagrees with its ledger row; compared on the union of both" ;;
      esac
    fi

    for i in $new_items; do
      for j in $old_items; do
        [ "$i" = "$j" ] && problems="$problems\n  item '$i' is already claimed by '$old_slug'"
      done
    done
    # ── Scope comparison, LEVEL-AWARE ────────────────────────────────────────────────────────────
    #
    # A scope may carry a level prefix (specs/claim-mutex.md §Hierarchy):
    #   repo:            the whole repository
    #   mod:<path>       a module subtree — requires a `broad:` justification in the claim
    #   file:<path>      exactly one file
    #   <path>           legacy, unprefixed: treated as a subtree, exactly as before
    #
    # WHY THE LEVELS EXIST, measured 2026-07-30 on a single live claim:
    #
    #     v2/src 1109 files reserved / 3 changed in two days      v2/backend  387 / 2
    #     bench   113 / 0     v2/backend-jvm-bytecode  83 / 1     v2/jvm-runtime 56 / 1
    #     v2/lib   29 / 2                            total 1777 reserved, 9 changed  → 99.4% dead
    #
    # ⚠ And the honest caveat, because it decides what this change may and may not do: BOTH blocks
    # that claim caused were CORRECT — the file wanted (`v2/lib/ssc1-front.ssc0`) is genuinely one of
    # the 2 that changed. So this is not about undoing false refusals that happened; it is about the
    # 1768 files that would refuse someone else for nothing. The mutex therefore must not weaken:
    # a narrower scope is admitted only when the broad owner has NOT declared and has NOT touched it,
    # and anything undecidable stays REFUSED.
    for p in $new_paths; do
      p_lvl=$(scope_level "$p"); p_path=$(scope_path "$p")
      is_shared_bookkeeping "$p_path" && continue
      for q in $old_paths; do
        q_lvl=$(scope_level "$q"); q_path=$(scope_path "$q")
        is_shared_bookkeeping "$q_path" && continue

        # Same path at any level, or either side claiming the whole repo: always a conflict.
        if [ "$p_lvl" = repo ] || [ "$q_lvl" = repo ] || [ "$p_path" = "$q_path" ]; then
          [ "$p_path" = "$q_path" ] && [ "$p_lvl" = file ] && [ "$q_lvl" = file ] \
            && problems="$problems\n  file '$p_path' is already claimed by '$old_slug'" \
            || problems="$problems\n  scope '$p' conflicts with '$q', claimed by '$old_slug'"
          continue
        fi

        # A FILE inside someone's MODULE: admitted only if that owner neither declared nor touched it.
        if [ "$p_lvl" = file ] && [ "$q_lvl" != file ]; then
          case "$(path_rel "$p_path" "$q_path")" in inside)
            if owner_holds_file "$old_slug" "$old_paths" "$p_path"; then
              problems="$problems\n  file '$p_path' is inside '$q' AND '$old_slug' has it declared-or-modified"
            else
              warnings="$warnings\n  note: '$p_path' is inside '$q' ('$old_slug') but that claim has neither declared nor modified it — admitted as a co-tenant file scope"
            fi ;;
          esac
          continue
        fi

        # Everything else keeps the original prefix-containment rule in both directions.
        case "$(path_rel "$p_path" "$q_path")" in inside) problems="$problems\n  path '$p_path' falls inside '$q_path', claimed by '$old_slug'" ;; esac
        case "$(path_rel "$q_path" "$p_path")" in inside) problems="$problems\n  path '$p_path' contains '$q_path', claimed by '$old_slug'" ;; esac
      done
    done
  done
done

if [ -n "$problems" ]; then
  cat >&2 <<EOF

✋ pre-push: this claim overlaps a live claim on origin/main.
$(printf "$problems")

Two agents doing the same work under different slugs is exactly what this guard exists to stop
(specs/claim-mutex.md). Before pushing, either:
  - pick different work:            git ls-tree origin/main .work/active/
  - triage the other claim first:   /multi-agent triage <slug>     (stale heartbeat ⇒ release it)
  - or, if you are DELIBERATELY re-checking that agent's result, name your claim 'verify-<slug>' —
    that is allowed, and is how a live corruption bug was caught on 2026-07-27.

Note: SPRINT.md / BACKLOG.md / CHANGELOG.md / BUGS.md / MILESTONES.md / README.md are SHARED and are
never an overlap — if one of those is in the list above, this hook has a bug.

Override (rarely correct): git push --no-verify
EOF
  exit 1
fi
if [ -n "$warnings" ]; then
  printf '%b\n' "$warnings" >&2
fi
exit 0
