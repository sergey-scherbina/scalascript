#!/usr/bin/env bash
#
# coord-claim — claim a task atomically, BEFORE planning it (specs/claim-mutex.md).
#
#   scripts/coord-claim <slug> --items "<id> [<id>…]" --paths "<prefix> […]" [--agent <id>]
#   scripts/coord-claim … --dry-run     validate and print, write and push nothing
#
# Writes `.work/active/<slug>.claim`, adds the matching `.work/active/LEDGER.tsv` line and bumps the
# ledger's generation counter, then commits and pushes to origin/main in ONE commit.
#
# Why the generation bump matters: it is what makes two concurrent claims collide. Without it each
# claim writes a disjoint file, so the loser of the push race rebases cleanly and never learns the
# winner exists — which is exactly how two agents did the same work twice on 2026-07-27.
#
# On a rejected push this does NOT auto-rebase: it stops and tells you to re-read the queue, because
# "the push was rejected" means someone else moved first and your plan may now be wrong.
set -euo pipefail

# ── --self-test — the claim file and the LEDGER row must describe the same scope ─────────────────
#
# `3325b91e3` fixed a defect that made every `mod:`/`repo:` claim unusable: `--broad`'s reason was
# written as `${broad:+\nbroad: …}` INSIDE A QUOTED HEREDOC, where `\n` is two literal characters, so
# the justification landed on the end of the `paths:` line. The pre-push guard then compared that
# line with the ledger's paths column, they disagreed, and the push was refused — for exactly the
# scopes that require the flag.
#
# It had no gate, so the fix was one edit away from coming back and the BUGS entry stayed open long
# enough that the next reader (me) started to fix it again. This asserts the property the guard
# actually checks, and it carries its own negative control: the OLD form is re-created here and must
# be detected as disagreeing, so a green from this cannot mean "the check does not look".
# ── `--items` are IDS, and the guard compares them as TOKENS ──────────────────────────────────────
#
# The pre-push overlap guard splits every live claim's `items:` on whitespace and compares the
# tokens, so a sentence here RESERVES EACH OF ITS WORDS. A later claim is then refused with
# `item 'the' is already claimed by …`, which reads as nonsense until you know items are tokenised —
# and the symptom, a rejected push, is exactly what a real race looks like. Measured 2026-08-04: four
# attempts in one session were misdiagnosed as contention and retried, which the refusal explicitly
# says will not help. Worse, prose is ACCEPTED whenever its words happen not to collide, so the trap
# fires at random and gets rarer as claims are released — the worst schedule for learning it exists.
#
# Refusing it HERE is the only place the message can be actionable: at push time the claim is already
# written and the reader is looking at a word, not at their own sentence.
#
# The rule is "contains a hyphen, underscore, slash or digit", which is what every id in use looks
# like — BUGS slugs are kebab-case and SPRINT ids carry digits. Measured over 200 revisions of the
# ledger: 37 of 257 distinct claims would have been refused, 14%, every one of them prose.
bad_item_tokens() {
  _bad=""
  for _it in $1; do
    case "$_it" in
      [A-Za-z0-9]*) case "$_it" in *[-_/0-9]*) ;; *) _bad="$_bad $_it" ;; esac ;;
      *) _bad="$_bad $_it" ;;
    esac
  done
  printf '%s' "${_bad# }"
}

if [ "${1:-}" = "--self-test" ]; then
  fails=0

  # A comma list must reach the ledger as a SPACE list, because both guards split `paths:` on
  # whitespace. Before this normalisation a comma-joined claim stored one unsplittable token and
  # refused every file it had itself declared. Asserted on the same transformation the flag applies.
  _comma="file:a/b.scala,file:c/d.scala,dir:e/f"
  _normalised="$(printf '%s' "$_comma" | tr ',' ' ')"
  if [ "$_normalised" = "file:a/b.scala file:c/d.scala dir:e/f" ]; then
    echo "  ok   --paths normalises a comma list to spaces (both guards split on whitespace)"
  else
    echo "  FAIL --paths comma normalisation gave [$_normalised]"; fails=$((fails + 1))
  fi
  # And each scope prefix the guards strip must survive that normalisation as its own token —
  # `dir:` included, which neither guard stripped until 2026-08-30.
  _count=0
  for _p in $_normalised; do _count=$((_count + 1)); done
  if [ "$_count" -eq 3 ]; then
    echo "  ok   the normalised list splits into 3 scope tokens"
  else
    echo "  FAIL normalised list split into $_count tokens, expected 3"; fails=$((fails + 1))
  fi

  _paths="mod:v3/tests/jit file:BUGS.md"
  _broad="a subtree because the fixtures are generated together"

  _line=""
  if [ -n "$_broad" ]; then _line="
broad: $_broad"; fi
  _claim="$(printf 'items: X\npaths: %s%s\nscope: |\n' "$_paths" "$_line")"
  _got="$(printf '%s\n' "$_claim" | sed -n 's/^paths: //p')"
  if [ "$_got" = "$_paths" ]; then
    echo "  ok   paths: matches the ledger column with --broad set"
  else
    echo "  FAIL paths: [$_got] but the ledger records [$_paths]"; fails=$((fails + 1))
  fi
  if [ "$(printf '%s\n' "$_claim" | sed -n 's/^broad: //p')" = "$_broad" ]; then
    echo "  ok   broad: is a line of its own"
  else
    echo "  FAIL broad: is not on its own line"; fails=$((fails + 1))
  fi

  # The negative control: the pre-3325b91e3 spelling, which must be caught.
  _bad="$(printf 'items: X\npaths: %s\\nbroad: %s\nscope: |\n' "$_paths" "$_broad")"
  if [ "$(printf '%s\n' "$_bad" | sed -n 's/^paths: //p')" = "$_paths" ]; then
    echo "  FAIL the check passes the OLD buggy form too — it is not comparing what it claims to"
    fails=$((fails + 1))
  else
    echo "  ok   the old form (a literal \\n in the heredoc) is detected as disagreeing"
  fi

  # ── --items must be ids, not prose ──────────────────────────────────────────────────────────────
  # Three assertions, and the third is the one that makes the first two mean something: a check that
  # rejected everything would satisfy "prose is refused" while being useless.
  _prose="a top-level val whose initializer calls a std intrinsic"
  _got="$(bad_item_tokens "$_prose")"
  if [ -n "$_got" ]; then
    echo "  ok   prose --items is refused, naming [$_got]"
  else
    echo "  FAIL prose --items was accepted, so the guard will reserve its words"; fails=$((fails + 1))
  fi

  # Every id shape actually in use. If this ever fails, the rule is refusing real work, which is a
  # far worse failure than the one it prevents.
  _ids="map-getorelse-expr-receiver SSC3-J1c P4b-4 mcp-2026-07-28 v2/BUGS.md E-4 smoke_budget"
  _got="$(bad_item_tokens "$_ids")"
  if [ -z "$_got" ]; then
    echo "  ok   real ids pass: slugs, SPRINT ids, dated ids, paths, underscores"
  else
    echo "  FAIL the rule refuses ids that are in use: [$_got]"; fails=$((fails + 1))
  fi

  # The negative control for the negative control: a token that is prose-shaped BUT sits next to
  # valid ids must still be caught. A rule that only looked at the first token would pass the first
  # assertion above and miss the real case, where a sentence follows a legitimate id.
  _got="$(bad_item_tokens "E-4 outline the arm fallback")"
  case " $_got " in
    *" the "*) echo "  ok   a sentence AFTER a valid id is still caught" ;;
    *) echo "  FAIL only the first token is examined — [$_got]"; fails=$((fails + 1)) ;;
  esac

  echo
  if [ "$fails" = 0 ]; then echo "coord-claim --self-test: OK (6 checks, two negative controls among them)"; exit 0; fi
  echo "coord-claim --self-test: $fails FAILED"; exit 1
fi

slug=""; items=""; paths=""; broad=""; dryrun=0; agent="${SSC_AGENT_ID:-claude-code}"
while [ $# -gt 0 ]; do
  case "$1" in
    --items) items="$2"; shift 2 ;;
    # A COMMA-separated list is normalised to spaces rather than stored verbatim. Both guards split
    # `paths:` with an unquoted `for p in $paths` — whitespace, by design and documented in
    # pre-push's own header — so a comma list arrived as ONE token matching nothing, and every file
    # in the claim was refused as "outside" while the refusal printed the very paths it would not
    # match. Silent, and the message pointed away from the cause.
    #
    # Measured 2026-08-30: claim `v3-lexer-annotations` declared four comma-joined paths, could not
    # commit any of them, and only got through by narrowing to a single `mod:v3` token. Normalising
    # HERE rather than teaching both hooks a second separator keeps one vocabulary on both sides —
    # the rule this file's own history keeps re-learning (see the `repo:`/`mod:`/`file:` notes in
    # .githooks/pre-commit). scripts/BUGS.md `claim-path-comma-separator-and-dir-prefix`.
    --paths) paths="$(printf '%s' "$2" | tr ',' ' ')"; shift 2 ;;
    --broad) broad="$2"; shift 2 ;;
    --agent) agent="$2"; shift 2 ;;
    --dry-run) dryrun=1; shift ;;
    -*) echo "unknown flag: $1" >&2; exit 2 ;;
    # A SECOND bare word is refused instead of winning. `--items` and `--paths` each take exactly one
    # argument — a quoted list — so writing `--items A B` unquoted leaves `B` as a positional, and the
    # old catch-all assigned it over the slug with no complaint: last bare word won.
    #
    # Measured 2026-07-30: `coord-claim v2-diverge-dsl-parsers --items A B` created a claim named after
    # B. It printed `✓ claimed <B>` and exited 0, so the only signal was a slug the caller never typed.
    # Same failure shape as the `$root` outage in `bfbc42fe6`: the tool did the wrong thing quietly.
    *) if [ -n "$slug" ]; then
         printf 'refusing: two positional arguments — slug "%s", then "%s".\n' "$slug" "$1" >&2
         printf '\n--items and --paths take ONE argument each, so a multi-value list must be QUOTED:\n' >&2
         printf '  scripts/coord-claim %s --items "id-one id-two" --paths "file:a file:b"\n' "$slug" >&2
         printf '\nUnquoted, the extra words become positionals and the last one used to overwrite the\n' >&2
         printf 'slug — a claim under a name you did not choose is worse than a refusal.\n' >&2
         exit 2
       fi
       slug="$1"; shift ;;
  esac
done

# THE VOCABULARY IS CLOSED, and an entry outside it is refused HERE rather than being carried into
# the guards, which cannot tell it from a real scope. Measured 2026-08-06 against pre-push's own
# `scope_level`/`scope_path`, three shapes, each one plausible typo away and each SILENT:
#
#   dir:a/b   flie:a/b   -> level=mod, path "dir:a/b" — a path no file can ever match, so the scope
#                           is EMPTY: it reads as a claim to a human and protects nothing, and a
#                           second agent can take the same files with no word from the overlap
#                           guard. That is the failure specs/claim-mutex.md exists to prevent.
#   mod:   file:   mod:/ -> path EMPTY. The containment test is `case $p_path in "$q_path"*`, so an
#                           empty path matches EVERYTHING: such a claim conflicts with every other
#                           claim and blocks the queue. The opposite failure, equally quiet.
#   repo:x               -> level repo, path ignored — a typo claims the whole repository.
#
# Refusing costs one line of the agent's time. Accepting costs a mutex.
# (scripts/BUGS.md coord-claim-accepts-an-unknown-path-prefix-and-both-guards-read-it-as-nothing.)
bad_scopes=""
for sc in $paths; do
  case "$sc" in
    repo)          ;;                                   # bare `repo` — the whole repository
    repo:)         ;;                                   # same, written with the colon
    repo:*)        bad_scopes="$bad_scopes $sc" ;;      # `repo:` takes no path; a typo would be silent
    mod:|file:)    bad_scopes="$bad_scopes $sc" ;;      # prefix with no path ⇒ matches everything
    mod:*|file:*)  ;;                                   # the two ordinary forms
    -*|*:*)        bad_scopes="$bad_scopes $sc" ;;      # any other prefix is not in the vocabulary
    *)             ;;                                   # unprefixed: legacy subtree, unchanged
  esac
done
if [ -n "$bad_scopes" ]; then
  printf 'refusing: these --paths entries are not scopes the guards understand:
' >&2
  for sc in $bad_scopes; do printf '  %s
' "$sc" >&2; done
  printf '
The vocabulary is exactly:
' >&2
  printf '  file:<path>   exactly one file      — the default, and what lets others work nearby
' >&2
  printf '  mod:<path>    a module subtree      — needs --broad "<reason>"
' >&2
  printf '  repo:         the whole repository  — needs --broad, and is almost never right
' >&2
  printf '  <path>        unprefixed = mod:<path>
' >&2
  printf '
An unrecognised prefix is not a narrower claim, it is NO claim: the overlap guard
' >&2
  printf 'compares it literally, nothing matches, and a second agent can take the same files.
' >&2
  exit 2
fi

# A subtree reservation must justify itself. Unprefixed paths are grandfathered so nothing that
# exists today breaks, but anything written as mod:/repo: from now on states why.
needs_broad=""
for sc in $paths; do
  case "$sc" in
    repo:*|repo) needs_broad="$needs_broad repo:" ;;
    mod:*)       needs_broad="$needs_broad $sc" ;;
  esac
done
if [ -n "$needs_broad" ] && [ -z "$broad" ]; then
  printf 'refusing: these scopes reserve whole subtrees and need --broad "<reason>":\n' >&2
  for sc in $needs_broad; do printf '  %s\n' "$sc" >&2; done
  printf '\nA subtree is often 1000+ files. Measured 2026-07-30: one claim reserved 1777 and 9\n' >&2
  printf 'changed in two days. Prefer file: scopes, or say why the subtree is needed.\n' >&2
  exit 2
fi

if [ -z "$slug" ] || [ -z "$items" ] || [ -z "$paths" ]; then
  cat >&2 <<'EOF'
usage: scripts/coord-claim <slug> --items "<id> …" --paths "<prefix> …" [--agent <id>]

  --items  SPRINT item ids and/or BUGS slugs — the WORK, not the name. This is what lets the
           pre-push guard notice a rival claim under a different slug.
  --paths  scopes this claim may touch, each optionally LEVEL-PREFIXED
           (specs/claim-mutex.md §Hierarchy):
             file:<path>   exactly one file      — prefer this; it is what lets others work nearby
             mod:<path>    a module subtree      — requires --broad "<reason>"
             repo:         the whole repository  — requires --broad, and is almost never right
             <path>        unprefixed = mod:<path>, unchanged from before
           Measured 2026-07-30: one claim reserved 1777 files and 9 of them changed in two days.
           A subtree is 1000+ files; asking for one costs a sentence.
  --broad  justification required by any mod:/repo: scope.

Claim FIRST, then plan: a claim is one cheap revocable commit, while planning takes minutes, and
that gap is the whole race window.
EOF
  exit 2
fi

_bad_items="$(bad_item_tokens "$items")"
if [ -n "$_bad_items" ]; then
  printf '\n✋ --items takes IDS, and these are not:  %s\n\n' "$_bad_items" >&2
  cat >&2 <<'EOF'
The pre-push overlap guard compares items as WHITESPACE-SEPARATED TOKENS across every live claim, so
a sentence here reserves each of its words. Someone's next claim is then refused with

  item 'the' is already claimed by '<your-slug>'

which reads as nonsense unless you already know items are tokenised — and a rejected push is exactly
what a real race looks like, so it costs minutes to diagnose. It also fires at RANDOM: prose is
accepted whenever its words happen not to collide, and gets rarer as claims are released, which is
the worst possible schedule for learning the trap exists.

An id is a BUGS slug or a SPRINT id — `map-getorelse-expr-receiver`, `SSC3-J1c`, `P4b-4`,
`mcp-2026-07-28`. They all carry a hyphen, underscore, slash or digit; that is the rule applied here.

THE SENTENCE IS NOT UNWANTED, IT IS IN THE WRONG FIELD. The claim file has `scope:` for exactly
this: free prose, never compared with anything. Put the ids in --items and the description there,
which is also what the next agent reads when deciding whether your work overlaps theirs.
EOF
  exit 2
fi

# ── --dry-run: validate and say what WOULD be written, touching nothing ───────────────────────────
# Added the same hour it was needed. Exercising the ACCEPT path of the check above meant running the
# real tool, which claimed `probe-slug` and pushed it to origin/main before I could stop it. A tool
# whose only mode is "do it" cannot be tested, so its accept path is the one nobody checks — which is
# the half that decides whether the refusal is over-eager.
if [ "$dryrun" = 1 ]; then
  printf 'dry-run: would claim %s\n' "$slug"
  printf '  items: %s\n' "$items"
  printf '  paths: %s\n' "$paths"
  [ -n "$broad" ] && printf '  broad: %s\n' "$broad"
  printf '  (nothing written, nothing pushed)\n'
  exit 0
fi

MAIN=$(git worktree list | head -1 | awk '{print $1}')
cd "$MAIN"

[ -d .git ] || { echo "✋ claim from the MAIN checkout, not a worktree (AGENTS.md)" >&2; exit 1; }
[ "$(git symbolic-ref --short HEAD)" = "main" ] || { echo "✋ main checkout must be on branch main" >&2; exit 1; }

git fetch -q origin
git merge --ff-only origin/main -q

claim=".work/active/${slug}.claim"
ledger=".work/active/LEDGER.tsv"

if git ls-tree -r --name-only origin/main -- .work/active/ | grep -Fxq "$claim"; then
  echo "✋ '${slug}' is already claimed on origin/main. Read it first:" >&2
  git show "origin/main:$claim" >&2
  exit 1
fi

# The `broad:` line is built HERE, with a real newline, because the heredoc below is QUOTED and a
# `\n` inside it is two literal characters. Written inline as `${broad:+\nbroad: ...}` the
# justification landed on the END OF THE `paths:` LINE, the pre-push guard then compared that line
# against the LEDGER's paths column, they disagreed, and every `--broad` claim was refused — which
# made `mod:` and `repo:` scopes unusable, i.e. exactly the scopes that require the flag.
broad_line=""
if [ -n "$broad" ]; then
  broad_line="
broad: $broad"
fi

ts=$(date -u +%Y-%m-%dT%H:%M:%SZ)
mkdir -p .work/active
[ -f "$ledger" ] || printf '# generation: 0\n#slug\tagent\tstarted\titems\tpaths\n' > "$ledger"

cat > "$claim" <<EOF
slug: ${slug}
branch: feature/${slug}
agent: ${agent}
started: ${ts}
heartbeat: ${ts}
status: claimed-before-planning
items: ${items}
paths: ${paths}${broad_line}
scope: |
  (fill in once planned — the claim exists first so the queue is reserved while you plan)
next: plan the task into SPRINT.md, then implement
EOF

SLUG="$slug" AGENT="$agent" TS="$ts" ITEMS="$items" PATHS="$paths" python3 - "$ledger" <<'PY'
import os, re, sys
p = sys.argv[1]
lines = [l for l in open(p).read().split("\n") if l.strip() != ""]
gen = int(re.search(r"# generation: (\d+)", lines[0]).group(1))
lines[0] = f"# generation: {gen + 1}"          # the bump IS the mutex — never drop it
lines.append("\t".join([os.environ["SLUG"], os.environ["AGENT"], os.environ["TS"],
                        os.environ["ITEMS"], os.environ["PATHS"]]))
open(p, "w").write("\n".join(lines) + "\n")
PY

git add "$claim" "$ledger"
# No board row is written, and that is no longer a gap: the in-flight list is GENERATED from
# `.work/active/` by `scripts/board`. THIS CLAIM IS THE BOARD ENTRY. A second copy in SPRINT.md is
# what cost 75% invisible work, a gate to watch the drift, and — when I tried to automate the copy —
# a coord-claim that aborted AFTER staging and left half-written claims for other agents. Keep
# `status:` and `next:` current instead; they are the only part a tool cannot derive.

git commit -q -m "claim: ${slug} (${items}) [skip ci]"

# Keep the push output. Swallowing it (the old `2>/dev/null`) meant an OVERLAP refusal from the
# pre-push guard and a plain generation race printed the SAME message — so an agent blocked by a real
# conflict was told to retry, and retried ~10 times before diagnosing it by reading the hook. A guard
# that cannot say WHY it refused is only half a guard.
push_log=$(mktemp)
if git push -q origin main >"$push_log" 2>&1; then
  echo "✓ claimed ${slug}  items='${items}'  paths='${paths}'"
  # A `file:` overlap is admitted as CO-TENANCY since 2026-08-11 rather than refused, and the hook
  # says so on stderr — which this used to throw away with the log. An admitted claim that quietly
  # shares a file with someone is the silent half of the relaxation, and silence is what makes a
  # relaxation indistinguishable from no guard at all.
  if grep -q 'CO-TENANT' "$push_log" 2>/dev/null; then
    printf '\n' >&2
    grep -A5 'CO-TENANT' "$push_log" >&2
    printf '\n' >&2
  fi
  rm -f "$push_log"
  echo "  now: scripts/new-worktree ${slug}   then plan it into SPRINT.md"
else
  if grep -q 'overlaps a live claim' "$push_log"; then
    cat >&2 <<EOF

✋ claim REFUSED — it overlaps a live claim. This is NOT a race; retrying will not help.

$(cat "$push_log")
EOF
  else
    cat >&2 <<EOF

✋ push rejected — another agent moved first (the queue generation advanced).

Deliberately NOT auto-rebasing: someone else changed the queue, so re-read it before deciding.
  git fetch origin && git ls-tree origin/main .work/active/
The local commit has ALREADY been rolled back, so this checkout is clean — just pick different
work, or re-run this command once the queue looks the way you expect.

$(sed -n '1,6p' "$push_log")
EOF
  fi
  # UNDO OUR OWN COMMIT. Leaving it behind is how a refused claim becomes everyone else's problem:
  # the commit stays in the SHARED main checkout, and the next agent to `git push origin main` from
  # here either drags a stranger's claim onto main or — more often — is refused for an overlap that
  # has nothing to do with their work. Measured 2026-07-31: FOUR occurrences in two days, two of them
  # blocking me, and the tool has been printing "reset this claim and redo it" as ADVICE the whole
  # time. Advice that nobody follows is not a mechanism.
  #
  # The undo is targeted, not `reset --hard origin/main`: this script does not require a clean tree,
  # so a hard reset would delete work that has nothing to do with the claim. It removes exactly what
  # was committed — the new claim file, and our edit to the ledger — and leaves everything else.
  if [ "$(git rev-parse HEAD)" != "$(git rev-parse origin/main)" ]; then
    git reset -q --mixed HEAD~1
    rm -f "$claim"
    git checkout -q -- "$ledger" 2>/dev/null || true
    echo "  (rolled back the local claim commit — the shared checkout is clean again)" >&2
  fi
  rm -f "$push_log"
  exit 1
fi
