#!/usr/bin/env python3
"""bugs-report — answer "what is open" from BUGS.md's headers, so nobody writes another awk.

Spec: specs/bugs-index.md.

    scripts/bugs-report                          # counts by status
    scripts/bugs-report --status open            # every open entry
    scripts/bugs-report --status open --lane native
    scripts/bugs-report --area front --status open
    scripts/bugs-report --v2                     # the v2 view (native + v2-jvm + v2-rust lanes)
    scripts/bugs-report --no-gate                # open entries with no regression gate named

Reads only the machine-readable header, never the prose — which is the point: the prose is written
for humans and says "fixed"/"done"/"resolved"/"still reproducing" in a dozen shapes, and every
hand-rolled query over it disagreed with the others.
"""
import argparse, pathlib, re, sys

FIELD = re.compile(r"([a-z-]+)\s*:\s*([^\n]+)")


def load(path):
    lines = pathlib.Path(path).read_text().split("\n")
    out, i = [], 0
    while i < len(lines):
        if lines[i].startswith("## "):
            head = lines[i][3:].strip()
            slug = head.split("—")[0].strip().split()[0] if head.split() else head
            blob = "\n".join(lines[i + 1: i + 14])
            m = re.match(r"\s*<!--(.*?)-->", blob, re.S)
            fields = {}
            if m:
                for fm in FIELD.finditer(m.group(1)):
                    fields[fm.group(1)] = fm.group(2).strip()
            out.append({"slug": slug, "title": head, **fields})
        i += 1
    return out


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--file", default=str(pathlib.Path(__file__).resolve().parent.parent / "BUGS.md"))
    ap.add_argument("--status")
    ap.add_argument("--lane")
    ap.add_argument("--area")
    ap.add_argument("--v2", action="store_true", help="lanes native, v2-jvm, v2-rust")
    ap.add_argument("--no-gate", action="store_true", help="only entries naming no gate")
    ap.add_argument("--count", action="store_true")
    a = ap.parse_args()

    rows = load(a.file)
    missing = [r for r in rows if "status" not in r]

    sel = rows
    if a.status: sel = [r for r in sel if r.get("status") == a.status]
    if a.lane:   sel = [r for r in sel if r.get("lane") == a.lane]
    if a.area:   sel = [r for r in sel if r.get("area") == a.area]
    if a.v2:     sel = [r for r in sel if r.get("lane") in ("native", "v2-jvm", "v2-rust")]
    if a.no_gate: sel = [r for r in sel if r.get("gate") in (None, "none")]

    if not (a.status or a.lane or a.area or a.v2 or a.no_gate):
        by = {}
        for r in rows: by[r.get("status", "MISSING-HEADER")] = by.get(r.get("status", "MISSING-HEADER"), 0) + 1
        print(f"{len(rows)} entries in {pathlib.Path(a.file).name}\n")
        for k in sorted(by, key=lambda k: -by[k]): print(f"  {k:16} {by[k]}")
        opens = [r for r in rows if r.get("status") == "open"]
        lanes, areas = {}, {}
        for r in opens:
            lanes[r.get("lane", "?")] = lanes.get(r.get("lane", "?"), 0) + 1
            areas[r.get("area", "?")] = areas.get(r.get("area", "?"), 0) + 1
        print(f"\n  open by lane: " + ", ".join(f"{k}={v}" for k, v in sorted(lanes.items(), key=lambda x: -x[1])))
        print(f"  open by area: " + ", ".join(f"{k}={v}" for k, v in sorted(areas.items(), key=lambda x: -x[1])))
        nog = [r for r in opens if r.get("gate") in (None, "none")]
        print(f"\n  open with NO gate named: {len(nog)} of {len(opens)}")
        if missing:
            print(f"\n  ⚠ {len(missing)} entries have no header — run tests/e2e/bugs-index-gate.sh")
        return 0

    if a.count:
        print(len(sel)); return 0
    for r in sel:
        g = r.get("gate", "-")
        print(f"{r.get('status','?'):8} {r.get('lane','?'):9} {r.get('area','?'):12} {r['slug'][:52]:54} {g}")
    print(f"\n{len(sel)} entr{'y' if len(sel)==1 else 'ies'}", file=sys.stderr)
    return 0


if __name__ == "__main__":
    sys.exit(main())
