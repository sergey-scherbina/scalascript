      |/// `client.listToolNames()` — the `name` of every tool the server advertises.
      |#[allow(dead_code)]
      |pub fn _mcp_client_list_tool_names(handle: i64) -> Vec<String> {
      |    match rpc(handle, "tools/list", serde_json::json!({})) {
      |        Some(r) => r.get("tools").and_then(|t| t.as_array()).map(|arr| {
      |            arr.iter()
      |               .filter_map(|t| t.get("name").and_then(|n| n.as_str()).map(|s| s.to_string()))
      |               .collect()
      |        }).unwrap_or_default(),
      |        None => Vec::new(),
      |    }
      |}
