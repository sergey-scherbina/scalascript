      |/// `client.listTools()` — the SDK-shaped member. Answers a `Value::List` of
      |/// `Value::Obj("ToolDescriptor", …)`, which the CALL SITE assembles into the real struct: the
      |/// type is generated code and this file cannot name it. The tag and the FIELD ORDER are the
      |/// contract with `case class ToolDescriptor(name, description, schema)`; the end-to-end gate
      |/// is what pins them, because nothing else can.
      |#[allow(dead_code)]
      |pub fn _mcp_client_list_tools(handle: i64) -> crate::value::Value {
      |    let arr = match rpc(handle, "tools/list", serde_json::json!({})) {
      |        Some(r) => r.get("tools").and_then(|t| t.as_array()).cloned().unwrap_or_default(),
      |        None    => Vec::new(),
      |    };
      |    crate::value::Value::List(arr.iter().map(|t| {
      |        crate::value::Value::Obj("ToolDescriptor", vec![
      |            crate::value::Value::Str(t.get("name").and_then(|n| n.as_str()).unwrap_or("").to_string()),
      |            crate::value::Value::Str(t.get("description").and_then(|d| d.as_str()).unwrap_or("").to_string()),
      |            json_to_value_map(t.get("inputSchema")),
      |        ])
      |    }).collect())
      |}
      |
      |/// `client.listResources()` — `case class ResourceDescriptor(uri, name, mimeType)`.
      |#[allow(dead_code)]
      |pub fn _mcp_client_list_resources(handle: i64) -> crate::value::Value {
      |    let arr = match rpc(handle, "resources/list", serde_json::json!({})) {
      |        Some(r) => r.get("resources").and_then(|t| t.as_array()).cloned().unwrap_or_default(),
      |        None    => Vec::new(),
      |    };
      |    crate::value::Value::List(arr.iter().map(|t| {
      |        crate::value::Value::Obj("ResourceDescriptor", vec![
      |            crate::value::Value::Str(t.get("uri").and_then(|n| n.as_str()).unwrap_or("").to_string()),
      |            crate::value::Value::Str(t.get("name").and_then(|n| n.as_str()).unwrap_or("").to_string()),
      |            crate::value::Value::Str(t.get("mimeType").and_then(|n| n.as_str()).unwrap_or("").to_string()),
      |        ])
      |    }).collect())
      |}
