//! MCP client runtime (R.6) — JSON-RPC 2.0 over a spawned server's stdio.
      |//! Emitted verbatim by RustGen when mcp-client intrinsics are reached.
      |//!
      |//! THE HANDLE IS AN i64 ON PURPOSE. `extern class McpClient` has no Rust type of its own —
      |//! `mapType` sends an unknown type name to `i64` — so a client is an index into a table
      |//! owned here. That is what lets every entry point below have a signature this file can
      |//! actually write: the alternative, naming `ToolResult` or `Transport`, is impossible from a
      |//! runtime because those types exist only once a program reaches them.
      |
      |use std::io::{BufRead, BufReader, Write};
      |use std::process::{Child, ChildStdin, ChildStdout, Command, Stdio};
      |use std::sync::{Arc, Mutex};
      |
      |pub struct McpClientConn {
      |    child:   Child,
      |    stdin:   ChildStdin,
      |    stdout:  BufReader<ChildStdout>,
      |    next_id: i64,
      |    open:    bool,
      |}
      |
      |static MCP_CLIENTS: std::sync::OnceLock<Arc<Mutex<Vec<Option<McpClientConn>>>>> =
      |    std::sync::OnceLock::new();
      |
      |fn mcp_clients() -> &'static Arc<Mutex<Vec<Option<McpClientConn>>>> {
      |    MCP_CLIENTS.get_or_init(|| Arc::new(Mutex::new(Vec::new())))
      |}
      |
      |/// One request/response round trip. `None` when the handle is unknown, closed, or the server
      |/// died mid-call — every caller below turns that into an empty answer rather than a panic,
      |/// because a server that exits is an ordinary condition for a client.
      |fn rpc(handle: i64, method: &str, params: serde_json::Value) -> Option<serde_json::Value> {
      |    let table = mcp_clients();
      |    let mut guard = table.lock().unwrap();
      |    let slot = guard.get_mut(handle as usize)?;
      |    let conn = slot.as_mut()?;
      |    if !conn.open { return None; }
      |    conn.next_id += 1;
      |    let id = conn.next_id;
      |    let req = serde_json::json!({
      |        "jsonrpc": "2.0", "id": id, "method": method, "params": params
      |    });
      |    if writeln!(conn.stdin, "{}", req).is_err() { return None; }
      |    if conn.stdin.flush().is_err() { return None; }
      |    // Read until the reply carrying OUR id: a server may interleave notifications, which have
      |    // no id at all, and treating the first line as the answer would return one of those.
      |    loop {
      |        let mut line = String::new();
      |        match conn.stdout.read_line(&mut line) {
      |            Ok(0) | Err(_) => return None,
      |            Ok(_) => {}
      |        }
      |        if line.trim().is_empty() { continue; }
      |        let v: serde_json::Value = match serde_json::from_str(&line) {
      |            Ok(v) => v,
      |            Err(_) => continue,
      |        };
      |        if v.get("id").and_then(|i| i.as_i64()) == Some(id) {
      |            return v.get("result").cloned().or(Some(serde_json::Value::Null));
      |        }
      |    }
      |}
