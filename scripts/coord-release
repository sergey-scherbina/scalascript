#!/usr/bin/env bash
#
# coord-release <slug> --level <1|2|3> [--note "<what landed>"] — the counterpart to coord-claim.
#
# Step 5 of the board contract ("mark [x], delete the row, release the claim") was four manual edits
# in three files, and half-finished releases are why `.work/active/` and SPRINT.md drift. Measured
# 2026-07-30 before this existed: 4 live claims, 1 board row. This does all of it in ONE commit, the
# same way coord-claim now writes the row in one.
#
# Deliberately does NOT touch module SPRINT.md `[~]`→`[x]`: which item finished is a judgement the
# tool cannot make (a claim carries several), and guessing would put false `[x]` marks in a file
# people trust. It prints the reminder instead.
#
# `--level` is REQUIRED, and that is the point rather than an inconvenience. POLICY.md §P-6.7 says a
# release "must NAME which level of evidence it actually has"; before this, the flags were never
# parsed at all — `slug="$1"; extra="$2"` — so
#
#   scripts/coord-release <slug> --level 3 --note "contract green"
#
# put the literal string `--level` into the message and silently dropped the `3` and the note
# entirely. A required field that a tool quietly discards is an optional field, and the release
# record is exactly where the next agent looks to decide whether a result can be trusted. Refusing
# without it makes forgetting impossible instead of merely discouraged.
#
# The old positional form (`coord-release <slug> "<note>"`) still works so existing habits do not
# break — but it too now requires `--level`.
set -euo pipefail

usage() {
  cat >&2 <<'USAGE'
usage: scripts/coord-release <slug> --level <1|2|3> [--note "<what landed>" | --note-file <path>]
       scripts/coord-release <slug> --level <1|2|3> "<what landed>"

  --level  which CI evidence this release actually has (POLICY.md §P-6.7):
             1  scripts/ci-status --sha <landed-sha> exit 0
             2  the specific job that would catch this change, green — name it in --note
             3  local gates only — list them by name in --note
           `cancelled` is RED, never neutral, and never write "green" for a run with no verdict.
USAGE
}

slug=""; extra=""; level=""; note_from_file=""
while [ $# -gt 0 ]; do
  case "$1" in
    --level)
      [ $# -ge 2 ] || { echo 'coord-release: --level needs a value' >&2; usage; exit 2; }
      level="$2"; shift 2 ;;
    --note)
      [ $# -ge 2 ] || { echo 'coord-release: --note needs a value' >&2; usage; exit 2; }
      [ -z "$note_from_file" ] || { echo 'coord-release: use --note OR --note-file, not both' >&2; exit 2; }
      extra="$2"; shift 2 ;;
    # --note-file: the note comes from a FILE, byte for byte.
    #
    # WHY IT EXISTS. A release note is the durable record of a piece of work, it is long, and it is
    # full of `identifiers in backticks` because that is how this repo writes about code. Passed
    # inline as --note "…`foo`…" the shell runs the backticked text as a COMMAND and substitutes its
    # output — so the note that lands is missing words, and nobody notices until they read it back.
    # That has happened FIVE times here, once eating four words out of an already-pushed note that
    # then had to be amended and force-pushed.
    #
    # `--note "$(cat f)"` is safe and was the workaround, but it is a workaround: it requires every
    # caller to know the trap. A flag that takes a path removes the trap instead of documenting it.
    --note-file)
      [ $# -ge 2 ] || { echo 'coord-release: --note-file needs a path' >&2; usage; exit 2; }
      [ -z "$extra" ] || { echo 'coord-release: use --note OR --note-file, not both' >&2; exit 2; }
      [ -r "$2" ] || { printf 'coord-release: cannot read note file: %s\n' "$2" >&2; exit 2; }
      # Read with `cat`, not `$(<f)` plus re-quoting: command substitution strips trailing newlines
      # but performs NO further expansion on what it read, so the bytes reach `extra` unchanged.
      extra="$(cat -- "$2")"
      [ -n "$extra" ] || { printf 'coord-release: note file is empty: %s\n' "$2" >&2; exit 2; }
      note_from_file=1; shift 2 ;;
    # Fail CLOSED on anything unrecognised. Swallowing an unknown flag into the message is the
    # defect this rewrite exists to remove; a typo'd flag must stop the release, not decorate it.
    --*)
      printf 'coord-release: unknown option: %s\n' "$1" >&2; usage; exit 2 ;;
    *)
      if [ -z "$slug" ]; then slug="$1"
      elif [ -z "$extra" ]; then extra="$1"
      else printf 'coord-release: unexpected argument: %s\n' "$1" >&2; usage; exit 2
      fi
      shift ;;
  esac
done

[ -n "$slug" ] || { usage; exit 2; }
case "$level" in
  1|2|3) : ;;
  "")  echo 'coord-release: --level is required (POLICY.md §P-6.7: a release must NAME its evidence level)' >&2
       usage; exit 2 ;;
  *)   printf 'coord-release: --level must be 1, 2 or 3, got %q\n' "$level" >&2; usage; exit 2 ;;
esac

root="$(git rev-parse --show-toplevel)"
[ -d "$root/.git" ] || { echo 'coord-release: run from the SHARED checkout, not a worktree' >&2; exit 2; }
cd "$root"
git diff --quiet && git diff --cached --quiet || { echo 'coord-release: working tree is dirty' >&2; exit 2; }
git fetch -q origin && git merge --ff-only -q origin/main

claim=".work/active/${slug}.claim"
[ -f "$claim" ] || { echo "coord-release: no such claim: $claim" >&2; exit 2; }

# REFUSE TO ANNOUNCE WORK THAT IS NOT THERE. Until 2026-08-07 this tool fast-forwarded main and then
# never asked whether the claim's own work was reachable from it, so a release could write "Landed"
# over a branch whose push had been rejected. Observed that day on
# `uniml-corpus-floor-independent-oracle`: the push lost a non-fast-forward race, the caller had
# chained the steps on separate lines instead of with `&&` so nothing stopped, the claim came off the
# board and the branch was deleted — leaving the commit reachable only as a dangling object and the
# board asserting the opposite of what happened. Recovered with `git fsck`; the false record cannot
# be edited, which is the point. `scripts/BUGS.md`
# `coord-release-does-not-check-the-work-landed`.
#
# The caller-side fix is `&&` or `set -e`, and it is the right fix — but it is the caller's to
# remember, the failure is silent, and the damage lands on a board everyone reads. This guard does
# not depend on anyone remembering.
branch="$(sed -n 's/^branch: *//p' "$claim" | head -1)"
# Read while the claim still exists — it is `git rm`ed further down, and the module SPRINT lookup at
# the end needs the work ids, not just the slug. (scripts/BUGS.md module-sprint-item-written-by-nobody.)
claim_items="$(sed -n 's/^items: *//p' "$claim" | head -1)"
# Read here, not at message-composition time: the claim FILE is gone by then (it is what a release
# removes), and the first version of the sha derivation read it there and died with
# `sed: .work/active/<slug>.claim: No such file or directory`. The lab caught it; a live release
# would have failed after the work was already pushed.
claim_started="$(sed -n 's/^started: *//p' "$claim" | head -1)"
claim_scope="$(sed -n 's/^paths: *//p' "$claim" | head -1)"
if [ -z "$branch" ]; then
  # An old single-line claim carries no branch. Say so rather than passing quietly: a check that
  # cannot run must not look like a check that ran.
  echo "coord-release: NOTE — claim names no branch, cannot verify the work is on origin/main" >&2
elif ! git rev-parse --verify -q "refs/heads/$branch" >/dev/null; then
  # Already deleted. Ambiguous by construction — merged-and-deleted is normal, so refusing here would
  # break the ordinary order — but the silence is worth naming.
  echo "coord-release: NOTE — branch '$branch' is gone locally, cannot verify the work is on origin/main" >&2
else
  ahead="$(git rev-list --count "origin/main..$branch" 2>/dev/null || echo 0)"
  if [ "$ahead" != 0 ]; then
    if [ -n "${COORD_RELEASE_ALLOW_UNPUSHED:-}" ]; then
      echo "coord-release: NOTE — releasing with $ahead unpushed commit(s) on '$branch' (COORD_RELEASE_ALLOW_UNPUSHED set)" >&2
    else
      echo "coord-release: REFUSED — branch '$branch' has $ahead commit(s) that origin/main does not have." >&2
      echo "  Releasing now would record this as landed when it is not. Push first:" >&2
      echo "    git -C <worktree> fetch origin && git -C <worktree> rebase origin/main && git -C <worktree> push origin HEAD:main" >&2
      echo "  If the branch is deliberately being abandoned, say so: COORD_RELEASE_ALLOW_UNPUSHED=1" >&2
      exit 2
    fi
  fi
fi

git rm -q "$claim"

# Only `.work/` is touched, and that is now sufficient: removing the claim removes it from the
# generated board too. `.githooks/pre-commit` refuses paths outside `.work/` in the shared checkout,
# which used to block deleting the hand-written row — generating the board dissolved that blocker
# rather than needing it negotiated away.
SLUG="$slug" python3 - .work/active/LEDGER.tsv <<'PY_REL'
import os, sys
slug = os.environ["SLUG"]
ledger = sys.argv[1]

lines = open(ledger).read().rstrip("\n").split("\n")
out = []
for l in lines:
    if l.startswith("# generation:"):
        out.append("# generation: %d" % (int(l.split(":")[1]) + 1))
    elif l.startswith(slug + "\t"):
        continue
    else:
        out.append(l)
open(ledger, "w").write("\n".join(out) + "\n")
PY_REL

git add .work/active/LEDGER.tsv
# The level is IN the message, in a fixed position, so the record is greppable rather than prose to
# be re-read: `git log --grep='release-claim:' ` shows every release with the evidence it claimed.
# ── the shas this claim landed, derived rather than typed ─────────────────────────────────────────
#
# Measured 2026-08-11 over 45 days: 468 of 1107 release-claim messages — 43% — name no commit at all,
# so "what did this claim actually land?" is not answerable from the record. It was also what made a
# separate analysis expensive: attributing commits to claims recovered 1054 shas and still had to
# drop 1103 of 1246 candidate pairs for want of attribution.
#
# Derived from the branch, not from the author's memory: commits on `$branch` newer than where
# `origin/main` stood when the claim STARTED, restricted to the claim's own declared paths. The path
# filter is what separates this claim's work from the siblings' commits a rebase pulled onto the same
# branch — and since a `file:` scope became a co-tenancy, a co-tenant's commit can legitimately
# appear here, which is why the line says "touching this claim's scope" rather than "by me".
landed=""
if [ -n "$branch" ] && git rev-parse --verify -q "refs/heads/$branch" >/dev/null 2>&1; then
  base=""
  [ -n "$claim_started" ] && base="$(git rev-list -1 --before="$claim_started" origin/main 2>/dev/null || true)"
  scope_paths=""
  for sc in $claim_scope; do
    case "$sc" in repo:|repo) scope_paths=""; break ;; esac
    q="${sc#file:}"; q="${q#mod:}"; scope_paths="$scope_paths $q"
  done
  if [ -n "$base" ]; then
    # `--` with no paths would mean "no paths at all", not "every path"; guard it.
    if [ -n "$scope_paths" ]; then
      landed="$(git log --format=%h --abbrev=9 "$branch" --not "$base" -- $scope_paths 2>/dev/null | head -12 | tr '\n' ' ')"
    else
      landed="$(git log --format=%h --abbrev=9 "$branch" --not "$base" 2>/dev/null | head -12 | tr '\n' ' ')"
    fi
  fi
fi

msg="release-claim: ${slug} [evidence: level ${level}]"
[ -n "$extra" ] && msg="${msg} — ${extra}"
if [ -n "$landed" ]; then
  msg="${msg}

landed (commits on ${branch} touching this claim's scope): ${landed}"
fi
# THE SHA BEFORE THE COMMIT, because a refused push must not leave the commit behind.
#
# `scripts/coord-claim` learned this on 2026-08-07 and this script did not. The difference is not
# cosmetic: the shared checkout is ONE working tree for every agent, `coord-claim` pushes the whole
# of local `main`, and the pre-push guard validates every claim in `remote_tip..local_tip`. So a
# release commit parked here is refused for a stranger, and it blocks EVERY agent's next claim until
# somebody finds and removes it. BUGS `shared-main-is-one-working-tree-for-every-agent` recorded
# three such landmines in one day, all of this kind.
pre_release_sha="$(git rev-parse HEAD)"
git commit -q -m "${msg} [skip ci]"
push_log="$(mktemp "${TMPDIR:-/tmp}/coord-release-push.XXXXXX")"
if git push origin main >"$push_log" 2>&1; then
  rm -f "$push_log"
  echo "✓ released ${slug}: claim file and ledger row, one commit"
  # The item cannot be written HERE: `.githooks/pre-commit` refuses paths outside `.work/` in the
  # shared checkout, which is what keeps a release to one reviewable shape. So this NAMES the line to
  # mark, and when there is none it says so — most work arrives from a BUGS entry and has no sprint
  # item at all, and a standing instruction that is usually unactionable is how this step became a
  # wish. MEASURED 2026-08-08: 14 items sit at `[~]` across the module sprints, not one of them held
  # by a live claim, and at least eight say DONE in their own text.
  # scripts/BUGS.md module-sprint-item-written-by-nobody.
  sprint_hit=""
  for _f in $(git ls-files '*/SPRINT.md' 2>/dev/null); do
    [ -f "$_f" ] || continue
    for _needle in "$slug" $claim_items; do
      # `|| true`: with `pipefail` (set at the top), a `grep` that matches NOTHING makes the whole
      # pipeline non-zero, and under `set -e` the assignment then kills the script — which is exactly
      # what shipped: the release committed and pushed, printed its first line, and died before the
      # message this block exists to print. It went unnoticed because the run was piped through
      # `tail`, which masks the exit code. No match is the ORDINARY case here, not an error.
      _line="$(grep -n '^- \[~\]' "$_f" 2>/dev/null | grep -F "$_needle" | head -1 | cut -d: -f1 || true)"
      if [ -n "$_line" ]; then sprint_hit="$_f:$_line"; break; fi
    done
    [ -n "$sprint_hit" ] && break
  done
  if [ -n "$sprint_hit" ]; then
    echo "  STILL BY HAND: mark it [x] — $sprint_hit"
  else
    echo "  no module SPRINT item names this slug or its items — nothing to mark"
  fi
  echo "  (nothing to do for the in-flight list — scripts/board derives it from .work/active/)"
else
  # THE REFUSAL IS DIAGNOSED, NOT ASSUMED. This line used to say "main moved. Re-run after: git
  # fetch && git merge --ff-only" unconditionally — and the refusal that actually happens here is
  # usually the OTHER one: the pre-push guard rejecting a claim carried in `remote_tip..local_tip`
  # that belongs to somebody else. Fetching and merging does nothing for that, so the advice sent
  # the reader in a circle while their commit sat parked, blocking every agent's next claim.
  push_out="$(cat "$push_log" 2>/dev/null || true)"
  printf '%s\n' "$push_out" >&2
  case "$push_out" in
    *non-fast-forward*|*"fetch first"*|*"Updates were rejected"*)
      echo "coord-release: push refused — main moved. Re-run after: git fetch && git merge --ff-only origin/main" >&2 ;;
    *pre-push*|*"already claimed"*|*"✋"*)
      echo "coord-release: push refused by the pre-push guard, and it may not be about YOUR claim." >&2
      echo "  The shared checkout pushes all of local main, so a commit somebody else parked here is" >&2
      echo "  validated too. Look at what is riding along, and ask its owner in the room:" >&2
      echo "    git log origin/main..HEAD --oneline" >&2
      echo "  Release from a worktree instead, which carries only your commit:" >&2
      echo "    git -C <worktree> fetch origin && git -C <worktree> rebase origin/main && git -C <worktree> push origin HEAD:main" >&2 ;;
    *)
      echo "coord-release: push refused — the output above is the reason." >&2 ;;
  esac
  # ROLL THE COMMIT BACK. Targeted, never `reset --hard`: this script does not require a clean tree,
  # and a hard reset would delete work that has nothing to do with the release. Restoring the two
  # paths from the pre-release commit puts the claim file and its ledger row back exactly as they
  # were, so the claim is still live and still visible to everyone.
  if [ "$(git rev-parse HEAD)" != "$pre_release_sha" ]; then
    git reset -q --mixed "$pre_release_sha"
    git checkout -q -- "$claim" .work/active/LEDGER.tsv 2>/dev/null || true
    echo "  (rolled back the local release commit — the shared checkout is clean again, the claim still stands)" >&2
  fi
  rm -f "$push_log"
  exit 1
fi
