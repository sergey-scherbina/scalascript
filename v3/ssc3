#!/usr/bin/env bash
# ssc3 — the ScalaScript 3 driver.
#
#   v3/ssc3 run   <file.ssc>    compile and run on v3's OWN runtime
#   v3/ssc3 run --bridge <f>    the same program through the v2 VM — the compatibility lane
#   v3/ssc3 ir    <file.ssc>    print the SSC IR the front produced
#   v3/ssc3 build <file.ssc>    print the v2 Core IR the bridge produced
#   v3/ssc3 <anything else>     passed straight to the kernel (check, fmt, sample, selftest)
#
# It lives in `v3/` rather than `bin/` because `.gitignore` says bin/ is GENERATED and wrapper
# sources belong in scripts/launchers/ — which is shared infrastructure this claim does not hold.
# Staging it as `bin/ssc3` is a one-line install.sh follow-up, not a blocker.
#
# The PIPING lives here and not in the kernel. Spawning a process is a host call, and the kernel's
# only door to the host is `Prim` (v3/specs/00-charter.md I-1) — a compiler that shells out from
# inside its own core has a dependency it cannot state.
#
# `run` today means: .ssc -> AST -> SSC IR -> verify -> v2 Core IR -> the v2 VM. The last hop is
# SSC3-3's bridge, which is why v3 has the whole v2 backend fleet without having written one.
#
# WHY JARS AND NOT `scala-cli run`. Every invocation used to compile both trees through scala-cli
# into their shared `.scala-build`. Any CONCURRENT scala-cli on the same tree — another gate,
# another agent — cleans that directory underneath the running one, and the compile dies with
# `NoSuchFileException` writing a `.tasty`. The program then produces NO OUTPUT, which a gate
# comparing output reads as a wrong answer.
#
# Measured: the same fixture, run ten times by hand, came back empty on runs 2, 3 and 5. It cost a
# round of chasing a v3 defect that did not exist.
#
# So the driver packages each tree ONCE per source digest and runs the jar. The race window shrinks
# from every invocation to the first, a failed package is a non-zero exit rather than silence, and
# the gates get several times faster as a side effect.
set -uo pipefail
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
JARS="$ROOT/v3/.jars"

# The jar for a source tree, built if this exact source has not been built before. Written to a
# temporary name and MOVED into place, so two processes racing on the same digest cannot leave a
# half-written jar behind — the move is atomic, and both end up with the same bytes anyway.
jar_for() {
  local tree="$1" name="$2" dg jar tmp
  mkdir -p "$JARS"
  dg="$(cat "$tree"/*.scala | shasum | cut -c1-16)"
  jar="$JARS/$name-$dg.jar"
  if [ ! -f "$jar" ]; then
    tmp="$jar.$$.tmp"
    if ! scala-cli --power package "$tree" --assembly -o "$tmp" --server=false --quiet -f >&2; then
      rm -f "$tmp"
      echo "ssc3: failed to package $tree" >&2
      return 1
    fi
    mv -f "$tmp" "$jar"
  fi
  printf '%s' "$jar"
}

V3JAR="$(jar_for "$ROOT/v3/src" ssc3)" || exit 2
SSC3=(java -jar "$V3JAR")
V2=(java -Xss512m -jar "$(jar_for "$ROOT/v2/src" ssc2)")

# The SECOND front, if it is available. Availability is an explicit cached fact — the classpath file
# exists or it does not — rather than something the driver discovers by running sbt, because a
# build of something the caller is not using has no business blocking `ssc3 run`.
# Refresh it with `v3/uniml-classpath.sh`.
UNIML_CP_FILE="$JARS/uniml.cp"
uniml_available() { [ -s "$UNIML_CP_FILE" ]; }

# The uniml front is compiled, not packaged: its classpath is directories that an assembly does not
# embed — measured, and the assembly ran with a NoClassDefFoundError on every fixture.
# CACHED on a digest of both source trees, for the same reason the jars are: without it every
# invocation recompiles, and the front-diff gate runs one per fixture.
# CACHING A CLASS DIRECTORY IS NOT LIKE CACHING A JAR, and the difference cost an hour.
#
# `jar_for` above is sound: it caches an ARTIFACT FILE keyed on the source digest, and the file
# holds the bytes. Reverting to an earlier source state hits a jar built from exactly that source.
# Content-addressed storage of an immutable thing.
#
# This caches a PATH, and the path is a directory `scala-cli` REWRITES on every compile of the same
# inputs — measured: two compiles of the same tree in different states print the SAME directory. So
# a digest-keyed cache of it is unsound in one specific way:
#
#     state A -> compile -> cache[A] = P, P holds A
#     state B -> compile -> cache[B] = P, P now holds B      <- P is shared, and was overwritten
#     back to A -> cache HIT on cache[A] = P -> serves P, which holds B
#
# That is exactly an A/B measurement, and exactly a gate self-test that plants a defect and reverts
# it. It bit me on the second: three gates reported a defect I had already restored, which is the
# worst kind of wrong answer because it points at working code. My first fix — discard the
# incremental build directory on a MISS — did not touch this, because the failing case is a HIT.
#
# The fix is a STAMP: one file recording which digest the shared directory currently holds. A hit
# requires the stamp to match, so returning to an earlier state recompiles. That is the right cost:
# an A/B between two states must compile twice, and the cache still does its real job — the
# front-diff gate runs one invocation per fixture and must not recompile for each of them.
uniml_classpath() {
  local ucp dg cache stamp full
  ucp="$(cat "$UNIML_CP_FILE")"
  dg="$(cat "$ROOT/v3/src"/*.scala "$ROOT/v3/uniml"/*.scala "$UNIML_CP_FILE" | shasum | cut -c1-16)"
  cache="$JARS/uniml-full.cp"
  stamp="$JARS/uniml-full.digest"
  if [ -s "$cache" ] && [ "$(cat "$stamp" 2>/dev/null)" = "$dg" ]; then cat "$cache"; return 0; fi
  full="$(scala-cli compile "$ROOT/v3/src" "$ROOT/v3/uniml" --classpath "$ucp" \
            --server=false --print-class-path 2>/dev/null | tail -1)"
  [ -n "$full" ] || return 1
  printf '%s' "$full" > "$cache"
  printf '%s' "$dg" > "$stamp"
  printf '%s' "$full"
}

# ── THE DEFAULT FRONT ────────────────────────────────────────────────────────────────────────────
# UniML answers when its classpath is present. `40-front-on-uniml.md` §7 makes the swap a NUMBER
# rather than a judgement, and the number is met: both fronts print the same `Ast` for 48 of 48
# fixtures and 101 of 101 corpus cases.
#
# THE KERNEL JAR IS STILL THE FALLBACK, and that is the whole reason this is a driver decision.
# Invariant I-1 says v3's kernel has zero dependencies and must build and run with UniML absent —
# `v3/src` alone is a complete language. So the uniml front is a SECOND ARTIFACT that the driver
# prefers, never a requirement.
#
# `SSC3_FRONT=v3` forces the kernel's own front. Gates that compare the two need to name them, and
# §7 promised exactly this: "a regression is one environment variable away from being isolated".
#
# Which one actually answered is reported by `ssc3 front`, and `v3/front-report-gate.sh` asserts on
# it. That gate is not optional book-keeping: the two fronts agree on every fixture BY
# CONSTRUCTION, so no program's output can distinguish them, and a gate that cannot tell which of
# two states it is in proves nothing about either.
SSC3_FRONT_SEL="v3"
if [ "${SSC3_FRONT:-auto}" != "v3" ] && uniml_available; then
  if _ucp="$(uniml_classpath)"; then
    SSC3=(java -cp "$_ucp" ssc3.ssc3uniml)
    SSC3_FRONT_SEL="uniml"
  else
    echo "ssc3: the uniml front is present but did not compile — using v3's own front" >&2
  fi
fi

cmd="${1:-}"
case "$cmd" in
  # `run` is v3's OWN runtime as of 2026-08-07. It was the v2 bridge until then, and the switch was
  # made on a measurement rather than a preference: both lanes give N = 48 on the corpus with DIFF 0
  # and CRASH 0, and the executor implements EVERY primitive v3's lowering can emit — so there is no
  # capability a v3 program can reach through the bridge and not here.
  #
  # The bridge is not retired and is not a fallback. It is the COMPATIBILITY lane: `ssc3 build`
  # emits v2 Core IR, which is how v3 inherits the whole v2 backend fleet without having written
  # one. `run --bridge` runs through it, and the executor gate compares the two on every fixture.
  run)
    [ $# -ge 2 ] || { echo "usage: ssc3 run [--bridge] <file.ssc>" >&2; exit 2; }
    if [ "$2" = "--bridge" ]; then
      [ $# -ge 3 ] || { echo "usage: ssc3 run --bridge <file.ssc>" >&2; exit 2; }
      ir="$(mktemp -t ssc3run)"
      trap 'rm -f "$ir"' EXIT
      # The build step's diagnostics go to stderr and its exit code decides. Running a program the
      # front refused would be worse than not running it at all.
      "${SSC3[@]}" build "$3" > "$ir" || exit 1
      exec "${V2[@]}" run-ir "$ir"
    fi
    exec "${SSC3[@]}" exec "$2"
    ;;
  # The v2 VM, for callers that drive it themselves — the gates run `run-ir` on a `.ssir` the front
  # produced. Exposed here rather than letting each gate spell out `scala-cli run v2/src`, which is
  # what put three of them back on the un-cached path and cost a red gate on a program that runs.
  v2)
    shift
    exec "${V2[@]}" "$@"
    ;;
  # Which fronts can actually run, one per line. Asked by `front-diff.sh` rather than duplicated
  # there: a list in two places is a list that disagrees with itself.
  fronts)
    echo "v3"
    uniml_available && echo "uniml"
    exit 0
    ;;
  # `ast <file> [front]` routes to the second front when it is the one asked for. Everything else
  # goes to the kernel, which does not know UniML exists.
  # The resolved uniml classpath, for callers that must run the second front themselves.
  # `corpus-report.sh` packages its own assembly for speed and so cannot use `$SSC3`; without this
  # it silently measured v3's own front no matter what it was asked for.
  __classpath)
    uniml_available || { echo "ssc3: the uniml front is not available — run v3/uniml-classpath.sh" >&2; exit 2; }
    uniml_classpath || { echo "ssc3: could not compile the uniml front" >&2; exit 2; }
    exit 0
    ;;
  # `ast <file> [front]` NAMES its front, and names it all the way down to the artifact rather than
  # to `$SSC3` — the differential's whole job is running both on the same file, so it must not be
  # affected by which one the default happens to be. Omitting the argument gets the default.
  ast)
    want="${3:-$SSC3_FRONT_SEL}"
    if [ "$want" = "uniml" ]; then
      uniml_available || { echo "ssc3: the uniml front is not available — run v3/uniml-classpath.sh" >&2; exit 2; }
      cp="$(uniml_classpath)" || { echo "ssc3: could not compile the uniml front" >&2; exit 2; }
      exec java -cp "$cp" ssc3.ssc3uniml ast "$2"
    fi
    exec java -jar "$V3JAR" ast "$2"
    ;;
  *)
    exec "${SSC3[@]}" "$@"
    ;;
esac
