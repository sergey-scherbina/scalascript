#!/usr/bin/env bash
# Corpus output parity: v2 VM (`ssc run`) versus direct v2 JVM bytecode
# (`ssc run --bytecode`). Runs from any checkout/worktree and always writes a
# machine-readable TSV report.
set -u
set -o pipefail
export LC_ALL=C

SCRIPT_DIR=$(CDPATH= cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
ROOT=$(git -C "$SCRIPT_DIR" rev-parse --show-toplevel 2>/dev/null) || {
  echo "bc-parity-sweep: cannot locate repository root" >&2
  exit 2
}

ssc=${SSC:-"$ROOT/bin/ssc"}
seconds=${BC_PARITY_TIMEOUT:-45}
only='*.ssc'
strict=0
report=${BC_PARITY_REPORT:-"${TMPDIR:-/tmp}/scalascript-bc-parity-$$.tsv"}

usage() {
  cat <<'EOF'
usage: scripts/bc-parity-sweep [options]
  --ssc PATH       staged ssc launcher (default: <repo>/bin/ssc)
  --timeout SEC    per-backend timeout (default: 45)
  --only GLOB      basename glob, e.g. 'hello*.ssc'
  --report PATH    TSV output path (default: temporary file)
  --shard i/N      run only this slice of the corpus (round-robin by index), for a CI matrix
  --list           print the selected case names and exit, running nothing
  --strict         fail on both-fail, mismatch, or one-sided backend error
EOF
}

shard=""
list_only=0

while [[ $# -gt 0 ]]; do
  case "$1" in
    --ssc)     ssc=$2; shift 2 ;;
    --timeout) seconds=$2; shift 2 ;;
    --only)    only=$2; shift 2 ;;
    --report)  report=$2; shift 2 ;;
    --strict)  strict=1; shift ;;
    --shard)   shard=$2; shift 2 ;;
    --list)    list_only=1; shift ;;
    -h|--help) usage; exit 0 ;;
    *) echo "bc-parity-sweep: unknown option: $1" >&2; usage >&2; exit 2 ;;
  esac
done

# ── case selection: --only, --shard i/N, --list ──────────────────────────────
# WHY SHARDING: this sweep is called by tests/e2e/v21-negative-toolchain-release-gate.sh, which
# measured 58.1 min of a 75.6-min CI job (run 30305919516) — 77 % of it. Every example is re-lowered
# through F, the interpreted self-hosting front, at ~2-4x the legacy front's cost.
#
# ROUND-ROBIN (idx % N), not contiguous blocks — same convention as run.sc and contract.sc, for the
# same measured reason: the corpus is name-sorted and the slow cases cluster by name, so contiguous
# blocks give wildly uneven shards.
shard_i=0
shard_n=1
if [[ -n "$shard" ]]; then
  if [[ "$shard" =~ ^([0-9]+)/([0-9]+)$ ]]; then
    shard_i=${BASH_REMATCH[1]}; shard_n=${BASH_REMATCH[2]}
  else
    echo "bc-parity-sweep: --shard expects i/N (e.g. 0/4), got: '$shard'" >&2; exit 2
  fi
  if (( shard_n < 1 || shard_i >= shard_n )); then
    echo "bc-parity-sweep: --shard expects 0 <= i < N, got: '$shard'" >&2; exit 2
  fi
fi

# ONE definition of "which cases are in scope", used by both --list and the real sweep. Keeping two
# copies in sync is the drift that this session has already had to repair twice (ci-status vs ci.yml,
# and the heartbeat threshold in three places); a shard filter that disagrees with the listing would
# make the partition gate prove something other than what runs.
selected_files() {
  local sel=0 f b
  for f in "$ROOT"/examples/*.ssc; do
    b=$(basename -- "$f")
    case "$b" in $only) ;; *) continue ;; esac
    sel=$((sel + 1))
    if (( shard_n > 1 )) && (( (sel - 1) % shard_n != shard_i )); then continue; fi
    printf '%s\n' "$f"
  done
}

# --list deliberately runs BEFORE the staged-jar check below: enumerating the corpus needs no built
# tower, which is what lets tests/e2e/negtc-shard-gate.sh verify the partition in seconds instead of
# behind a full installBin.
if (( list_only )); then
  while IFS= read -r f; do basename -- "$f"; done < <(selected_files)
  exit 0
fi

if [[ ! -x "$ssc" ]]; then
  echo "bc-parity-sweep: staged launcher not found: $ssc (run scripts/sbtc \"installBin\")" >&2
  exit 2
fi

mkdir -p "$(dirname -- "$report")"
tmp=$(mktemp -d "${TMPDIR:-/tmp}/ssc-bc-parity.XXXXXX") || exit 2
trap 'rm -rf "$tmp"' EXIT HUP INT TERM

printf 'file\tcategory\tvm_rc\tbytecode_rc\tdetail\n' > "$report"

explicit_manifest="$ROOT/tests/fixtures/v21-explicit-lanes/manifest.tsv"
[[ -f $explicit_manifest ]] || {
  echo "bc-parity-sweep: missing explicit-lane manifest: $explicit_manifest" >&2
  exit 2
}
awk -F '\t' '
  NR == 1 {
    if ($0 != "file\tfamily\tlane\tregression\tdependency_tier") bad=1
    next
  }
  NF != 5 || $1 == "" || ($3 != "provider-lane" && $3 != "target-lane") { bad=1 }
  seen[$1]++ > 0 { bad=1 }
  { total++ }
  END { if (total != 15 || bad) exit 1 }
' "$explicit_manifest" || {
  echo 'bc-parity-sweep: invalid explicit-lane manifest' >&2
  exit 2
}

skip_re='(^|[^[:alnum:]_])serve([[:space:]]*\(|[[:space:]]*\{|[A-Z][[:alnum:]_]*[[:space:]]*\()|listen|WebServer|websocket|(^|[^[:alnum:]_])tui([^[:alnum:]_]|$)'
nondet_re='^(sql-sqlite-file|uuid-v7|os-env|mcp-server-protected|oauth-mcp-full-stack|async-parallel-demo|distributed-word-count|graphql-client|v2-http-sql-demo)\.ssc$'
ident=0; mismatch=0; bcerr=0; bothfail=0; skipped=0; vmerr=0; timedout=0; total=0; nogolden=0

# Cases the GOLDEN cannot run, read from the corpus contract's own frozen baseline rather than from a
# second opinion invented here. `corpus-baseline.tsv` marks a case `SKIP` when the INT lane — the
# reference every other lane is judged against — could not execute it at all.
#
# WHY THIS MATTERS TO A PARITY SWEEP: this compares VM against BYTECODE. When BOTH fail, the two
# lanes AGREE; there is no divergence. Whether that agreement is a defect depends entirely on
# whether the program is supposed to run, and that question is already answered, frozen, and
# reviewed in the baseline. Two gates over one corpus were disagreeing about it — the sweep called
# `derived-route-clients.ssc` a strict failure while the contract had it marked SKIP (measured: its
# INT lane dies with `Undefined: awaitClient`, so no lane has a working reference).
#
# This does NOT skip the comparison — both lanes still run and their exit codes are still recorded.
# It only decides how to CLASSIFY an already-observed both-fail, which is the order AGENTS.md
# requires. A both-fail on a case the golden CAN run stays a strict failure.
golden_baseline="$ROOT/tests/conformance/corpus-baseline.tsv"
no_golden_names=""
[[ -f $golden_baseline ]] && no_golden_names="$(awk -F'\t' '$3 == "SKIP" { print $1 }' "$golden_baseline" 2>/dev/null || true)"
declared_no_golden() { # <basename.ssc>
  [[ -n $no_golden_names ]] || return 1
  printf '%s\n' "$no_golden_names" | grep -qxF "${1%.ssc}"
}
delegated=0; provider_lane=0; target_lane=0
mlist=''; elist=''; vlist=''; blist=''; nglist=''

record() {
  local file=$1 category=$2 vm_rc=$3 bc_rc=$4 detail=$5
  detail=$(printf '%s' "$detail" | tr '\t\r\n' '   ')
  printf '%s\t%s\t%s\t%s\t%s\n' "$file" "$category" "$vm_rc" "$bc_rc" "$detail" >> "$report"
}

while IFS= read -r f; do
  b=$(basename -- "$f")
  total=$((total + 1))

  lane_row=$(awk -F '\t' -v file="$b" 'NR > 1 && $1 == file { print $3 "\t" $2 "\t" $4; exit }' "$explicit_manifest")
  if [[ -n $lane_row ]]; then
    lane=$(printf '%s\n' "$lane_row" | cut -f1)
    family=$(printf '%s\n' "$lane_row" | cut -f2)
    regression=$(printf '%s\n' "$lane_row" | cut -f3)
    delegated=$((delegated + 1))
    if [[ $lane == provider-lane ]]; then provider_lane=$((provider_lane + 1))
    else target_lane=$((target_lane + 1))
    fi
    record "$b" "$lane" - - "$family via $regression"
    continue
  fi

  if grep -qiE "$skip_re" "$f" 2>/dev/null; then
    skipped=$((skipped + 1)); record "$b" skipped-server - - 'server/tui source'; continue
  fi
  if head -25 "$f" | grep -qE '^(backend|target):[[:space:]]*(jvm|spark|js|node|rust|wasm)|^frontend:[[:space:]]*(react|solid|vue|electron|swing|javafx|swiftui)'; then
    skipped=$((skipped + 1)); record "$b" skipped-backend - - 'target/backend/frontend-specific front matter'; continue
  fi
  if head -25 "$f" | grep -qE '^backends:[[:space:]]*\[[[:space:]]*(js|node|wasm)([[:space:]]*,[[:space:]]*(js|node|wasm))*[[:space:]]*\][[:space:]]*$'; then
    skipped=$((skipped + 1)); record "$b" skipped-backend - - 'JS-family backends-only front matter'; continue
  fi
  if printf '%s\n' "$b" | grep -qE "$nondet_re"; then
    skipped=$((skipped + 1)); record "$b" skipped-nondeterministic - - 'declared nondeterministic output'; continue
  fi
  # Tools-tier examples declare the v1/tools launcher in their shebang
  # (`#!/usr/bin/env ssc-tools run --v1`): they target the compiler-tools JVM host
  # (jvmVfs* positioned I/O, an external `sqlite3`, process `exec`), NOT the standard
  # native tier this sweep compares. Running them through the standard VM/bytecode
  # lanes is a category error — both lanes fail for tier reasons, not correctness.
  # Delegated siblings (scljet-jvm-vfs/scljet-readonly) are caught by the explicit-lane
  # manifest above first; this catches every other such example with zero manifest churn
  # as the corpus grows. See BUGS.md `scljet-jdbc-facade-bytecode-class-too-large`.
  if head -1 "$f" | grep -qE 'ssc-tools[[:space:]]+run[[:space:]]+--v1'; then
    skipped=$((skipped + 1)); record "$b" skipped-tools-tier - - 'v1/tools-tier launcher shebang (compiler-tools JVM host)'; continue
  fi
  if head -25 "$f" | grep -qE '^runScalaFences:[[:space:]]*true([[:space:]]|$)'; then
    skipped=$((skipped + 1)); record "$b" skipped-backend - - 'explicit mixed Scala-fence compiler surface'; continue
  fi
  if grep -qE '^```(scala|java|javascript|rust)([[:space:]]|$)' "$f" 2>/dev/null &&
     ! grep -qE '^```scalascript([[:space:]]|$)' "$f" 2>/dev/null; then
    skipped=$((skipped + 1)); record "$b" skipped-backend - - 'backend-specific fenced document with no standard scalascript block'; continue
  fi

  program_args=()
  case "$b" in
    distributed-join.ssc)
      program_args=(-- "$ROOT/tests/fixtures/v21-native/distributed-orders.csv"
        "$ROOT/tests/fixtures/v21-native/distributed-customers.csv")
      ;;
    distributed-log-aggregation.ssc)
      program_args=(-- "$ROOT/tests/fixtures/v21-native/distributed-app.log")
      ;;
  esac

  "$SCRIPT_DIR/run-with-timeout" "$seconds" "$ssc" run "$f" "${program_args[@]}" >"$tmp/vm.out" 2>"$tmp/vm.err"
  vm_rc=$?
  "$SCRIPT_DIR/run-with-timeout" "$seconds" "$ssc" run --bytecode "$f" "${program_args[@]}" >"$tmp/bc.out" 2>"$tmp/bc.err"
  bc_rc=$?

  # A load-induced timeout (rc 124 from run-with-timeout) is environmental, not a
  # correctness signal. Classify it as a non-fatal skip so a slow/contended CI host
  # cannot turn the strict sweep red; the per-case timeout is generous, so a case that
  # still trips is genuinely slow. Parity (mismatch — the ground truth) is unaffected
  # and stays loud. Reported in the summary so a real new hang is still visible.
  if [[ $vm_rc -eq 124 || $bc_rc -eq 124 ]]; then
    timedout=$((timedout + 1)); skipped=$((skipped + 1))
    record "$b" skipped-timeout "$vm_rc" "$bc_rc" 'run-with-timeout expired (environmental)'
    continue
  fi
  # The v2 JVM bytecode backend emits one monolithic `ssc/gen/Entry` class; a large
  # program can overflow the JVM per-class/method size limit ("Class too large"). When
  # the VM lane produced correct output there is no bytecode to compare against — a
  # backend capacity gap, not a mismatch. Auto-detected from the error text (no
  # per-example allow-list) so new large programs need no churn; a bytecode failure for
  # ANY OTHER reason, or one where the VM lane ALSO failed, still surfaces below as a
  # real error. See BUGS.md `scljet-jdbc-facade-bytecode-class-too-large`.
  if [[ $vm_rc -eq 0 && $bc_rc -ne 0 ]] && grep -qE 'Class too large|Method too large' "$tmp/bc.err"; then
    skipped=$((skipped + 1))
    record "$b" skipped-oversized-bytecode "$vm_rc" "$bc_rc" "$(head -1 "$tmp/bc.err")"
    continue
  fi

  # THE CASE ABOVE NO LONGER FIRES ON ITS OWN. Since the link-time fallback landed
  # (`RunNativeV2.runBytecode`), an oversized program no longer EXITS non-zero on the bytecode
  # lane — it quietly runs on the VM and returns 0. That made this sweep compare the VM against
  # ITSELF and record `identical`: certified parity for programs the bytecode backend never
  # compiled, which is the failure mode where the apparatus lies green. The runner now prints a
  # marker on stderr and we key on it, so a fallback is reported as the skip it is. Matching the
  # marker (not the ASM text) also covers the `Unsupported` fallback, which was equally invisible.
  if [[ $bc_rc -eq 0 ]] && grep -qF 'ssc: --bytecode fell back to the VM lane' "$tmp/bc.err"; then
    skipped=$((skipped + 1))
    record "$b" skipped-bytecode-fallback "$vm_rc" "$bc_rc" \
      "$(grep -F 'ssc: --bytecode fell back to the VM lane' "$tmp/bc.err" | head -1)"
    continue
  fi

  if [[ $vm_rc -ne 0 && $bc_rc -ne 0 ]]; then
    # `blist` exists because a `--strict` run FAILS on both-fail and, until 2026-07-28, printed only
    # the COUNT. CI run 30350792576 went red on exactly this: `both-fail: 1` after a 56-minute sweep,
    # with MISMATCH/BYTECODE-ERROR/VM-ERROR all listed and empty, and no way to learn WHICH case
    # without re-running the whole gate. A number without a name is not a diagnosis.
    detail=$(head -1 "$tmp/bc.err")
    if declared_no_golden "$b"; then
      # `skipped-no-golden`, and BOTH counters, following this script's existing idiom for a
      # sub-kind of skip (`timedout++; skipped++`). The category prefix is load-bearing: the release
      # gate buckets the report with `$2 ~ /^skipped-/` and then asserts an ACCOUNTING CLOSURE —
      #     identical + skipped + delegated + both-fail + mismatch + one-sided == frontend.total
      # A category matching none of those silently loses a case. It did: the first version of this
      # called it `both-fail-no-golden`, the sum came to 213 against a corpus of 214, and the gate
      # failed with "parity accounting 213 != frontend.total 214". The closure check did exactly the
      # job its comment claims — it caught a miscount — and it caught mine.
      nogolden=$((nogolden + 1)); skipped=$((skipped + 1)); nglist="$nglist $b"
      record "$b" skipped-no-golden "$vm_rc" "$bc_rc" "$detail"
    else
      bothfail=$((bothfail + 1)); blist="$blist $b"
      record "$b" both-fail "$vm_rc" "$bc_rc" "$detail"
    fi
  elif [[ $bc_rc -ne 0 ]]; then
    bcerr=$((bcerr + 1)); elist="$elist $b"
    detail=$(head -1 "$tmp/bc.err")
    record "$b" bytecode-error "$vm_rc" "$bc_rc" "$detail"
  elif [[ $vm_rc -ne 0 ]]; then
    vmerr=$((vmerr + 1)); vlist="$vlist $b"
    detail=$(head -1 "$tmp/vm.err")
    record "$b" vm-error "$vm_rc" "$bc_rc" "$detail"
  elif cmp -s "$tmp/vm.out" "$tmp/bc.out"; then
    ident=$((ident + 1)); record "$b" identical "$vm_rc" "$bc_rc" ''
  else
    mismatch=$((mismatch + 1)); mlist="$mlist $b"
    record "$b" mismatch "$vm_rc" "$bc_rc" 'stdout differs'
  fi
done < <(selected_files)

echo "=== total: $total  identical: $ident  mismatch: $mismatch  bytecode-error: $bcerr  vm-error: $vmerr  both-fail: $bothfail  skipped: $skipped (timeout: $timedout, no-golden: $nogolden)  delegated: $delegated (provider: $provider_lane target: $target_lane)"
echo "MISMATCH:$mlist"
echo "BYTECODE-ERROR:$elist"
echo "VM-ERROR:$vlist"
echo "BOTH-FAIL:$blist"
echo "NO-GOLDEN:$nglist"
echo "REPORT: $report"

if [[ $strict -eq 1 && $((bothfail + mismatch + bcerr + vmerr)) -ne 0 ]]; then
  exit 1
fi
